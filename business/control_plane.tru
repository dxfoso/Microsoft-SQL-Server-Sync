function server_saved_data_reset(resetAgents: bool = true, continueReset: bool = false, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }

  // Cancel first so every in-flight endpoint observes a terminal job before
  // its relay/session rows are removed. The direct update avoids materializing
  // public payloads for old jobs that are about to be deleted.
  const cancelledAt = now_iso();
  const cancellationMessage = 'Cancelled because all server sync data was deleted.';
  const cancelledJobCount = db.updateMany(SyncJob, { status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] } }, {
    status: 'cancelled', progress: 100, completedAt: cancelledAt,
    message: cancellationMessage, error: cancellationMessage, updatedAt: cancelledAt
  });

  // Keep every request bounded below the server timeout and memory limits.
  // The control plane repeats this idempotent batch while hasMore is true.
  const snapshotBatch = delete_snapshot_storage_batch();
  const deletedStorageObjectCount = int.from(snapshotBatch.deletedStorageObjectCount ?? 0);
  const snapshotDeletedCount = int.from(snapshotBatch.snapshotDeletedCount ?? 0);
  const syncJobDataBatch = delete_sync_job_data_batch();
  const syncRowWinnerBatch = delete_sync_row_winner_batch();
  const downloadSessionBatch = delete_download_session_batch();
  const uploadSessionBatch = delete_upload_session_batch();
  const syncBatchBatch = delete_sync_batch_batch();
  const syncJobBatch = delete_sync_job_batch();
  const schedulerStateBatch = delete_periodic_sync_state_batch();
  const offlineSyncDebtBatch = delete_offline_sync_debt_batch();
  // Preserve a pause marker after deleting scheduler state so automatic ticks
  // cannot recreate jobs while the reset is draining or after it completes.
  const automaticSyncControl = automatic_sync_control_set(true, token);
  const syncJobDataDeletedCount = int.from(syncJobDataBatch.deletedCount ?? 0);
  const syncRowWinnerDeletedCount = int.from(syncRowWinnerBatch.deletedCount ?? 0);
  const syncJobDataStorageDeletedCount = int.from(syncJobDataBatch.deletedStorageObjectCount ?? 0);
  const downloadSessionDeletedCount = int.from(downloadSessionBatch.deletedCount ?? 0);
  const uploadSessionDeletedCount = int.from(uploadSessionBatch.deletedCount ?? 0);
  const batchDeletedCount = int.from(syncBatchBatch.deletedCount ?? 0);
  const jobDeletedCount = int.from(syncJobBatch.deletedCount ?? 0);
  const schedulerStateDeletedCount = int.from(schedulerStateBatch.deletedCount ?? 0);
  const offlineSyncDebtDeletedCount = int.from(offlineSyncDebtBatch.deletedCount ?? 0);
  const deletedRecordCount = syncJobDataDeletedCount + syncRowWinnerDeletedCount + downloadSessionDeletedCount + uploadSessionDeletedCount + snapshotDeletedCount + batchDeletedCount + jobDeletedCount + schedulerStateDeletedCount + offlineSyncDebtDeletedCount;
  let protocol = sync_protocol_state();
  if (!continueReset) {
    protocol = rotate_sync_epoch();
  }
  let agentResetCount = 0;
  if (resetAgents && !continueReset) {
    agentResetCount = reset_all_agent_saved_state();
  }

  const hasMore = snapshotBatch.hasMore == true || syncJobDataBatch.hasMore == true || syncRowWinnerBatch.hasMore == true || downloadSessionBatch.hasMore == true || uploadSessionBatch.hasMore == true || syncBatchBatch.hasMore == true || syncJobBatch.hasMore == true || schedulerStateBatch.hasMore == true || offlineSyncDebtBatch.hasMore == true;

  return {
    ok: true,
    cleanupStatus: hasMore ? 'cleaning' : 'cleaned',
    cancelledJobCount,
    deletedRecordCount,
    deletedStorageObjectCount: deletedStorageObjectCount + syncJobDataStorageDeletedCount,
    jobDeletedCount,
    agentResetCount,
    downloadSessionDeletedCount,
    uploadSessionDeletedCount,
    snapshotDeletedCount,
    syncJobDataDeletedCount,
    syncRowWinnerDeletedCount,
    batchDeletedCount,
    schedulerStateDeletedCount,
    automaticSyncPaused: automaticSyncControl.automaticSyncPaused == true,
    protocolVersion: protocol.protocolVersion,
    syncEpoch: protocol.syncEpoch,
    hasMore
  };
}

function jobs_upload_chunk_start(jobId: string, uploadId: string, clientName: string = '', table: string = '', rowCount: int = 0, snapshotCreatedAt: string = '', snapshotBytes: int = 0, compressedBytes: int = 0, chunkSizeBytes: int = kSnapshotTransferChunkSizeBytes(), chunkCount: int = 0, encoding: string = kSnapshotTransferEncoding(), token: string? = null): map<json> {
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current_user_record(token), job)) {
    return deny_job_access('jobs_upload_chunk_start', token, current_user_record(token), job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  if (chunkCount < 1 || chunkCount > max_chunk_count()) {
    return raw_json_error(400, 'invalid chunk count');
  }
  let resolvedChunkSize = chunkSizeBytes;
  if (resolvedChunkSize < 1) {
    resolvedChunkSize = kSnapshotTransferChunkSizeBytes();
  }
  let resolvedUploadId = uploadId.trim();
  if (resolvedUploadId.length == 0) {
    resolvedUploadId = uuid.v4();
  }
  let resolvedCreatedAt = snapshotCreatedAt.trim();
  if (resolvedCreatedAt.length == 0) {
    resolvedCreatedAt = now_iso();
  }
  let resolvedTable = job.table;
  if (table.trim().length != 0) {
    resolvedTable = table.trim();
  }
  let resolvedEncoding = encoding.trim();
  if (resolvedEncoding.length == 0) {
    resolvedEncoding = kSnapshotTransferEncoding();
  }
  db.delete(UploadSession, { jobId });
  const session = db.insert(UploadSession, {
    id: uuid.v4(),
    jobId,
    uploadId: resolvedUploadId,
    table: resolvedTable,
    rowCount,
    snapshotCreatedAt: resolvedCreatedAt,
    snapshotBytes,
    compressedBytes,
    chunkSizeBytes: resolvedChunkSize,
    chunkCount,
    encoding: resolvedEncoding,
    createdAt: now_iso(),
    updatedAt: now_iso(),
    chunks: []
  });
  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: 'uploading',
    progress: 35,
    rowCount,
    snapshotBytes,
    snapshotCreatedAt: resolvedCreatedAt,
    snapshotId: null,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: null,
    message: 'Ready to receive compressed snapshot chunks.',
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  return raw_json_success({
    job: public_job_payload(nextJob),
    uploadId: session.uploadId,
    chunkSizeBytes: session.chunkSizeBytes,
    chunkCount: session.chunkCount,
    compressedBytes: session.compressedBytes,
    receivedIndexes: []
  });
}

function jobs_multi_writer_upload(jobId: string, batchId: string, clientName: string, table: string, columns: array<string>? = null, keyColumns: array<string>? = null, uniqueKeyColumnSets: array<json>? = null, rows: array<json>? = null, chunkId: string = '', finalChunk: bool = true, changeTrackingVersion: int? = null, token: string? = null, payloadBase64: string? = null, payloadRowCount: int? = null, payloadEncoding: string = 'json', payloadUncompressedBytes: int? = null, payloadCompressedBytes: int? = null, payloadIsDelta: bool = true, snapshotChecksum: string = '', protocolVersion: int = 0, syncEpoch: string = '', latestModifiedAtUtc: string = '', latestOperationId: string = ''): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_multi_writer_upload', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  if (string.from(job.direction).trim() != 'upload' || string.from(job.batchId).trim() != batchId.trim()) {
    return raw_json_error(409, 'job is not a multi-writer upload');
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  const batch = find_sync_batch(batchId);
  if (batch == null || string.from(batch.table).trim() != table.trim()) {
    return raw_json_error(404, 'sync batch not found');
  }
  if (protocolVersion != sync_protocol_version() || protocolVersion != int.from(batch.protocolVersion ?? 0)) {
    return raw_json_error(426, 'sync protocol upgrade required');
  }
  if (syncEpoch.trim().length == 0 || syncEpoch.trim() != string.from(batch.syncEpoch).trim()) {
    return raw_json_error(409, 'sync epoch changed; discard this job and refresh client state');
  }
  const explicitSingleClientBootstrap =
    (string.from(job.sourceClientName).trim() == 'server-bootstrap-v3' ||
      string.from(job.sourceClientName).trim() == 'server-authoritative-reconcile') &&
    batch.expectedClients.length == 1 &&
    string.from(batch.expectedClients[0]).trim() == clientName.trim();
  const comparisonPreview =
    string.from(job.sourceClientName).trim() == 'server-diff-preview';
  const multiClientUnionBootstrap =
    sync_source_is_union_bootstrap(string.from(job.sourceClientName)) &&
    batch.expectedClients.length >= 2;
  const completeMultiClientUnionBootstrap =
    sync_source_is_complete_union_bootstrap(string.from(job.sourceClientName)) &&
    batch.expectedClients.length >= 2;
  if (!payloadIsDelta &&
      !explicitSingleClientBootstrap &&
      !comparisonPreview &&
      !multiClientUnionBootstrap) {
    return raw_json_error(409, 'protocol-v4 full snapshots require an explicit bootstrap, comparison, or multi-client union batch');
  }
  if (multi_writer_batch_stale(batch)) {
    return raw_json_error(410, 'multi-writer batch expired; start a new sync');
  }
  const normalizedClientName = clientName.trim();
  if (!sync_batch_has_value(batch.expectedClients, normalizedClientName)) {
    return raw_json_error(403, 'client is not part of this sync batch');
  }
  const normalizedChunkId = chunkId.trim();
  if (normalizedChunkId.length == 0) {
    return raw_json_error(400, 'chunkId is required');
  }
  const incomingRows = rows ?? [];
  let incomingRowCount = incomingRows.length;
  if (payloadRowCount != null && payloadRowCount >= 0) {
    incomingRowCount = payloadRowCount;
  }
  if (incomingRowCount > 100) {
    return raw_json_error(413, 'multi-writer chunk is too large');
  }
  const encodedPayload = string.from(payloadBase64 ?? '').trim();
  const hasStoredPayload = encodedPayload.length > 0;
  if (payloadIsDelta && !hasStoredPayload) {
    return raw_json_error(426, 'protocol upgrade required: delta payload metadata is missing');
  }
  const normalizedPayloadEncoding = payloadEncoding.trim().toLowerCase();
  if (normalizedPayloadEncoding != 'json' && normalizedPayloadEncoding != 'gzip-json') {
    return raw_json_error(415, 'unsupported multi-writer payload encoding');
  }
  if (normalizedPayloadEncoding == 'gzip-json' &&
      (payloadUncompressedBytes == null || payloadCompressedBytes == null)) {
    return raw_json_error(400, 'compressed multi-writer payload byte manifests are required');
  }
  if (encodedPayload.length > 1024000) {
    return raw_json_error(413, 'compressed multi-writer payload exceeds the 750 KB transport limit');
  }
  let effectiveIncomingRows = incomingRows;
  let decodedPayloadText = '';
  if (hasStoredPayload) {
    decodedPayloadText = normalizedPayloadEncoding == 'gzip-json'
      ? string.gzipBase64Utf8Decode(encodedPayload)
      : string.base64Utf8Decode(encodedPayload);
    const decodedPayload = json.parse(decodedPayloadText);
    if (decodedPayload == null) {
      return raw_json_error(400, 'multi-writer payload is not valid JSON');
    }
    effectiveIncomingRows = decodedPayload;
    if (effectiveIncomingRows.length != incomingRowCount) {
      return raw_json_error(400, 'multi-writer payload row count does not match its manifest');
    }
  }
  let incomingBytes = json.stringify(incomingRows).length;
  let incomingCompressedBytes = incomingBytes;
  if (hasStoredPayload) {
    incomingCompressedBytes = payloadCompressedBytes ?? int.from((encodedPayload.length * 3) / 4);
    incomingBytes = payloadUncompressedBytes ?? decodedPayloadText.length;
  }
  if (hasStoredPayload && incomingBytes < decodedPayloadText.length) {
    return raw_json_error(400, 'multi-writer payload byte manifest is smaller than its decoded content');
  }
  if (incomingBytes < 0 || incomingBytes > 2000000) {
    return raw_json_error(413, 'multi-writer package exceeds the 2 MB decompressed limit');
  }
  if (incomingCompressedBytes < 0 || incomingCompressedBytes > 750000) {
    return raw_json_error(413, 'multi-writer package exceeds the 750 KB compressed limit');
  }
  const receivedBytes = int.from(batch.receivedBytes ?? 0);
  if (receivedBytes + incomingBytes > 128000000) {
    return raw_json_error(413, 'multi-writer batch exceeds the 128 MB staging limit; split the sync by table or reduce the changed set');
  }
  if (sync_batch_chunk_seen(batch.receivedChunks, normalizedClientName, normalizedChunkId)) {
    return raw_json_success({ job: public_job_payload(job), batchId, duplicate: true, ready: batch.status == 'ready' });
  }

  let resolvedKeyColumns = normalize_key_columns(keyColumns);
  if (!comparisonPreview && batch.keyColumns.length > 0) {
    resolvedKeyColumns = batch.keyColumns.map((value) => string.from(value));
  }
  if (comparisonPreview && resolvedKeyColumns.length == 0) {
    return raw_json_error(409, 'row comparison requires permanent primary key columns');
  }
  if (comparisonPreview &&
      batch.keyColumns.length > 0 &&
      json.stringify(batch.keyColumns) != json.stringify(resolvedKeyColumns)) {
    return raw_json_error(409, 'clients report different primary key definitions for this table');
  }
  let resolvedColumns = columns ?? [];
  if (!comparisonPreview && batch.columns.length > 0) {
    resolvedColumns = batch.columns.map((value) => string.from(value));
  }
  let resolvedUniqueKeyColumnSets = normalize_unique_key_column_sets(
    uniqueKeyColumnSets,
    resolvedColumns
  );
  const batchUniqueKeyColumnSets = normalize_unique_key_column_sets(
    batch.uniqueKeyColumnSets ?? [],
    resolvedColumns
  );
  if (batchUniqueKeyColumnSets.length > 0) {
    if (resolvedUniqueKeyColumnSets.length > 0 &&
        json.stringify(resolvedUniqueKeyColumnSets) != json.stringify(batchUniqueKeyColumnSets)) {
      return raw_json_error(409, 'clients report different SQL unique-key definitions for this table');
    }
    resolvedUniqueKeyColumnSets = batchUniqueKeyColumnSets;
  }
  if (incomingRowCount * (resolvedUniqueKeyColumnSets.length + 1) > 100) {
    return raw_json_error(413, 'multi-writer package has too many row and unique-key identities; retry with fewer rows');
  }
  if (payloadIsDelta && resolvedKeyColumns.length == 0) {
    return raw_json_error(409, 'latest-change sync requires permanent primary key columns');
  }
  for (const incomingRow of effectiveIncomingRows) {
    const operation = string.from(incomingRow.__sync_op ?? 'S').trim().toUpperCase();
    if (operation != 'S' && operation != 'I' && operation != 'U' && operation != 'D') {
      return raw_json_error(400, 'sync row operation must be S, I, U, or D');
    }
    if (operation == 'D') {
      if (!payloadIsDelta) {
        return raw_json_error(409, 'delete tombstones are forbidden in full snapshots; snapshot absence never deletes data');
      }
      for (const keyColumn of resolvedKeyColumns) {
        if (incomingRow[keyColumn] == null) {
          return raw_json_error(400, 'delete tombstone requires every primary key value');
        }
      }
      if (string.from(incomingRow.__sync_operation_id ?? '').trim().length != 64 ||
          string.from(incomingRow.__sync_change_version ?? '').trim().length == 0 ||
          string.from(incomingRow.__sync_origin_client ?? '').trim().length == 0) {
        return raw_json_error(400, 'delete tombstone requires protocol-v4 operation, origin, and Change Tracking version metadata');
      }
    }
  }
  const nextOrdinal = batch.revision + 1;
  const serverReceivedAt = now_iso();
  const serverSequence = string.concat(
    string.from(serverReceivedAt),
    '::',
    string.from(nextOrdinal),
    '::',
    normalizedClientName,
    '::',
    normalizedChunkId
  );
  const receivedChunks = batch.receivedChunks.concat([{
    clientName: normalizedClientName,
    chunkId: normalizedChunkId,
    rowCount: incomingRowCount,
    latestModifiedAtUtc: latestModifiedAtUtc.trim(),
    latestOperationId: latestOperationId.trim(),
    receivedAt: serverReceivedAt,
    serverSequence
  }]);
  let uploadedClients = batch.uploadedClients;
  if (finalChunk && !sync_batch_has_value(uploadedClients, normalizedClientName)) {
    uploadedClients = uploadedClients.concat([normalizedClientName]);
  }
  const ready = uploadedClients.length >= batch.expectedClients.length;
  let clientChangeTrackingVersions = batch.clientChangeTrackingVersions ?? [];
  if (finalChunk && changeTrackingVersion != null) {
    clientChangeTrackingVersions = sync_batch_version_values(
      clientChangeTrackingVersions,
      normalizedClientName,
      changeTrackingVersion
    );
  }
  let storageId = '';
  if (hasStoredPayload) {
    const storedPayload = storage.put({
      name: string.concat(
        'multi-writer-',
        batch.id,
        '-',
        normalizedChunkId,
        normalizedPayloadEncoding == 'gzip-json' ? '.json.gz' : '.json'
      ),
      content_base64: encodedPayload,
      content_type: normalizedPayloadEncoding == 'gzip-json'
        ? 'application/gzip'
        : 'application/json'
    });
    storageId = string.from(storedPayload.id ?? '').trim();
    if (storageId.length == 0) {
      return raw_json_error(500, 'could not store multi-writer delta payload');
    }
  }
  let storedRows = incomingRows;
  if (hasStoredPayload) {
    storedRows = [];
  }
  // Every protocol-v4 delta uses one durable row winner. The configurable
  // conflict policy still controls whether unsafe schema/business conflicts
  // pause for input, but it must never disable deterministic row ordering.
  const winnerPolicyApplied = payloadIsDelta || multiClientUnionBootstrap;
  const winnerOwnerUserId = string.from(batch.ownerUserId ?? '').trim();
  const winnerTable = string.from(batch.table);
  let conflictSourceClient = '';
  if (batch.conflictSourceClient == null) {
    conflictSourceClient = conflict_source_client_for_owner(winnerOwnerUserId);
  } else {
    conflictSourceClient = normalize_user_name(string.from(batch.conflictSourceClient));
  }
  let candidateWinnerIds = [];
  let candidatePhysicalKeys = [];
  if (winnerPolicyApplied) {
    for (const incomingRow of effectiveIncomingRows) {
      const candidatePhysicalKey = sync_row_physical_key(incomingRow, resolvedKeyColumns);
      const candidateIdentityKey = sync_row_identity_key(winnerTable, incomingRow, resolvedKeyColumns);
      candidatePhysicalKeys = candidatePhysicalKeys.concat([candidatePhysicalKey]);
      candidateWinnerIds = candidateWinnerIds.concat([sync_row_winner_id(
        winnerOwnerUserId,
        winnerTable,
        candidateIdentityKey
      )]);
      if (string.from(incomingRow.__sync_op ?? 'S').trim().toUpperCase() != 'D') {
        candidateWinnerIds = candidateWinnerIds.concat(
          sync_row_logical_winner_refs(
            winnerOwnerUserId,
            winnerTable,
            incomingRow,
            resolvedUniqueKeyColumnSets
          ).map((value) => string.from(value.id))
        );
      }
    }
  }
  candidateWinnerIds = unique_string_values(candidateWinnerIds);
  let currentWinners = [];
  if (candidateWinnerIds.length > 0) {
    currentWinners = db.selectMany(SyncRowWinner, {
      where: {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable,
        id: { in: candidateWinnerIds }
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['id', 'ownerUserId', 'table', 'identityKey', 'physicalKey', 'logicalWinnerIds', 'modifiedAtUtc', 'serverReceivedAtUtc', 'serverSequence', 'originClient', 'changeVersion', 'operationId', 'rowHash', 'operation', 'revision', 'updatedAt'],
      limit: 500
    });
  }
  if (candidatePhysicalKeys.length > 0) {
    const physicalWinners = db.selectMany(SyncRowWinner, {
      where: {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable,
        physicalKey: { in: candidatePhysicalKeys }
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['id', 'ownerUserId', 'table', 'identityKey', 'physicalKey', 'logicalWinnerIds', 'modifiedAtUtc', 'serverReceivedAtUtc', 'serverSequence', 'originClient', 'changeVersion', 'operationId', 'rowHash', 'operation', 'revision', 'updatedAt'],
      limit: 500
    });
    for (const physicalWinner of physicalWinners) {
      if (sync_row_winner_find_by_id(currentWinners, string.from(physicalWinner.id)) == null) {
        currentWinners = currentWinners.concat([physicalWinner]);
      }
    }
  }
  // Logical winners point at the current physical identity. Load that primary
  // register too so accepting a newer conflicting identity can redirect the
  // older primary key and prevent a delayed offline upload from resurrecting it.
  let displacedPrimaryWinnerIds = [];
  for (const currentWinner of currentWinners) {
    const displacedIdentityKey = crypto.hash(json.stringify({
      table: winnerTable.trim().toLowerCase(),
      values: ['physical', string.from(currentWinner.physicalKey)]
    }), 'sha256');
    const displacedWinnerId = sync_row_winner_id(
      winnerOwnerUserId,
      winnerTable,
      displacedIdentityKey
    );
    if (sync_row_winner_find_by_id(currentWinners, displacedWinnerId) == null) {
      displacedPrimaryWinnerIds = displacedPrimaryWinnerIds.concat([displacedWinnerId]);
    }
  }
  displacedPrimaryWinnerIds = unique_string_values(displacedPrimaryWinnerIds);
  if (displacedPrimaryWinnerIds.length > 0) {
    const displacedWinners = db.selectMany(SyncRowWinner, {
      where: {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable,
        id: { in: displacedPrimaryWinnerIds }
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['id', 'ownerUserId', 'table', 'identityKey', 'physicalKey', 'logicalWinnerIds', 'modifiedAtUtc', 'serverReceivedAtUtc', 'serverSequence', 'originClient', 'changeVersion', 'operationId', 'rowHash', 'operation', 'revision', 'updatedAt'],
      limit: 500
    });
    for (const displacedWinner of displacedWinners) {
      if (sync_row_winner_find_by_id(currentWinners, string.from(displacedWinner.id)) == null) {
        currentWinners = currentWinners.concat([displacedWinner]);
      }
    }
  }
  let storedLogicalWinnerIds = [];
  for (const currentWinner of currentWinners) {
    for (const logicalWinnerId of currentWinner.logicalWinnerIds ?? []) {
      const normalizedLogicalWinnerId = string.from(logicalWinnerId).trim();
      if (normalizedLogicalWinnerId.length != 0 &&
          sync_row_winner_find_by_id(currentWinners, normalizedLogicalWinnerId) == null) {
        storedLogicalWinnerIds = storedLogicalWinnerIds.concat([normalizedLogicalWinnerId]);
      }
    }
  }
  storedLogicalWinnerIds = unique_string_values(storedLogicalWinnerIds);
  if (storedLogicalWinnerIds.length > 0) {
    const storedLogicalWinners = db.selectMany(SyncRowWinner, {
      where: {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable,
        id: { in: storedLogicalWinnerIds }
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['id', 'ownerUserId', 'table', 'identityKey', 'physicalKey', 'logicalWinnerIds', 'modifiedAtUtc', 'serverReceivedAtUtc', 'serverSequence', 'originClient', 'changeVersion', 'operationId', 'rowHash', 'operation', 'revision', 'updatedAt'],
      limit: 500
    });
    for (const storedLogicalWinner of storedLogicalWinners) {
      if (sync_row_winner_find_by_id(currentWinners, string.from(storedLogicalWinner.id)) == null) {
        currentWinners = currentWinners.concat([storedLogicalWinner]);
      }
    }
  }
  const autoNumberRule = automatic_number_rule(
    winnerTable,
    resolvedColumns,
    resolvedKeyColumns,
    resolvedUniqueKeyColumnSets
  );
  let currentAutoNumberSequences = [];
  let currentAutoNumberIncidents = [];
  if (autoNumberRule != null) {
    currentAutoNumberSequences = db.selectMany(AutoNumberSequence, {
      where: {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['id', 'ownerUserId', 'table', 'scopeKey', 'numberColumn', 'scope', 'maximumObserved', 'initialized', 'revision', 'updatedAt'],
      limit: 1000
    });
    const autoNumberOperationIds = unique_string_values(
      effectiveIncomingRows.map((row) => string.from(row.__sync_operation_id ?? '').trim())
    );
    if (autoNumberOperationIds.length > 0) {
      currentAutoNumberIncidents = db.selectMany(AutoNumberIncident, {
        where: {
          ownerUserId: winnerOwnerUserId,
          table: winnerTable,
          operationId: { in: autoNumberOperationIds }
        },
        orderBy: { field: 'detectedAt', dir: 'asc' },
        fields: ['id', 'ownerUserId', 'clientName', 'conflictingClientName', 'table', 'status', 'reason', 'numberColumn', 'beforeNumber', 'afterNumber', 'scope', 'primaryKey', 'beforeRow', 'afterRow', 'operationId', 'physicalKey', 'detectedAt', 'resolvedAt', 'updatedAt'],
        limit: 100
      });
    }
    if (candidatePhysicalKeys.length > 0) {
      const physicalIncidents = db.selectMany(AutoNumberIncident, {
        where: {
          ownerUserId: winnerOwnerUserId,
          table: winnerTable,
          physicalKey: { in: candidatePhysicalKeys }
        },
        orderBy: { field: 'detectedAt', dir: 'asc' },
        fields: ['id', 'ownerUserId', 'clientName', 'conflictingClientName', 'table', 'status', 'reason', 'numberColumn', 'beforeNumber', 'afterNumber', 'scope', 'primaryKey', 'beforeRow', 'afterRow', 'operationId', 'physicalKey', 'detectedAt', 'resolvedAt', 'updatedAt'],
        limit: 100
      });
      for (const physicalIncident of physicalIncidents) {
        if (automatic_number_incident_find_by_operation(
              currentAutoNumberIncidents,
              string.from(physicalIncident.operationId)
            ) == null) {
          currentAutoNumberIncidents = currentAutoNumberIncidents.concat([physicalIncident]);
        }
      }
    }
  }
  const chunkRecord = db.insert(SnapshotRecord, {
    id: uuid.v4(),
    clientName: 'server-merge',
    subscriberClientName: normalizedClientName,
    table: batch.table,
    rowCount: incomingRowCount,
    checksum: snapshotChecksum.trim().length == 0
      ? string.concat(normalizedChunkId, '-', string.from(nextOrdinal))
      : snapshotChecksum.trim(),
    snapshotBytes: incomingBytes,
    columns: resolvedColumns,
    rows: storedRows,
    previewRows: [{ winnerPolicyApplied }],
    compressedBytes: incomingCompressedBytes,
    chunkCount: 1,
    encoding: normalizedPayloadEncoding,
    storageId,
    isDelta: payloadIsDelta,
    sourceJobId: batch.id,
    clientUserId: normalizedClientName,
    ownerUserId: batch.ownerUserId,
    createdAt: serverReceivedAt
  });
  if (chunkRecord == null) {
    return raw_json_error(500, 'could not store multi-writer delta chunk');
  }
  const archivedChunk = db.insert(SyncJobDataChunk, {
    id: uuid.v4(),
    jobId: job.id,
    batchId: batch.id,
    clientName: normalizedClientName,
    table: batch.table,
    ordinal: nextOrdinal,
    columns: resolvedColumns,
    keyColumns: resolvedKeyColumns,
    // The payload storage object is shared with the live relay record. Keep
    // only lightweight metadata here so retained audit data is not duplicated
    // in the database.
    rows: [],
    rowCount: incomingRowCount,
    snapshotBytes: incomingBytes,
    storageId,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    createdAt: serverReceivedAt
  });
  if (archivedChunk == null) {
    db.delete(SnapshotRecord, { id: chunkRecord.id });
    if (storageId.length != 0) {
      storage.delete(storageId);
    }
    return raw_json_error(500, 'could not retain sync job data');
  }
  const acceptance = db.atomicTransaction(() => {
    const updatedBatch = db.updateMany(SyncBatch, { id: batch.id, revision: batch.revision }, {
      table: batch.table,
      revision: batch.revision + 1,
      ownerUserId: batch.ownerUserId,
      expectedClients: batch.expectedClients,
      uploadedClients,
      receivedChunks,
      receivedBytes: receivedBytes + incomingBytes,
      clientChangeTrackingVersions,
      keyColumns: resolvedKeyColumns,
      uniqueKeyColumnSets: resolvedUniqueKeyColumnSets,
      columns: resolvedColumns,
      rows: [],
      status: ready ? 'ready' : 'uploading',
      createdAt: batch.createdAt,
      updatedAt: serverReceivedAt,
      protocolVersion: batch.protocolVersion,
      syncEpoch: batch.syncEpoch
    });
    if (updatedBatch == 0) {
      return {
        ok: false,
        acceptedRowCount: 0
      };
    }

    let acceptedOperationIds = [];
    let acceptedRows = [];
    let pendingWinners = [];
    let pendingAutoNumberSequences = [];
    let pendingAutoNumberIncidents = [];
    let pendingAutoNumberReservations = [];
    for (const incomingRow of effectiveIncomingRows) {
      const operationId = string.from(incomingRow.__sync_operation_id ?? '').trim();
      let accepted = true;
      let currentWinner = null;
      let matchesDurableWinnerContent = false;
      let reassertsDurableTombstone = false;
      let durableTombstoneWinner = null;
      let automaticNumberDirective = null;
      if (winnerPolicyApplied) {
        accepted = operationId.length == 64;
        const operation = string.from(incomingRow.__sync_op ?? 'S').trim().toUpperCase();
        const physicalKey = sync_row_physical_key(incomingRow, resolvedKeyColumns);
        let identityKey = sync_row_identity_key(winnerTable, incomingRow, resolvedKeyColumns);
        const winnerId = sync_row_winner_id(
          winnerOwnerUserId,
          winnerTable,
          identityKey
        );
        currentWinner = sync_row_winner_find_by_id(pendingWinners, winnerId);
        if (currentWinner == null) {
          currentWinner = sync_row_winner_find_by_id(currentWinners, winnerId);
        }
        let logicalWinnerRefs = [];
        if (operation == 'D' && currentWinner != null) {
          for (const logicalWinnerId of currentWinner.logicalWinnerIds ?? []) {
            let logicalWinner = sync_row_winner_find_by_id(
              pendingWinners,
              string.from(logicalWinnerId)
            );
            if (logicalWinner == null) {
              logicalWinner = sync_row_winner_find_by_id(
                currentWinners,
                string.from(logicalWinnerId)
              );
            }
            if (logicalWinner != null) {
              logicalWinnerRefs = logicalWinnerRefs.concat([{
                id: logicalWinner.id,
                identityKey: logicalWinner.identityKey
              }]);
            }
          }
        } else if (operation != 'D') {
          logicalWinnerRefs = sync_row_logical_winner_refs(
            winnerOwnerUserId,
            winnerTable,
            incomingRow,
            resolvedUniqueKeyColumnSets
          );
        }
        if (operation != 'D' && autoNumberRule != null) {
          const numberColumn = string.from(autoNumberRule.numberColumn);
          const sequenceScope = automatic_number_scope(
            winnerOwnerUserId,
            winnerTable,
            autoNumberRule,
            incomingRow
          );
          let sequence = automatic_number_sequence_find(
            pendingAutoNumberSequences,
            string.from(sequenceScope.id)
          );
          if (sequence == null) {
            sequence = automatic_number_sequence_find(
              currentAutoNumberSequences,
              string.from(sequenceScope.id)
            );
          }
          const observedNumber = int.from(incomingRow[numberColumn] ?? 0);
          for (const priorIncident of currentAutoNumberIncidents) {
            if (string.from(priorIncident.physicalKey) == physicalKey &&
                string.from(priorIncident.status).trim().toLowerCase() == 'reserved' &&
                string.from(priorIncident.afterNumber).trim() == string.from(observedNumber)) {
              pendingAutoNumberIncidents = pendingAutoNumberIncidents.concat([{
                id: priorIncident.id,
                ownerUserId: priorIncident.ownerUserId,
                clientName: priorIncident.clientName,
                conflictingClientName: priorIncident.conflictingClientName,
                table: priorIncident.table,
                status: 'resolved',
                reason: priorIncident.reason,
                numberColumn: priorIncident.numberColumn,
                beforeNumber: priorIncident.beforeNumber,
                afterNumber: priorIncident.afterNumber,
                scope: priorIncident.scope,
                primaryKey: priorIncident.primaryKey,
                beforeRow: priorIncident.beforeRow,
                afterRow: priorIncident.afterRow,
                operationId: priorIncident.operationId,
                physicalKey: priorIncident.physicalKey,
                detectedAt: priorIncident.detectedAt,
                resolvedAt: serverReceivedAt,
                updatedAt: serverReceivedAt
              }]);
            }
          }
          let maximumObserved = observedNumber;
          let sequenceRevision = 1;
          let sequenceInitialized = false;
          if (sequence != null) {
            maximumObserved = int.from(sequence.maximumObserved ?? 0);
            if (observedNumber > maximumObserved) {
              maximumObserved = observedNumber;
            }
            sequenceRevision = int.from(sequence.revision ?? 0) + 1;
            sequenceInitialized = sequence.initialized == true;
          }
          if (completeMultiClientUnionBootstrap && ready) {
            sequenceInitialized = true;
          }
          sequence = {
            id: sequenceScope.id,
            ownerUserId: winnerOwnerUserId,
            table: winnerTable,
            scopeKey: sequenceScope.scopeKey,
            numberColumn,
            scope: sequenceScope.scope,
            maximumObserved,
            initialized: sequenceInitialized,
            revision: sequenceRevision,
            updatedAt: serverReceivedAt
          };
          pendingAutoNumberSequences = automatic_number_sequence_replace(
            pendingAutoNumberSequences,
            sequence
          );

          let conflictingWinner = null;
          for (const logicalWinnerRef of logicalWinnerRefs) {
            let logicalWinner = sync_row_winner_find_by_id(
              pendingWinners,
              string.from(logicalWinnerRef.id)
            );
            if (logicalWinner == null) {
              logicalWinner = sync_row_winner_find_by_id(
                currentWinners,
                string.from(logicalWinnerRef.id)
              );
            }
            if (logicalWinner != null &&
                string.from(logicalWinner.physicalKey) != physicalKey) {
              conflictingWinner = logicalWinner;
            }
          }
          if (conflictingWinner != null) {
            const beforeRow = json.parse(json.stringify(incomingRow));
            let incidentId = crypto.hash(json.stringify([
              winnerOwnerUserId,
              winnerTable.trim().toLowerCase(),
              operationId
            ]), 'sha256');
            let afterNumber = '';
            let incidentStatus = 'blocked';
            let incidentReason = 'A different primary identity already owns the same SQL unique business key. Automatic numbering is waiting for a complete multi-client number inventory.';
            let existingIncident = automatic_number_incident_find_by_operation(
              currentAutoNumberIncidents,
              operationId
            );
            if (existingIncident == null) {
              existingIncident = automatic_number_incident_find_by_physical_key(
                currentAutoNumberIncidents.concat(pendingAutoNumberIncidents),
                physicalKey
              );
            }
            let allocatedNumber = 0;
            if (existingIncident != null &&
                string.from(existingIncident.afterNumber ?? '').trim().length != 0) {
              incidentId = string.from(existingIncident.id);
              allocatedNumber = int.from(existingIncident.afterNumber);
              incidentStatus = string.from(existingIncident.status);
              incidentReason = string.from(existingIncident.reason);
            } else if (payloadIsDelta && sequence.initialized == true) {
              allocatedNumber = int.from(sequence.maximumObserved) + 1;
              pendingAutoNumberReservations = pendingAutoNumberReservations.concat([{
                id: crypto.hash(json.stringify([
                  winnerOwnerUserId,
                  winnerTable.trim().toLowerCase(),
                  sequenceScope.scopeKey,
                  allocatedNumber
                ]), 'sha256'),
                ownerUserId: winnerOwnerUserId,
                table: winnerTable,
                scopeKey: sequenceScope.scopeKey,
                number: allocatedNumber,
                incidentId,
                createdAt: serverReceivedAt
              }]);
            }
            if (allocatedNumber > 0) {
              afterNumber = string.from(allocatedNumber);
              sequence = {
                id: sequence.id,
                ownerUserId: sequence.ownerUserId,
                table: sequence.table,
                scopeKey: sequence.scopeKey,
                numberColumn: sequence.numberColumn,
                scope: sequence.scope,
                maximumObserved: allocatedNumber > int.from(sequence.maximumObserved)
                  ? allocatedNumber
                  : int.from(sequence.maximumObserved),
                initialized: sequence.initialized,
                revision: sequence.revision,
                updatedAt: serverReceivedAt
              };
              pendingAutoNumberSequences = automatic_number_sequence_replace(
                pendingAutoNumberSequences,
                sequence
              );
              if (existingIncident == null) {
                incidentStatus = 'reserved';
                incidentReason = 'A different primary identity already owned this voucher number. The server reserved the next owner-wide free number while preserving the GUID and child links.';
              }
              automaticNumberDirective = {
                incidentId,
                column: numberColumn,
                before: string.from(observedNumber),
                after: afterNumber
              };
              logicalWinnerRefs = sync_row_logical_winner_refs_with_number_override(
                winnerOwnerUserId,
                winnerTable,
                incomingRow,
                resolvedUniqueKeyColumnSets,
                numberColumn,
                allocatedNumber
              );
            } else {
              accepted = false;
            }
            let afterRow = json.parse(json.stringify(incomingRow));
            if (afterNumber.length != 0) {
              afterRow = {
                sourceRow: afterRow,
                changedColumn: numberColumn,
                changedValue: afterNumber
              };
            }
            if (existingIncident == null) {
              pendingAutoNumberIncidents = pendingAutoNumberIncidents.concat([{
                id: incidentId,
                ownerUserId: winnerOwnerUserId,
                clientName: normalizedClientName,
                conflictingClientName: string.from(conflictingWinner.originClient),
                table: winnerTable,
                status: incidentStatus,
                reason: incidentReason,
                numberColumn,
                beforeNumber: string.from(observedNumber),
                afterNumber,
                scope: sequenceScope.scope,
                primaryKey: automatic_number_primary_key(autoNumberRule, incomingRow),
                beforeRow,
                afterRow,
                operationId,
                physicalKey,
                detectedAt: serverReceivedAt,
                resolvedAt: null,
                updatedAt: serverReceivedAt
              }]);
            } else if (allocatedNumber > 0 &&
                string.from(existingIncident.afterNumber ?? '').trim().length == 0) {
              pendingAutoNumberIncidents = pendingAutoNumberIncidents.concat([{
                id: existingIncident.id,
                ownerUserId: existingIncident.ownerUserId,
                clientName: existingIncident.clientName,
                conflictingClientName: existingIncident.conflictingClientName,
                table: existingIncident.table,
                status: 'reserved',
                reason: 'A different primary identity already owned this voucher number. The server refreshed the complete inventory and reserved the next owner-wide free number while preserving the GUID and child links.',
                numberColumn: existingIncident.numberColumn,
                beforeNumber: existingIncident.beforeNumber,
                afterNumber,
                scope: existingIncident.scope,
                primaryKey: existingIncident.primaryKey,
                beforeRow: existingIncident.beforeRow,
                afterRow,
                operationId: existingIncident.operationId,
                physicalKey: existingIncident.physicalKey,
                detectedAt: existingIncident.detectedAt,
                resolvedAt: null,
                updatedAt: serverReceivedAt
              }]);
            }
          }
        }
        if (operation != 'D' && autoNumberRule == null) {
          let unconfiguredConflict = null;
          for (const logicalWinnerRef of logicalWinnerRefs) {
            let logicalWinner = sync_row_winner_find_by_id(
              pendingWinners,
              string.from(logicalWinnerRef.id)
            );
            if (logicalWinner == null) {
              logicalWinner = sync_row_winner_find_by_id(
                currentWinners,
                string.from(logicalWinnerRef.id)
              );
            }
            if (logicalWinner != null &&
                string.from(logicalWinner.physicalKey) != physicalKey) {
              unconfiguredConflict = logicalWinner;
            }
          }
          if (unconfiguredConflict != null) {
            accepted = false;
            const incidentId = crypto.hash(json.stringify([
              winnerOwnerUserId,
              winnerTable.trim().toLowerCase(),
              operationId
            ]), 'sha256');
            const rowCopy = json.parse(json.stringify(incomingRow));
            pendingAutoNumberIncidents = pendingAutoNumberIncidents.concat([{
              id: incidentId,
              ownerUserId: winnerOwnerUserId,
              clientName: normalizedClientName,
              conflictingClientName: string.from(unconfiguredConflict.originClient),
              table: winnerTable,
              status: 'blocked',
              reason: 'A different primary identity already owns this SQL unique business key. This table has no scientifically validated automatic-number rule, so synchronization stopped instead of deleting either row.',
              numberColumn: 'unconfigured',
              beforeNumber: 'unknown',
              afterNumber: '',
              scope: {},
              primaryKey: sync_row_primary_key_payload(resolvedKeyColumns, incomingRow),
              beforeRow: rowCopy,
              afterRow: rowCopy,
              operationId,
              physicalKey,
              detectedAt: serverReceivedAt,
              resolvedAt: null,
              updatedAt: serverReceivedAt
            }]);
          }
        }
        durableTombstoneWinner = sync_row_durable_tombstone_for_reassertion(
          logicalWinnerRefs,
          pendingWinners,
          currentWinners,
          currentWinner
        );
        reassertsDurableTombstone =
          multiClientUnionBootstrap &&
          operation != 'D' &&
          durableTombstoneWinner != null;
        // A full-union retry receives a new Change Tracking version even when
        // the SQL row is byte-for-byte identical to the durable winner. Relay
        // that row so a failed canonical download can be rebuilt completely,
        // but keep the original winner metadata. Differing stale rows and
        // rows hidden by a durable delete still follow the normal winner rule.
        const incomingRowHash = string.from(incomingRow.__sync_row_hash ?? '').trim();
        matchesDurableWinnerContent =
          multiClientUnionBootstrap &&
          currentWinner != null &&
          string.from(currentWinner.operationId) != operationId &&
          incomingRowHash.length != 0 &&
          incomingRowHash == string.from(currentWinner.rowHash).trim() &&
          operation != 'D' &&
          string.from(currentWinner.operation).trim().toUpperCase() != 'D';
        let relevantWinnerRefs = [{ id: winnerId, identityKey }].concat(logicalWinnerRefs);
        if (accepted && !matchesDurableWinnerContent && !reassertsDurableTombstone) {
          for (const winnerRef of relevantWinnerRefs) {
            let relevantWinner = sync_row_winner_find_by_id(
              pendingWinners,
              string.from(winnerRef.id)
            );
            if (relevantWinner == null) {
              relevantWinner = sync_row_winner_find_by_id(
                currentWinners,
                string.from(winnerRef.id)
              );
            }
            if (relevantWinner != null &&
                string.from(relevantWinner.operationId) != operationId &&
                !sync_row_candidate_is_later(
                  incomingRow,
                  relevantWinner,
                  string.from(serverReceivedAt),
                  serverSequence,
                  normalizedClientName,
                  conflictSourceClient
                )) {
              accepted = false;
            }
          }
        }
        if (accepted &&
            !matchesDurableWinnerContent &&
            !reassertsDurableTombstone &&
            (currentWinner == null || string.from(currentWinner.operationId) != operationId)) {
          const logicalWinnerIds = logicalWinnerRefs.map((value) => string.from(value.id));
          for (const winnerRef of relevantWinnerRefs) {
            let relevantWinner = sync_row_winner_find_by_id(
              pendingWinners,
              string.from(winnerRef.id)
            );
            if (relevantWinner == null) {
              relevantWinner = sync_row_winner_find_by_id(
                currentWinners,
                string.from(winnerRef.id)
              );
            }
            if (relevantWinner != null &&
                string.from(relevantWinner.physicalKey) != physicalKey) {
              const displacedIdentityKey = crypto.hash(json.stringify({
                table: winnerTable.trim().toLowerCase(),
                values: ['physical', string.from(relevantWinner.physicalKey)]
              }), 'sha256');
              const displacedWinnerId = sync_row_winner_id(
                winnerOwnerUserId,
                winnerTable,
                displacedIdentityKey
              );
              let displacedWinner = sync_row_winner_find_by_id(
                pendingWinners,
                displacedWinnerId
              );
              if (displacedWinner == null) {
                displacedWinner = sync_row_winner_find_by_id(
                  currentWinners,
                  displacedWinnerId
                );
              }
              if (displacedWinner != null) {
                pendingWinners = sync_row_winner_replace(
                  pendingWinners,
                  sync_row_next_winner_record(
                    string.from(displacedWinner.id),
                    string.from(displacedWinner.identityKey),
                    string.from(displacedWinner.physicalKey),
                    displacedWinner.logicalWinnerIds ?? [],
                    incomingRow,
                    winnerOwnerUserId,
                    winnerTable,
                    string.from(serverReceivedAt),
                    serverSequence,
                    normalizedClientName,
                    displacedWinner
                  )
                );
              }
            }
            pendingWinners = sync_row_winner_replace(
              pendingWinners,
              sync_row_next_winner_record(
                string.from(winnerRef.id),
                string.from(winnerRef.identityKey),
                physicalKey,
                string.from(winnerRef.id) == winnerId ? logicalWinnerIds : [],
                incomingRow,
                winnerOwnerUserId,
                winnerTable,
                string.from(serverReceivedAt),
                serverSequence,
                normalizedClientName,
                relevantWinner
              )
            );
          }
        }
        if (accepted && matchesDurableWinnerContent && currentWinner != null) {
          // Identical full-union retries can arrive from several clients and
          // pages. Advance only the relay operation id while preserving the
          // durable winner's ordering metadata. The final durable id then
          // selects exactly one payload row for this identity at download,
          // preventing duplicate relay candidates from inflating canonical
          // verification counts.
          const relayedWinner = {
            id: currentWinner.id,
            ownerUserId: currentWinner.ownerUserId,
            table: currentWinner.table,
            identityKey: currentWinner.identityKey,
            physicalKey: currentWinner.physicalKey,
            logicalWinnerIds: currentWinner.logicalWinnerIds ?? [],
            modifiedAtUtc: currentWinner.modifiedAtUtc,
            serverReceivedAtUtc: currentWinner.serverReceivedAtUtc,
            serverSequence: currentWinner.serverSequence,
            originClient: currentWinner.originClient,
            changeVersion: currentWinner.changeVersion,
            operationId,
            rowHash: currentWinner.rowHash,
            operation: currentWinner.operation,
            revision: int.from(currentWinner.revision) + 1,
            updatedAt: serverReceivedAt
          };
          pendingWinners = sync_row_winner_replace(pendingWinners, relayedWinner);
        }
      }
      if (accepted) {
        let durableOperationId = operationId;
        let authoritativeModifiedAtUtc = sync_row_effective_modified_at(
          incomingRow,
          string.from(serverReceivedAt)
        );
        let authoritativeOperation = string.from(
          incomingRow.__sync_op ?? 'S'
        ).trim().toUpperCase();
        if (reassertsDurableTombstone && durableTombstoneWinner != null) {
          // A complete snapshot never creates a delete. When it reports a
          // zombie row that is already covered by a durable explicit
          // tombstone, relay that existing tombstone back to every
          // participant. This repairs a client that retained or historically
          // reacquired the row without inferring deletion from absence.
          durableOperationId = string.from(
            durableTombstoneWinner.operationId
          ).trim();
          authoritativeModifiedAtUtc = string.from(
            durableTombstoneWinner.modifiedAtUtc ?? authoritativeModifiedAtUtc
          ).trim();
          authoritativeOperation = 'D';
        }
        acceptedOperationIds = acceptedOperationIds.concat([{
          operationId,
          durableOperationId,
          authoritativeModifiedAtUtc,
          authoritativeOperation,
          durableTombstoneReassertion: reassertsDurableTombstone,
          automaticNumber: automaticNumberDirective
        }]);
        acceptedRows = acceptedRows.concat([incomingRow]);
      }
    }
    if (pendingWinners.length > 0) {
      db.upsertMany(SyncRowWinner, pendingWinners, ['id']);
    }
    if (pendingAutoNumberSequences.length > 0) {
      if (pendingAutoNumberReservations.length > 0) {
        db.insertMany(AutoNumberReservation, pendingAutoNumberReservations);
      }
      db.upsertMany(AutoNumberSequence, pendingAutoNumberSequences, ['id']);
    }
    if (completeMultiClientUnionBootstrap && ready && autoNumberRule != null) {
      db.updateMany(AutoNumberSequence, {
        ownerUserId: winnerOwnerUserId,
        table: winnerTable
      }, {
        initialized: true,
        updatedAt: serverReceivedAt
      });
    }
    if (pendingAutoNumberIncidents.length > 0) {
      db.upsertMany(AutoNumberIncident, pendingAutoNumberIncidents, ['id']);
    }
    const relayRows = hasStoredPayload ? acceptedOperationIds : acceptedRows;
    db.update(SnapshotRecord, { id: chunkRecord.id }, {
      rows: relayRows,
      rowCount: acceptedRows.length
    });
    db.update(SyncJobDataChunk, { id: archivedChunk.id }, {
      rows: acceptedOperationIds,
      rowCount: acceptedRows.length
    });
    return {
      ok: true,
      acceptedRowCount: acceptedRows.length
    };
  });
  if (acceptance == null || acceptance.ok != true) {
    db.delete(SnapshotRecord, { id: chunkRecord.id });
    db.delete(SyncJobDataChunk, { id: archivedChunk.id });
    if (storageId.length != 0) {
      storage.delete(storageId);
    }
    return raw_json_error(409, 'sync batch changed while uploading; retry this chunk');
  }
  const acceptedRowCount = int.from(acceptance.acceptedRowCount ?? 0);
  const staleRowCount = incomingRowCount - acceptedRowCount;
  // Report durable job totals, not only the final transport page. The archive
  // row is inserted once per chunk and duplicate chunk ids return above, so
  // aggregating it is retry-idempotent and remains correct if chunks overlap.
  const cumulativeUploadStats = sync_job_data_stats(job);
  const cumulativeAcceptedRowCount = int.from(
    cumulativeUploadStats.retainedRowCount ?? 0
  );
  const committedBatch = find_sync_batch(batchId);
  let cumulativeIncomingRowCount = cumulativeAcceptedRowCount;
  if (committedBatch != null) {
    cumulativeIncomingRowCount = 0;
    for (const receivedChunk of committedBatch.receivedChunks ?? []) {
      if (string.from(receivedChunk.clientName).trim() == normalizedClientName) {
        cumulativeIncomingRowCount += int.from(receivedChunk.rowCount ?? 0);
      }
    }
  }
  let cumulativeStaleRowCount = cumulativeIncomingRowCount - cumulativeAcceptedRowCount;
  if (cumulativeStaleRowCount < 0) {
    cumulativeStaleRowCount = 0;
  }
  const updatedResult = finalChunk
    ? jobs_complete(job.id, 'completed', 100, string.concat(
        'Uploaded ',
        string.from(cumulativeAcceptedRowCount),
        ' accepted changed rows for ',
        table,
        cumulativeStaleRowCount > 0
          ? string.concat('; ignored ', string.from(cumulativeStaleRowCount), ' stale operation(s).')
          : '.'
      ), cumulativeAcceptedRowCount, null, null, null, null, null, token)
    : jobs_progress(job.id, 'uploading', 70, string.concat(
        'Uploaded ',
        string.from(cumulativeAcceptedRowCount),
        ' accepted changed rows for ',
        table,
        '.'
      ), cumulativeAcceptedRowCount, token);
  const updatedJob = updatedResult.job ?? job;
  // Clients poll their waiting batch download until the barrier is ready.
  let nextJob = job;
  if (updatedJob != null) {
    nextJob = updatedJob;
  }
  let retention = null;
  if (finalChunk && !comparisonPreview) {
    retention = prune_sync_job_data_for_owner(
      job.ownerUserId,
      job.id,
      sync_data_limit_mb_for_client(normalizedClientName)
    );
  }
  return raw_json_success({
    job: public_job_payload(nextJob),
    batchId,
    acceptedRows: acceptedRowCount,
    staleRowsIgnored: staleRowCount,
    mergedRowCount: acceptedRowCount,
    uploadedClients,
    expectedClientCount: batch.expectedClients.length,
    ready,
    clientChangeTrackingVersions,
    retention
  });
}

function jobs_multi_writer_download(jobId: string, batchId: string, cursor: string? = null, token: string? = null, protocolVersion: int = 0, syncEpoch: string = ''): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_multi_writer_download', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  const batch = find_sync_batch(batchId);
  if (batch == null || string.from(job.batchId).trim() != batchId.trim()) {
    return raw_json_error(404, 'sync batch not found');
  }
  if (protocolVersion != sync_protocol_version() || protocolVersion != int.from(batch.protocolVersion ?? 0)) {
    return raw_json_error(426, 'sync protocol upgrade required');
  }
  if (syncEpoch.trim().length == 0 || syncEpoch.trim() != string.from(batch.syncEpoch).trim()) {
    return raw_json_error(409, 'sync epoch changed; discard this job and refresh client state');
  }
  if (multi_writer_batch_stale(batch)) {
    return raw_json_error(410, 'multi-writer batch expired; start a new sync');
  }
  if (batch.status != 'ready') {
    return raw_json_error(409, 'sync batch is still waiting for client uploads');
  }
  // Every upload job in a multi-writer batch has the same source mode, so one
  // representative row is sufficient and avoids an additional bounded list.
  const unionBootstrapJob = db.selectOne(SyncJob, {
    batchId,
    direction: 'upload'
  });
  const canonicalFullMerge = unionBootstrapJob != null &&
    sync_source_is_union_bootstrap(string.from(unionBootstrapJob.sourceClientName));
  const automaticNumberInventoryOnly =
    sync_batch_automatic_retry_kind(batchId) == 'automatic-number-inventory';
  const storedChunkPage = db.page(SnapshotRecord, {
    // Upload snapshots can contain thousands of rows while the durable winner
    // register accepts only a handful. A zero-row relay record has no current
    // operation that any subscriber may apply, so advancing the cursor across
    // it would transfer an entire rejected/stale payload for no effect.
    where: { sourceJobId: batch.id, rowCount: { gt: 0 } },
    // Normal protocol-v4 pages contain Change Tracking deltas. Initial union
    // bootstrap pages are the guarded exception: every participant uploads a
    // full snapshot before any participant is allowed to download.
    orderBy: [
      { field: 'subscriberClientName', dir: 'asc' },
      { field: 'createdAt', dir: 'asc' },
      { field: 'id', dir: 'asc' }
    ],
    fields: ['id', 'sourceJobId', 'clientUserId', 'subscriberClientName', 'columns', 'rows', 'previewRows', 'rowCount', 'checksum', 'snapshotBytes', 'compressedBytes', 'encoding', 'storageId', 'isDelta', 'createdAt'],
    limit: 1,
    cursor
  });
  const storedChunks = storedChunkPage.rows;
  let chunkRows = [];
  let chunkPayloadBase64 = '';
  let chunkPayloadEncoding = 'json';
  let chunkIsDelta = true;
  let candidateAcceptedOperationIds = [];
  let candidateAcceptedOperations = [];
  let candidateDurableOperationIds = [];
  let winnerPolicyApplied = false;
  if (batch.receivedChunks.length == 0) {
    chunkIsDelta = false;
    for (const row of batch.rows) {
      chunkRows = chunkRows.concat([row]);
    }
  } else {
    for (const storedChunk of storedChunks) {
      const markerRows = storedChunk.previewRows ?? [];
      if (markerRows.length > 0 && markerRows[0].winnerPolicyApplied == true) {
        winnerPolicyApplied = true;
      }
      const storedPayloadId = string.from(storedChunk.storageId ?? '').trim();
      if (storedChunk.isDelta != true) {
        chunkIsDelta = false;
      }
      if (storedPayloadId.length != 0) {
        const storedPayload = storage.get(storedPayloadId);
        chunkPayloadBase64 = string.from(storedPayload.content_base64 ?? '').trim();
        chunkPayloadEncoding = string.from(storedChunk.encoding ?? 'json').trim();
        for (const acceptedRow of storedChunk.rows ?? []) {
          const acceptedOperationId = string.from(acceptedRow.operationId ?? '').trim();
          if (acceptedOperationId.length != 0) {
            let durableOperationId = string.from(
              acceptedRow.durableOperationId ?? acceptedOperationId
            ).trim();
            if (durableOperationId.length == 0) {
              durableOperationId = acceptedOperationId;
            }
            candidateAcceptedOperationIds = candidateAcceptedOperationIds.concat([acceptedOperationId]);
            candidateDurableOperationIds = candidateDurableOperationIds.concat([durableOperationId]);
            candidateAcceptedOperations = candidateAcceptedOperations.concat([{
              operationId: acceptedOperationId,
              durableOperationId,
              authoritativeModifiedAtUtc: string.from(
                acceptedRow.authoritativeModifiedAtUtc ?? ''
              ).trim(),
              authoritativeOperation: string.from(
                acceptedRow.authoritativeOperation ?? ''
              ).trim().toUpperCase(),
              durableTombstoneReassertion:
                acceptedRow.durableTombstoneReassertion == true,
              automaticNumber: acceptedRow.automaticNumber
            }]);
          }
        }
      } else {
        const storedRows = storedChunk.rows ?? [];
        chunkRows = chunkRows.concat(storedRows);
      }
    }
  }
  let acceptedOperationIds = candidateAcceptedOperationIds;
  let acceptedOperations = candidateAcceptedOperations;
  if (winnerPolicyApplied && candidateAcceptedOperationIds.length > 0) {
    const durableWinners = db.selectMany(SyncRowWinner, {
      where: {
        ownerUserId: string.from(batch.ownerUserId ?? '').trim(),
        table: string.from(batch.table),
        operationId: { in: candidateDurableOperationIds }
      },
      orderBy: { field: 'id', dir: 'asc' },
      fields: ['operationId', 'modifiedAtUtc', 'operation'],
      limit: 500
    });
    let durableWinnerOperationIds = [];
    for (const durableWinner of durableWinners) {
      const operationId = string.from(durableWinner.operationId).trim();
      if (operationId.length != 0) {
        durableWinnerOperationIds = durableWinnerOperationIds.concat([operationId]);
      }
    }
    acceptedOperationIds = [];
    acceptedOperations = [];
    for (const candidateOperation of candidateAcceptedOperations) {
      const operationId = string.from(candidateOperation.operationId).trim();
      const durableOperationId = string.from(
        candidateOperation.durableOperationId ?? operationId
      ).trim();
      if (operationId.length != 0 &&
          string_array_contains(durableWinnerOperationIds, durableOperationId)) {
        let authoritativeModifiedAtUtc = string.from(
          candidateOperation.authoritativeModifiedAtUtc ?? ''
        ).trim();
        let authoritativeOperation = string.from(
          candidateOperation.authoritativeOperation ?? ''
        ).trim().toUpperCase();
        let durableTombstoneReassertion = false;
        for (const durableWinner of durableWinners) {
          if (string.from(durableWinner.operationId).trim() == durableOperationId) {
            authoritativeModifiedAtUtc = string.from(
              durableWinner.modifiedAtUtc ?? authoritativeModifiedAtUtc
            ).trim();
            authoritativeOperation = string.from(
              durableWinner.operation ?? authoritativeOperation
            ).trim().toUpperCase();
            durableTombstoneReassertion =
              candidateOperation.durableTombstoneReassertion == true &&
              authoritativeOperation == 'D';
          }
        }
        acceptedOperationIds = acceptedOperationIds.concat([operationId]);
        acceptedOperations = acceptedOperations.concat([{
          operationId,
          authoritativeModifiedAtUtc,
          authoritativeOperation,
          durableTombstoneReassertion,
          automaticNumber: candidateOperation.automaticNumber
        }]);
      }
    }
  }
  // This phase exists only to initialize the owner-wide maximum. Applying its
  // ordinary union rows could conflict with the deliberately staged voucher
  // before the subsequent preserved delta receives its reserved number.
  if (automaticNumberInventoryOnly) {
    acceptedOperationIds = [];
    acceptedOperations = [];
    chunkRows = [];
    chunkPayloadBase64 = '';
    chunkPayloadEncoding = 'json';
    chunkIsDelta = false;
  }
  // Progress and immutable transfer identity describe relayable winner rows,
  // not the raw inventory rows received from every union participant.
  let totalRowCount = batch.rows.length;
  if (batch.receivedChunks.length > 0) {
    const relayTotals = db.aggregate(SnapshotRecord, {
      where: { sourceJobId: batch.id, rowCount: { gt: 0 } },
      select: [{ fn: 'sum', field: 'rowCount', as: 'rowCount' }]
    });
    totalRowCount = relayTotals.length == 0
      ? 0
      : int.from(relayTotals[0].rowCount ?? 0);
  }
  if (automaticNumberInventoryOnly) {
    totalRowCount = 0;
  }
  // A canonical union remains a complete, insert/update-only verification
  // even when every stored upload chunk was safely pruned. Never let an empty
  // optimized relay be interpreted as an ordinary delta or inferred delete.
  if (canonicalFullMerge) {
    chunkIsDelta = false;
  }
  const omitCurrentPayload = winnerPolicyApplied &&
    storedChunks.length > 0 &&
    chunkPayloadBase64.length != 0 &&
    acceptedOperationIds.length == 0;
  if (omitCurrentPayload) {
    chunkRows = [];
    chunkPayloadBase64 = '';
    chunkPayloadEncoding = 'json';
  }
  const nextCursor = storedChunkPage.nextCursor;
  const done = nextCursor == null || string.from(nextCursor).trim().length == 0;
  const snapshot = {
    id: string.concat(batch.id, '-', string.from(job.clientName), '-', string.from(cursor ?? 'first')),
    clientName: 'server-merge',
    subscriberClientName: job.clientName,
    table: batch.table,
    rowCount: chunkRows.length,
    checksum: storedChunks.length == 0
      ? snapshot_checksum({ batchId, cursor, rows: chunkRows })
      : string.from(storedChunks[0].checksum),
    createdAt: batch.updatedAt,
    snapshotBytes: json.stringify(chunkRows).length,
    compressedBytes: storedChunks.length == 0 || omitCurrentPayload
      ? 0
      : int.from(storedChunks[0].compressedBytes ?? 0),
    chunkCount: 0,
    encoding: chunkPayloadEncoding,
    sourceJobId: job.id,
    columns: batch.columns,
    keyColumns: batch.keyColumns,
    uniqueKeyColumnSets: batch.uniqueKeyColumnSets ?? [],
    clientChangeTrackingVersions: batch.clientChangeTrackingVersions,
    rows: chunkRows,
    isDelta: chunkIsDelta,
    protocolVersion: batch.protocolVersion,
    syncEpoch: batch.syncEpoch,
    totalRowCount,
    canonicalFullMerge,
    mergeParticipantCount: batch.expectedClients.length,
    done,
    nextCursor
  };
  if (storedChunks.length > 0) {
    snapshot.serverReceivedAtUtc = string.from(storedChunks[0].createdAt);
    snapshot.serverSequence = string.concat(
      string.from(storedChunks[0].createdAt),
      '::',
      string.from(storedChunks[0].id)
    );
    snapshot.serverOriginClient = string.from(storedChunks[0].subscriberClientName ?? storedChunks[0].clientUserId ?? '');
    snapshot.winnerPolicyApplied = winnerPolicyApplied;
    snapshot.acceptedOperationIds = acceptedOperationIds;
    snapshot.acceptedOperations = acceptedOperations;
  }
  if (chunkPayloadBase64.length != 0) {
    snapshot.rows = [];
    snapshot.snapshotBytes = int.from(storedChunks[0].snapshotBytes ?? 0);
  } else if (omitCurrentPayload) {
    snapshot.snapshotBytes = 0;
  }
  const transferManifestId = crypto.hash(json.stringify({
    version: 1,
    batchId: batch.id,
    protocolVersion: batch.protocolVersion,
    syncEpoch: batch.syncEpoch,
    table: batch.table,
    expectedClients: batch.expectedClients,
    totalRowCount
  }), 'sha256');
  let transferChunkPayload = string.from(chunkPayloadBase64);
  if (transferChunkPayload.length == 0) {
    transferChunkPayload = json.stringify(chunkRows);
  }
  const transferChunk = {
    id: crypto.hash(json.stringify({
      manifestId: transferManifestId,
      cursor: cursor ?? '',
      nextCursor: nextCursor ?? '',
      payloadSha256: crypto.hash(transferChunkPayload, 'sha256')
    }), 'sha256'),
    sha256: crypto.hash(transferChunkPayload, 'sha256'),
    cursor: cursor ?? '',
    nextCursor: nextCursor ?? '',
    rowCount: chunkRows.length,
    compressedBytes: chunkPayloadBase64.length == 0
      ? 0
      : int.from(storedChunks[0].compressedBytes ?? 0),
    uncompressedBytes: int.from(snapshot.snapshotBytes ?? 0)
  };
  return raw_json_success({
    snapshot,
    cursor,
    nextCursor,
    totalRowCount,
    done,
    payloadBase64: chunkPayloadBase64,
    payloadEncoding: chunkPayloadEncoding,
    isDelta: chunkIsDelta,
    transferManifest: {
      version: 1,
      id: transferManifestId,
      immutable: true,
      batchId: batch.id,
      protocolVersion: batch.protocolVersion,
      syncEpoch: batch.syncEpoch,
      table: batch.table,
      totalRowCount
    },
    transferChunk
  });
}

function jobs_upload_chunk(jobId: string, uploadId: string, chunkIndex: int, chunkData: string, token: string? = null): map<json> {
  log.info('snapshot upload chunk checkpoint', {
    stage: 'auth_lookup_start',
    jobId,
    uploadId,
    chunkIndex,
    chunkDataChars: chunkData.length,
    tokenPresent: token != null && token.trim().length > 0
  });
  const current = current_user_record(token);
  log.info('snapshot upload chunk checkpoint', {
    stage: 'auth_lookup_complete',
    jobId,
    uploadId,
    chunkIndex,
    authenticated: current != null
  });
  const job = find_job_by_id(jobId);
  log.info('snapshot upload chunk checkpoint', {
    stage: 'job_lookup_complete',
    jobId,
    uploadId,
    chunkIndex,
    jobFound: job != null
  });
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_upload_chunk', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  const session = find_upload_session_for_job(jobId, uploadId);
  log.info('snapshot upload chunk checkpoint', {
    stage: 'session_lookup_complete',
    jobId,
    uploadId,
    chunkIndex,
    sessionFound: session != null
  });
  if (session == null) {
    return raw_json_error(404, 'upload session not found');
  }
  if (chunkIndex < 0 || chunkIndex >= session.chunkCount) {
    return raw_json_error(400, 'chunk index is out of range');
  }
  if (chunkData.trim().length == 0) {
    return raw_json_error(400, 'chunkData is required');
  }

  let nextChunks = [];
  let replaced = false;
  for (const item of session.chunks) {
    if (item.index == chunkIndex) {
      nextChunks = nextChunks.concat([{
        index: chunkIndex,
        data: chunkData,
        bytes: chunkData.length
      }]);
      replaced = true;
    } else {
      nextChunks = nextChunks.concat([item]);
    }
  }
  if (!replaced) {
    nextChunks = nextChunks.concat([{
      index: chunkIndex,
      data: chunkData,
      bytes: chunkData.length
    }]);
  }

  const updatedSession = db.update(UploadSession, { id: session.id }, {
    chunks: nextChunks,
    updatedAt: now_iso()
  });
  log.info('snapshot upload chunk checkpoint', {
    stage: 'session_write_complete',
    jobId,
    uploadId,
    chunkIndex,
    receivedChunkCount: nextChunks.length,
    sessionWriteSucceeded: updatedSession != null
  });
  let nextSession = session;
  if (updatedSession != null) {
    nextSession = updatedSession;
  }
  const received = chunk_indexes(nextSession);
  let progress = 35;
  if (session.chunkCount > 0) {
    const receivedCount = int.from(received.length);
    const estimated = int.from((receivedCount * 50) / session.chunkCount);
    progress = 35 + estimated;
    if (progress < 35) {
      progress = 35;
    }
    if (progress > 85) {
      progress = 85;
    }
  }
  const updatedJob = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: 'uploading',
    progress,
    rowCount: session.rowCount,
    snapshotBytes: session.snapshotBytes,
    snapshotCreatedAt: session.snapshotCreatedAt,
    snapshotId: null,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: null,
    message: string.concat('Received snapshot chunk ', string.from(chunkIndex + 1), '/', string.from(session.chunkCount), '.'),
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  log.info('snapshot upload chunk checkpoint', {
    stage: 'job_write_complete',
    jobId,
    uploadId,
    chunkIndex,
    progress,
    jobWriteSucceeded: updatedJob != null
  });
  let nextJob = job;
  if (updatedJob != null) {
    nextJob = updatedJob;
  }
  return raw_json_success({
    job: public_job_payload(nextJob),
    uploadId: nextSession.uploadId,
    chunkCount: nextSession.chunkCount,
    receivedIndexes: received
  });
}

function jobs_upload_chunk_complete(jobId: string, uploadId: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_upload_chunk_complete', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  const session = find_upload_session_by_upload_id(uploadId);
  if (session == null || session.jobId != jobId) {
    return raw_json_error(404, 'upload session not found');
  }
  const received = chunk_indexes(session);
  if (received.length != session.chunkCount) {
    return raw_json_success({
      error: 'upload is missing chunks',
      uploadId: session.uploadId,
      chunkCount: session.chunkCount,
      compressedBytes: session.compressedBytes,
      chunkSizeBytes: session.chunkSizeBytes,
      receivedIndexes: received,
      receivedCount: received.length
    }, 409);
  }

  const targetJob = find_waiting_download_job(job.clientName, job.subscriberClientName, job.table);
  if (targetJob == null) {
    return raw_json_error(409, 'target download job not found');
  }

  const snapshotId = uuid.v4();
  let snapshotCreatedAt = now_iso();
  if (session.snapshotCreatedAt != null) {
    snapshotCreatedAt = session.snapshotCreatedAt;
  }
  const snapshot = db.insert(SnapshotRecord, {
    id: snapshotId,
    clientName: job.clientName,
    subscriberClientName: job.subscriberClientName,
    table: session.table,
    rowCount: session.rowCount,
    checksum: snapshot_checksum({ id: uploadId, sourceJobId: jobId, table: session.table, rowCount: session.rowCount, snapshotBytes: session.snapshotBytes, compressedBytes: session.compressedBytes }),
    createdAt: snapshotCreatedAt,
    snapshotBytes: session.snapshotBytes,
    columns: [],
    rows: [],
    previewRows: [],
    compressedBytes: session.compressedBytes,
    chunkCount: session.chunkCount,
    encoding: session.encoding,
    storageId: '',
    isDelta: false,
    sourceJobId: jobId,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId
  });

  const existingDownloadSession = find_active_download_session_for_job(targetJob.id, snapshotId);
  if (existingDownloadSession != null) {
    db.delete(DownloadSession, { id: existingDownloadSession.id });
  }
  db.insert(DownloadSession, {
    id: uuid.v4(),
    jobId: targetJob.id,
    snapshotId,
    table: session.table,
    chunkSizeBytes: session.chunkSizeBytes,
    chunkCount: session.chunkCount,
    compressedBytes: session.compressedBytes,
    encoding: session.encoding,
    createdAt: now_iso(),
    updatedAt: now_iso(),
    chunks: session.chunks
  });

  const queuedTarget = db.update(SyncJob, { id: targetJob.id }, {
    clientName: targetJob.clientName,
    sourceClientName: targetJob.sourceClientName,
    subscriberClientName: targetJob.subscriberClientName,
    table: targetJob.table,
    direction: targetJob.direction,
    publisherServer: targetJob.publisherServer,
    publisherDatabase: targetJob.publisherDatabase,
    publisherUseWindowsAuth: targetJob.publisherUseWindowsAuth,
    publisherUser: targetJob.publisherUser,
    publisherPassword: targetJob.publisherPassword,
    status: 'queued',
    progress: 5,
    rowCount: session.rowCount,
    snapshotBytes: session.snapshotBytes,
    snapshotCreatedAt,
    snapshotId,
    createdAt: targetJob.createdAt,
    startedAt: null,
    completedAt: null,
    message: string.concat('Snapshot is ready for download for ', targetJob.table, '.'),
    error: null,
    clientUserId: targetJob.clientUserId,
    ownerUserId: targetJob.ownerUserId,
    updatedAt: now_iso()
  });

  const completed = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: 'completed',
    progress: 100,
    rowCount: session.rowCount,
    snapshotBytes: session.snapshotBytes,
    snapshotCreatedAt,
    snapshotId,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: now_iso(),
    message: string.concat('Uploaded snapshot with ', string.from(session.rowCount), ' rows for ', targetJob.clientName, '.'),
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });

  db.delete(UploadSession, { jobId });

  let nextJob = job;
  if (completed != null) {
    nextJob = completed;
  }
  let nextTargetJob = targetJob;
  if (queuedTarget != null) {
    nextTargetJob = queuedTarget;
  }
  return raw_json_success({
    job: public_job_payload(nextJob),
    targetJob: public_job_payload(nextTargetJob),
    snapshot: public_snapshot_payload(snapshot)
  });
}

function jobs_download_snapshot_manifest(jobId: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_download_snapshot_manifest', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  const snapshot = latest_download_snapshot_for_job(job);
  if (snapshot == null) {
    return raw_json_error(404, 'snapshot not found');
  }
  const session = find_active_download_session_for_job(jobId, snapshot.id);
  if (session == null) {
    return raw_json_error(404, 'download session not found');
  }
  let progress = job.progress;
  if (progress < 30) {
    progress = 30;
  }
  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: 'downloading',
    progress,
    rowCount: snapshot.rowCount,
    snapshotBytes: snapshot.snapshotBytes,
    snapshotCreatedAt: snapshot.createdAt,
    snapshotId: snapshot.id,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: null,
    message: string.concat('Prepared ', string.from(session.chunkCount), ' snapshot chunks for download.'),
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  return raw_json_success({
    job: public_job_payload(nextJob),
    snapshot: public_snapshot_payload(snapshot),
    manifest: download_session_payload(session)
  });
}

function jobs_download_snapshot_chunk(jobId: string, chunkIndex: int? = null, token: string? = null): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_download_snapshot_chunk', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return raw_json_error(410, 'sync job is no longer active');
  }
  if (chunkIndex == null) {
    return raw_json_error(400, 'chunkIndex is required');
  }
  const snapshot = latest_download_snapshot_for_job(job);
  if (snapshot == null) {
    return raw_json_error(404, 'snapshot not found');
  }
  const session = find_active_download_session_for_job(jobId, snapshot.id);
  if (session == null) {
    return raw_json_error(404, 'download session not found');
  }
  if (chunkIndex < 0 || chunkIndex >= session.chunkCount) {
    return raw_json_error(400, 'chunk index is out of range');
  }
  const chunkData = chunk_data_for_index(session, chunkIndex);
  if (chunkData.length == 0) {
    return raw_json_error(404, 'chunk not found');
  }
  let progress = 40;
  if (session.chunkCount > 0) {
    progress = 40 + int.from(((chunkIndex + 1) * 35) / session.chunkCount);
  }
  db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: 'downloading',
    progress,
    rowCount: snapshot.rowCount,
    snapshotBytes: snapshot.snapshotBytes,
    snapshotCreatedAt: snapshot.createdAt,
    snapshotId: snapshot.id,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: null,
    message: string.concat('Served snapshot chunk ', string.from(chunkIndex + 1), '/', string.from(session.chunkCount), '.'),
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  return raw_json_success({
    transferId: session.id,
    chunkIndex,
    chunkCount: session.chunkCount,
    chunkData
  });
}

function jobs_create(clientName: string, tables: array<string>, token: string? = null): map<json> {
  if (tables.length == 0) {
    return raw_json_error(400, 'tables are required.');
  }
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = clientName;
  if (clientName.trim().length == 0) {
    if (current.username != null) {
      resolvedClientName = current.username;
    }
  }
  const clientUser = find_user_by_identity(resolvedClientName);
  if (clientUser != null && !can_manage_user(current, clientUser)) {
    return raw_json_error(403, 'permission denied');
  }
  if (clientUser == null || !is_client_user(clientUser)) {
    return raw_json_error(404, 'client not found');
  }
  const ownerId = owner_namespace_for_user(clientUser);
  const schedulerAgents = list_scheduler_agent_rows();
  const ownerAgents = schedulerAgents.filter((agent) =>
    string.from(agent.ownerUserId) == ownerId && agent_sync_enabled(agent)
  );
  const ownerPolicies = list_table_sync_policies_for_scope(ownerId);
  refresh_owner_baseline_table_issues(ownerId, schedulerAgents, ownerPolicies);
  if (sync_owner_has_blocking_table_issues(ownerId)) {
    return raw_json_error(409, 'Sync is stopped because one or more tables need a user decision.');
  }
  const targetAgent = find_agent_row_by_name(ownerAgents, resolvedClientName);
  if (targetAgent == null) {
    return raw_json_error(404, 'client not found');
  }
  if (!agent_sync_enabled(targetAgent)) {
    return raw_json_error(409, 'client synchronization is disabled');
  }
  let offlineClients = [];
  let onlineAgents = [];
  for (const agent of ownerAgents) {
    if (!effective_agent_online(agent)) {
      offlineClients = offlineClients.concat([string.from(agent.clientName)]);
    } else {
      onlineAgents = onlineAgents.concat([agent]);
    }
  }
  if (!effective_agent_online(targetAgent)) {
    return raw_json_error(409, 'the requested client is offline');
  }
  if (onlineAgents.length == 0) {
    return raw_json_error(409, 'no enabled client is online');
  }
  const preserveChangeTrackingBaselines = onlineAgents.length != ownerAgents.length;
  const requestedTables = expand_sync_job_tables_for_owner(ownerId, unique_string_values(tables));
  const tableCaches = onlineAgents.map((agent) =>
    scheduler_agent_table_state_cache(agent, ownerPolicies)
  );
  const recentUploadModes = latest_completed_upload_modes_for_owner(ownerId);
  let tablePlans = [];
  for (const table of requestedTables) {
    const plan = sync_table_baseline_plan(
      table,
      onlineAgents,
      ownerPolicies,
      tableCaches,
      !preserveChangeTrackingBaselines,
      recentUploadModes
    );
    if ((plan.participants ?? []).length == 0) {
      return raw_json_error(409, string.concat('sync table is not enabled: ', table));
    }
    if (string.from(plan.mode) == 'needs_input') {
      raise_sync_table_issue(ownerId, table, 'baseline_mismatch', string.from(plan.message));
      return raw_json_error(409, string.from(plan.message));
    }
    if (string.from(plan.mode) == 'unavailable') {
      return raw_json_error(409, string.from(plan.message));
    }
    tablePlans = tablePlans.concat([plan]);
  }
  let createdJobs = [];
  for (const plan of tablePlans) {
    let nextJobs = [];
    if (string.from(plan.mode) == 'reconcile' &&
        plan.sourceAgent != null &&
        (plan.targetAgents ?? []).length > 0) {
      if (preserveChangeTrackingBaselines) {
        return raw_json_error(
          409,
          'authoritative baseline reconciliation waits until every enabled client is online'
        );
      }
      nextJobs = create_authoritative_reconcile_batch(
        ownerId,
        string.from(plan.table),
        plan.sourceAgent,
        plan.targetAgents
      );
    } else if (string.from(plan.mode) == 'delta' ||
        string.from(plan.mode) == 'union_bootstrap' ||
        string.from(plan.mode) == 'range_union') {
      const planIsUnion = string.from(plan.mode) == 'union_bootstrap' ||
        string.from(plan.mode) == 'range_union';
      if (planIsUnion && preserveChangeTrackingBaselines) {
        return raw_json_error(
          409,
          'multi-client union bootstrap waits until every enabled client is online'
        );
      }
      nextJobs = create_multi_writer_batch(
        ownerId,
        string.from(plan.table),
        plan.participants ?? [],
        '',
        preserveChangeTrackingBaselines,
        planIsUnion,
        ownerPolicies,
        '',
        string.from(plan.rangeBucketCsv ?? '')
      );
    }
    if (nextJobs.length > 0) {
      if (preserveChangeTrackingBaselines) {
        mark_offline_sync_debt(
          ownerId,
          string.from(plan.table),
          ownerAgents,
          onlineAgents,
          ownerPolicies
        );
      }
      createdJobs = createdJobs.concat(nextJobs);
    }
  }
  return raw_json_success({
    mode: 'protocol-v4',
    jobs: createdJobs.map((job) => public_job_payload(job))
  }, 201);
}

function jobs_recover_automatic_number_collision(clientName: string, table: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  if (!automatic_sync_is_paused_for_user(current)) {
    return raw_json_error(409, 'pause automatic sync before automatic-number recovery');
  }
  const normalizedClientName = normalize_user_name(clientName);
  const clientUser = find_user_by_identity(normalizedClientName);
  if (clientUser == null ||
      !is_client_user(clientUser) ||
      !can_manage_user(current, clientUser)) {
    return raw_json_error(403, 'permission denied');
  }
  const ownerUserId = owner_namespace_for_user(clientUser);
  const normalizedTable = table.trim();
  if (normalizedTable.length == 0 ||
      string_array_contains(active_job_tables_for_owner(ownerUserId), normalizedTable)) {
    return raw_json_error(409, 'automatic-number recovery requires an idle table');
  }
  const failedJobs = db.selectMany(SyncJob, {
    where: {
      ownerUserId,
      table: normalizedTable,
      direction: 'download',
      status: 'failed'
    },
    orderBy: { field: 'completedAt', dir: 'desc' },
    fields: ['batchId', 'message'],
    limit: 1
  });
  if (failedJobs.length == 0 ||
      !string.from(failedJobs[0].message ?? '').trim().toLowerCase()
        .contains('cannot insert duplicate key row')) {
    return raw_json_error(409, 'no failed automatic-number allocation collision is available for recovery');
  }
  const failedBatch = find_sync_batch(string.from(failedJobs[0].batchId ?? ''));
  if (failedBatch == null ||
      automatic_number_rule(
        normalizedTable,
        failedBatch.columns ?? [],
        failedBatch.keyColumns ?? [],
        failedBatch.uniqueKeyColumnSets ?? []
      ) == null) {
    return raw_json_error(409, 'the failed table does not have a validated automatic-number schema');
  }
  const reservedIncidents = db.selectMany(AutoNumberIncident, {
    where: {
      ownerUserId,
      table: normalizedTable,
      status: 'reserved'
    },
    orderBy: { field: 'detectedAt', dir: 'asc' },
    fields: ['id'],
    limit: 100
  });
  if (reservedIncidents.length == 0) {
    return raw_json_error(409, 'no reserved automatic number requires recovery');
  }
  const syncScope = automatic_number_sync_participants(
    ownerUserId,
    normalizedTable
  );
  if (!automatic_number_participants_online(syncScope.participants ?? [])) {
    return raw_json_error(409, 'every enabled client must be online and SQL-connected for complete number inventory recovery');
  }
  const recoveryAt = now_iso();
  db.updateMany(AutoNumberSequence, {
    ownerUserId,
    table: normalizedTable
  }, {
    initialized: false,
    updatedAt: recoveryAt
  });
  db.updateMany(AutoNumberIncident, {
    id: { in: reservedIncidents.map((incident) => string.from(incident.id)) },
    ownerUserId,
    table: normalizedTable,
    status: 'reserved'
  }, {
    status: 'blocked',
    reason: 'The reserved number was already occupied on a client. The reservation was invalidated atomically; a complete multi-client inventory is running before retry.',
    afterNumber: '',
    resolvedAt: null,
    updatedAt: recoveryAt
  });
  const jobs = queue_automatic_number_inventory_recovery(
    ownerUserId,
    normalizedTable
  );
  if (jobs.length == 0) {
    return raw_json_error(409, 'complete number inventory recovery could not be queued safely');
  }
  return raw_json_success({
    mode: 'automatic-number-complete-inventory-recovery',
    table: normalizedTable,
    invalidatedIncidentCount: reservedIncidents.length,
    jobs: jobs.map((job) => public_job_payload(job))
  }, 201);
}

function jobs_bootstrap(clientName: string, tables: array<string>, token: string? = null): map<json> {
  if (tables.length == 0) {
    return raw_json_error(400, 'tables are required.');
  }
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedClientName = normalize_user_name(clientName);
  const clientUser = find_user_by_identity(normalizedClientName);
  if (clientUser == null || !is_client_user(clientUser) || !can_manage_user(current, clientUser)) {
    return raw_json_error(403, 'permission denied');
  }
  const ownerId = owner_namespace_for_user(clientUser);
  refresh_owner_baseline_table_issues(ownerId);
  if (sync_owner_has_blocking_table_issues(ownerId)) {
    return raw_json_error(409, 'Sync is stopped because one or more tables need a user decision.');
  }
  const targetAgent = db.selectOne(Agent, { clientName: normalizedClientName });
  if (targetAgent == null || !agent_sync_enabled(targetAgent)) {
    return raw_json_error(409, 'bootstrap client is unavailable or disabled');
  }
  if (!effective_agent_online(targetAgent)) {
    return raw_json_error(409, 'bootstrap client must be online and SQL-connected');
  }
  const enabledOwnerAgents = list_scheduler_agent_rows().filter((agent) =>
    string.from(agent.ownerUserId) == ownerId && agent_sync_enabled(agent)
  );
  if (enabledOwnerAgents.length != 1 || string.from(enabledOwnerAgents[0].clientName) != normalizedClientName) {
    return raw_json_error(409, 'explicit bootstrap requires exactly one enabled client');
  }
  const ownerPolicies = list_table_sync_policies_for_scope(ownerId);
  const enabledTables = unique_string_values(
    enabled_sync_tables_for_agent_with_policies(targetAgent, ownerPolicies).concat(
      enabled_sync_policy_tables_for_agent(targetAgent, ownerPolicies)
    )
  );
  if (active_job_tables_for_client(normalizedClientName).length != 0) {
    return raw_json_error(409, 'bootstrap client already has active jobs');
  }
  let createdJobs = [];
  for (const table of unique_string_values(tables)) {
    if (!string_array_contains(enabledTables, table)) {
      return raw_json_error(409, string.concat('bootstrap table is not enabled: ', table));
    }
    const jobs = create_multi_writer_batch(
      ownerId,
      table,
      [targetAgent],
      normalizedClientName,
      false,
      false,
      ownerPolicies
    );
    if (jobs.length > 0) {
      createdJobs = createdJobs.concat(jobs);
    }
  }
  return raw_json_success({
    mode: 'protocol-v4-bootstrap',
    clientName: normalizedClientName,
    jobs: createdJobs.map((job) => public_job_payload(job))
  }, 201);
}

function jobs_reconcile_authoritative(sourceClientName: string, targetClientNames: array<string>, tables: array<string>, token: string? = null): map<json> {
  if (targetClientNames.length == 0) {
    return raw_json_error(400, 'at least one target client is required.');
  }
  if (tables.length == 0) {
    return raw_json_error(400, 'tables are required.');
  }
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  if (!automatic_sync_is_paused_for_user(current)) {
    return raw_json_error(409, 'pause automatic sync before authoritative reconciliation');
  }

  const visibleAgents = visible_agent_rows_for(current);
  const normalizedSourceClientName = normalize_user_name(sourceClientName);
  const sourceAgent = find_agent_row_by_name(visibleAgents, normalizedSourceClientName);
  if (sourceAgent == null) {
    return raw_json_error(403, 'source client is unavailable or outside your scope');
  }
  const ownerId = string.from(sourceAgent.ownerUserId);
  if (!effective_agent_online(sourceAgent)) {
    return raw_json_error(409, 'source client must be online and SQL-connected');
  }

  let targetAgents = [];
  let normalizedTargetClientNames = [];
  for (const requestedTargetClientName of unique_string_values(targetClientNames)) {
    const normalizedTargetClientName = normalize_user_name(requestedTargetClientName);
    if (normalizedTargetClientName == normalizedSourceClientName) {
      return raw_json_error(409, 'source client cannot also be a reconciliation target');
    }
    if (string_array_contains(normalizedTargetClientNames, normalizedTargetClientName)) {
      continue;
    }
    const targetAgent = find_agent_row_by_name(visibleAgents, normalizedTargetClientName);
    if (targetAgent == null || string.from(targetAgent.ownerUserId) != ownerId) {
      return raw_json_error(403, string.concat('target client is unavailable or outside the source owner scope: ', normalizedTargetClientName));
    }
    if (!effective_agent_online(targetAgent)) {
      return raw_json_error(409, string.concat('target client must be online and SQL-connected: ', normalizedTargetClientName));
    }
    targetAgents = targetAgents.concat([targetAgent]);
    normalizedTargetClientNames = normalizedTargetClientNames.concat([normalizedTargetClientName]);
  }

  const participants = [sourceAgent].concat(targetAgents);
  for (const participant of participants) {
    if (active_job_tables_for_client(string.from(participant.clientName)).length != 0) {
      return raw_json_error(409, string.concat('reconciliation participant already has active jobs: ', string.from(participant.clientName)));
    }
  }

  const ownerPolicies = list_table_sync_policies_for_scope(ownerId);
  const requestedTables = unique_string_values(tables);
  for (const participant of participants) {
    const enabledTables = unique_string_values(
      enabled_sync_tables_for_agent_with_policies(participant, ownerPolicies).concat(
        enabled_sync_policy_tables_for_agent(participant, ownerPolicies)
      )
    );
    for (const table of requestedTables) {
      if (!string_array_contains(enabledTables, table)) {
        return raw_json_error(409, string.concat('reconciliation table is not enabled for ', string.from(participant.clientName), ': ', table));
      }
    }
  }

  let createdJobs = [];
  for (const table of requestedTables) {
    const existingIssue = sync_table_issue_for_owner(ownerId, table);
    if (existingIssue != null &&
        string.from(existingIssue.status ?? '').trim().toLowerCase() == 'needs_input') {
      replace_sync_table_issue(ownerId, {
        table,
        status: 'resolving',
        reason: string.from(existingIssue.reason ?? ''),
        message: 'Authoritative repair is in progress. No additional user decision is required.',
        clientName: existingIssue.clientName,
        action: 'authoritative_reconcile',
        sourceClientName: normalizedSourceClientName,
        targetClientNames: normalizedTargetClientNames,
        detectedAt: existingIssue.detectedAt,
        updatedAt: now_iso(),
        resolvedAt: null
      });
    }
    const jobs = create_authoritative_reconcile_batch(ownerId, table, sourceAgent, targetAgents);
    if (jobs.length > 0) {
      createdJobs = createdJobs.concat(jobs);
    }
  }
  return raw_json_success({
    mode: 'protocol-v4-authoritative-reconcile',
    sourceClientName: normalizedSourceClientName,
    targetClientNames: normalizedTargetClientNames,
    tables: requestedTables,
    jobs: createdJobs.map((job) => public_job_payload(job))
  }, 201);
}

// Replays a retained, completed full-union payload after an interrupted or
// faulty canonical apply. The original immutable snapshot is reused; clients
// do not upload their current (possibly damaged) table state.
function jobs_replay_retained_union(batchId: string, clientNames: array<string>, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  if (!automatic_sync_is_paused_for_user(current)) {
    return raw_json_error(409, 'pause automatic sync before retained snapshot recovery');
  }
  const normalizedBatchId = batchId.trim();
  const batch = find_sync_batch(normalizedBatchId);
  if (batch == null || string.from(batch.status).trim() != 'ready') {
    return raw_json_error(404, 'ready retained sync batch not found');
  }
  const ownerUserId = string.from(batch.ownerUserId ?? '').trim();
  if (!is_admin_user(current) && ownerUserId != owner_namespace_for_user(current)) {
    return raw_json_error(403, 'retained sync batch is outside your scope');
  }
  const unionUpload = db.selectOne(SyncJob, {
    batchId: normalizedBatchId,
    direction: 'upload',
    sourceClientName: 'server-union-bootstrap-v3'
  });
  if (unionUpload == null || (batch.receivedChunks ?? []).length == 0) {
    return raw_json_error(409, 'retained batch is not a complete full-union snapshot');
  }
  const retainedPayload = db.selectOne(SnapshotRecord, {
    sourceJobId: normalizedBatchId
  });
  if (retainedPayload == null) {
    return raw_json_error(410, 'retained full-union payload is no longer available');
  }
  if (int.from(batch.protocolVersion ?? 0) != sync_protocol_version() ||
      string.from(batch.syncEpoch ?? '').trim() != string.from(sync_protocol_state().syncEpoch).trim()) {
    return raw_json_error(409, 'retained batch belongs to a different sync protocol epoch');
  }

  const requestedClientNames = unique_string_values(clientNames);
  if (requestedClientNames.length == 0) {
    return raw_json_error(400, 'at least one recovery client is required');
  }
  const visibleAgents = visible_agent_rows_for(current);
  const ownerPolicies = list_table_sync_policies_for_scope(ownerUserId);
  const normalizedSourceClientName = normalize_user_name(string.from(requestedClientNames[0]));
  if (normalizedSourceClientName.length == 0 ||
      !string_array_contains(batch.expectedClients, normalizedSourceClientName) ||
      !string_array_contains(batch.uploadedClients, normalizedSourceClientName)) {
    return raw_json_error(409, 'recovery source must be a completed participant in the retained union');
  }
  const retainedUnionPayloadPage = db.page(SnapshotRecord, {
    where: { sourceJobId: normalizedBatchId },
    orderBy: [
      { field: 'subscriberClientName', dir: 'asc' },
      { field: 'createdAt', dir: 'asc' },
      { field: 'id', dir: 'asc' }
    ],
    fields: ['id', 'clientName', 'subscriberClientName', 'table', 'rowCount', 'checksum', 'createdAt', 'snapshotBytes', 'columns', 'rows', 'previewRows', 'compressedBytes', 'chunkCount', 'encoding', 'storageId', 'isDelta', 'sourceJobId', 'clientUserId', 'ownerUserId'],
    limit: 500,
    cursor: null
  });
  const retainedUnionPayloads = retainedUnionPayloadPage.rows;
  let retainedSourcePayloads = [];
  for (const retainedUnionPayload of retainedUnionPayloads) {
    if (normalize_user_name(string.from(retainedUnionPayload.subscriberClientName)) == normalizedSourceClientName) {
      retainedSourcePayloads = retainedSourcePayloads.concat([retainedUnionPayload]);
    }
  }
  if (retainedSourcePayloads.length == 0) {
    return raw_json_error(410, 'retained source payload is no longer available');
  }
  let targetAgents = [];
  for (const requestedClientName of requestedClientNames) {
    const normalizedClientName = normalize_user_name(requestedClientName);
    const agent = find_agent_row_by_name(visibleAgents, normalizedClientName);
    if (agent == null || string.from(agent.ownerUserId ?? '').trim() != ownerUserId) {
      return raw_json_error(403, string.concat('recovery client is unavailable or outside the batch scope: ', normalizedClientName));
    }
    if (!effective_agent_online(agent)) {
      return raw_json_error(409, string.concat('recovery client must be online and SQL-connected: ', normalizedClientName));
    }
    if (active_job_tables_for_client(normalizedClientName).length != 0) {
      return raw_json_error(409, string.concat('recovery client already has active jobs: ', normalizedClientName));
    }
    const enabledTables = unique_string_values(
      enabled_sync_tables_for_agent_with_policies(agent, ownerPolicies).concat(
        enabled_sync_policy_tables_for_agent(agent, ownerPolicies)
      )
    );
    if (!string_array_contains(enabledTables, string.from(batch.table))) {
      return raw_json_error(409, string.concat('retained table is not enabled for recovery client: ', normalizedClientName));
    }
    targetAgents = targetAgents.concat([agent]);
  }

  const createdAt = now_iso();
  const recoveryBatchId = uuid.v4();
  let recoveryReceivedChunks = [];
  let recoveryReceivedBytes = 0;
  let recoverySnapshots = [];
  for (const retainedSourcePayload of retainedSourcePayloads) {
    const retainedRowCount = int.from(retainedSourcePayload.rowCount ?? 0);
    const retainedSnapshotBytes = int.from(retainedSourcePayload.snapshotBytes ?? 0);
    recoveryReceivedChunks = recoveryReceivedChunks.concat([{
      chunkId: string.from(retainedSourcePayload.id),
      clientName: normalizedSourceClientName,
      receivedAt: createdAt,
      rowCount: retainedRowCount
    }]);
    recoveryReceivedBytes += retainedSnapshotBytes;
    recoverySnapshots = recoverySnapshots.concat([{
      id: uuid.v4(),
      clientName: 'server-merge',
      subscriberClientName: normalizedSourceClientName,
      table: batch.table,
      rowCount: retainedRowCount,
      checksum: string.from(retainedSourcePayload.checksum),
      createdAt,
      snapshotBytes: retainedSnapshotBytes,
      columns: retainedSourcePayload.columns,
      rows: retainedSourcePayload.rows,
      previewRows: [{ winnerPolicyApplied: false, retainedRecovery: true }],
      compressedBytes: int.from(retainedSourcePayload.compressedBytes ?? 0),
      chunkCount: int.from(retainedSourcePayload.chunkCount ?? 1),
      encoding: string.from(retainedSourcePayload.encoding ?? 'json'),
      storageId: string.from(retainedSourcePayload.storageId ?? ''),
      isDelta: false,
      sourceJobId: recoveryBatchId,
      clientUserId: retainedSourcePayload.clientUserId,
      ownerUserId
    }]);
  }
  db.insert(SyncBatch, {
    id: recoveryBatchId,
    table: batch.table,
    revision: 0,
    ownerUserId,
    conflictSourceClient: batch.conflictSourceClient == null
      ? conflict_source_client_for_owner(ownerUserId)
      : normalize_user_name(string.from(batch.conflictSourceClient)),
    expectedClients: [normalizedSourceClientName],
    uploadedClients: [normalizedSourceClientName],
    receivedChunks: recoveryReceivedChunks,
    receivedBytes: recoveryReceivedBytes,
    clientChangeTrackingVersions: batch.clientChangeTrackingVersions,
    keyColumns: batch.keyColumns,
    columns: batch.columns,
    rows: [],
    status: 'ready',
    createdAt,
    updatedAt: createdAt,
    protocolVersion: batch.protocolVersion,
    syncEpoch: batch.syncEpoch
  });
  db.insertMany(SnapshotRecord, recoverySnapshots);

  let rows = [{
    id: uuid.v4(),
    clientName: normalizedSourceClientName,
    sourceClientName: 'server-union-bootstrap-v3',
    subscriberClientName: '',
    table: batch.table,
    direction: 'upload',
    publisherServer: '',
    publisherDatabase: sync_job_text(unionUpload.publisherDatabase),
    publisherUseWindowsAuth: unionUpload.publisherUseWindowsAuth == true,
    publisherUser: '',
    publisherPassword: '',
    status: 'completed',
    progress: 100,
    rowCount: 0,
    snapshotBytes: recoveryReceivedBytes,
    snapshotCreatedAt: createdAt,
    snapshotId: null,
    createdAt,
    updatedAt: createdAt,
    startedAt: createdAt,
    completedAt: createdAt,
    message: 'Retained full-union source prepared for recovery.',
    error: null,
    clientUserId: unionUpload.clientUserId,
    ownerUserId,
    batchId: recoveryBatchId,
    protocolVersion: batch.protocolVersion,
    syncEpoch: batch.syncEpoch
  }];
  for (const agent of targetAgents) {
    const clientName = string.from(agent.clientName);
    rows = rows.concat([{
      id: uuid.v4(),
      clientName,
      sourceClientName: 'server-retained-union-recovery',
      subscriberClientName: clientName,
      table: batch.table,
      direction: 'download',
      publisherServer: '',
      publisherDatabase: sync_job_text(agent.database),
      publisherUseWindowsAuth: agent.replicationUseWindowsAuth == true,
      publisherUser: '',
      publisherPassword: '',
      status: 'queued',
      progress: 0,
      rowCount: 0,
      snapshotBytes: 0,
      snapshotCreatedAt: null,
      snapshotId: null,
      createdAt,
      updatedAt: createdAt,
      startedAt: null,
      completedAt: null,
      message: string.concat('Queued retained full-union recovery for ', string.from(batch.table), '.'),
      error: null,
      clientUserId: agent.clientUserId,
      ownerUserId,
      batchId: recoveryBatchId,
      protocolVersion: batch.protocolVersion,
      syncEpoch: batch.syncEpoch
    }]);
  }
  const createdJobs = db.insertMany(SyncJob, rows);
  return raw_json_success({
    mode: 'protocol-v4-retained-full-union-recovery',
    batchId: normalizedBatchId,
    recoveryBatchId,
    sourceClientName: normalizedSourceClientName,
    table: batch.table,
    clientNames: targetAgents.map((agent) => string.from(agent.clientName)),
    jobs: createdJobs.map((job) => public_job_payload(job))
  }, 201);
}

// Stopped-sync table issues are stored without a client name. When a table
// decision endpoint is called without one, resolve the owner scope from the
// table alone: the one visible owner that currently has a needs_input issue
// for it. Returns null when no visible owner - or more than one - has such an
// issue, in which case the caller must pass an explicit client name.
function owner_scope_for_table_decision(current: map<json>, table: string): string? {
  const normalizedTable = table.trim();
  if (normalizedTable.length == 0) {
    return null;
  }
  let ownerIds = [];
  for (const agent of visible_agent_rows_for(current)) {
    const ownerId = string.from(agent.ownerUserId).trim();
    if (ownerId.length != 0 && !string_array_contains(ownerIds, ownerId)) {
      ownerIds = ownerIds.concat([ownerId]);
    }
  }
  let match = null;
  for (const ownerId of ownerIds) {
    const issue = sync_table_issue_for_owner(ownerId, normalizedTable);
    if (issue != null &&
        string.from(issue.status ?? '').trim() == 'needs_input') {
      if (match != null) {
        return null;
      }
      match = ownerId;
    }
  }
  return match;
}

function table_comparison_request(clientName: string, table: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const trimmedClientName = string.from(clientName).trim();
  const normalizedTable = table.trim();
  if (normalizedTable.length == 0) {
    return raw_json_error(400, 'table is required');
  }
  const visibleAgents = visible_agent_rows_for(current);
  let ownerId = '';
  if (trimmedClientName.length != 0) {
    const pageAgent = find_agent_row_by_name(
      visibleAgents,
      normalize_user_name(trimmedClientName)
    );
    if (pageAgent == null) {
      return raw_json_error(403, 'client is unavailable or outside your scope');
    }
    ownerId = string.from(pageAgent.ownerUserId);
  } else {
    // The stopped-sync resolver opens comparison straight from the issue,
    // which carries no client name. Scope it by the table's pending decision.
    const scopedOwnerId = owner_scope_for_table_decision(current, normalizedTable);
    if (scopedOwnerId == null) {
      return raw_json_error(
        403,
        'no matching table decision was found in your scope'
      );
    }
    ownerId = string.from(scopedOwnerId);
  }
  const existingIssue = sync_table_issue_for_owner(ownerId, normalizedTable);
  if (existingIssue == null ||
      string.from(existingIssue.status ?? '').trim() != 'needs_input') {
    return raw_json_error(409, 'this table does not currently need a user decision');
  }

  const ownerPolicies = list_table_sync_policies_for_scope(ownerId);
  let participants = [];
  let skippedOfflineClients = [];
  for (const agent of visibleAgents) {
    if (string.from(agent.ownerUserId) != ownerId || !agent_sync_enabled(agent)) {
      continue;
    }
    const enabledTables = unique_string_values(
      enabled_sync_tables_for_agent_with_policies(agent, ownerPolicies).concat(
        enabled_sync_policy_tables_for_agent(agent, ownerPolicies)
      )
    );
    if (!string_array_contains(enabledTables, normalizedTable)) {
      continue;
    }
    // Compare only clients that are reachable right now. An offline client is
    // skipped rather than blocking the whole comparison; its snapshot simply
    // does not appear in the diff. The caller is told which clients were left
    // out via skippedOfflineClients.
    if (!effective_agent_online(agent)) {
      skippedOfflineClients = skippedOfflineClients.concat([string.from(agent.clientName)]);
      continue;
    }
    participants = participants.concat([agent]);
  }
  if (participants.length < 2) {
    return raw_json_error(409, 'row comparison requires at least two online enabled clients');
  }
  for (const participant of participants) {
    if (string_array_contains(
      active_job_tables_for_client(string.from(participant.clientName)),
      normalizedTable
    )) {
      return raw_json_error(409, string.concat(
        'comparison participant already has active work for this table: ',
        string.from(participant.clientName)
      ));
    }
  }
  const jobs = create_table_comparison_batch(ownerId, normalizedTable, participants);
  if (jobs.length != participants.length) {
    return raw_json_error(500, 'the row comparison request could not be queued');
  }
  return raw_json_success({
    requestId: string.from(jobs[0].batchId),
    table: normalizedTable,
    clientNames: participants.map((agent) => string.from(agent.clientName)),
    skippedOfflineClients: skippedOfflineClients,
    jobs: jobs.map((job) => public_job_payload(job))
  }, 201);
}

function table_comparison_status(requestId: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedRequestId = requestId.trim();
  // Reuse the public live-state result itself. Calling its internal job helper
  // from a second function can receive a different runtime-scoped model view,
  // while live_state(token).jobs is the exact authorized page shown to this
  // user on the clients screen.
  const visibleState = live_state(token);
  let jobs = [];
  for (const candidate of visibleState.jobs) {
    if (string.from(candidate.batchId ?? '').trim() == normalizedRequestId &&
        string.from(candidate.sourceClientName ?? '').trim() == 'server-diff-preview' &&
        string.from(candidate.direction ?? '').trim() == 'upload') {
      jobs = jobs.concat([candidate]);
    }
  }
  if (jobs.length == 0) {
    return raw_json_error(403, 'row comparison request is outside your scope');
  }
  // An administrator can inspect an owner's jobs while the runtime's scoped
  // model lookup can hide the owner-owned batch row. Retain the comparison
  // schema with every archived upload chunk so the read-only result remains
  // available to the same authorized operator after both uploads complete.
  const batch = find_sync_batch(normalizedRequestId);
  let responseTable = string.from(jobs[0].table);
  let responseClientNames = jobs.map((job) => string.from(job.clientName));
  let responseUploadedClientNames = [];
  let responseKeyColumns = [];
  let responseColumns = [];
  if (batch != null) {
    responseTable = string.from(batch.table);
    responseClientNames = batch.expectedClients;
    responseUploadedClientNames = batch.uploadedClients;
    responseKeyColumns = batch.keyColumns;
    responseColumns = batch.columns;
  } else {
    const comparisonChunks = db.selectMany(SyncJobDataChunk, {
      where: { batchId: normalizedRequestId },
      orderBy: { field: 'createdAt', dir: 'asc' },
      fields: ['keyColumns', 'columns'],
      limit: 100
    });
    for (const chunk of comparisonChunks) {
      if (responseKeyColumns.length == 0 && chunk.keyColumns != null) {
        responseKeyColumns = chunk.keyColumns;
      }
      if (responseColumns.length == 0 && chunk.columns.length != 0) {
        responseColumns = chunk.columns;
      }
    }
  }
  let complete = true;
  let failed = false;
  for (const job of jobs) {
    const status = string.from(job.status).trim().toLowerCase();
    if (status == 'completed') {
      responseUploadedClientNames = unique_string_values(
        responseUploadedClientNames.concat([string.from(job.clientName)])
      );
    }
    if (status == 'failed' || status == 'cancelled') {
      failed = true;
    }
    if (status != 'completed') {
      complete = false;
    }
  }
  return raw_json_success({
    requestId: normalizedRequestId,
    table: responseTable,
    clientNames: responseClientNames,
    uploadedClientNames: responseUploadedClientNames,
    keyColumns: responseKeyColumns,
    columns: responseColumns,
    complete,
    failed,
    jobs
  });
}

function table_sync_issue_resolve(clientName: string, table: string, action: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const trimmedClientName = string.from(clientName).trim();
  const normalizedTable = table.trim();
  const normalizedAction = action.trim().toLowerCase();
  if (normalizedTable.length == 0) {
    return raw_json_error(400, 'table is required');
  }
  if (normalizedAction != 'retry_sync' &&
      normalizedAction != 'exclude_table' &&
      normalizedAction != 'accept_baseline') {
    return raw_json_error(400, 'unsupported table resolution action');
  }

  const visibleAgents = visible_agent_rows_for(current);
  let ownerId = '';
  let resolvedClientName = '';
  if (trimmedClientName.length != 0) {
    resolvedClientName = normalize_user_name(trimmedClientName);
    const pageAgent = find_agent_row_by_name(visibleAgents, resolvedClientName);
    if (pageAgent == null) {
      return raw_json_error(403, 'client is unavailable or outside your scope');
    }
    ownerId = string.from(pageAgent.ownerUserId);
  } else {
    // The stopped-sync resolver acts straight from the issue, which carries
    // no client name. Scope it by the table's pending decision instead.
    const scopedOwnerId = owner_scope_for_table_decision(current, normalizedTable);
    if (scopedOwnerId == null) {
      return raw_json_error(
        403,
        'no matching table decision was found in your scope'
      );
    }
    ownerId = string.from(scopedOwnerId);
  }
  const existingIssue = sync_table_issue_for_owner(ownerId, normalizedTable);
  if (existingIssue == null ||
      string.from(existingIssue.status ?? '').trim() != 'needs_input') {
    return raw_json_error(409, 'this table does not currently need a user decision');
  }

  if (normalizedAction == 'exclude_table') {
    upsert_table_sync_policy(ownerId, normalizedTable, false, resolvedClientName);
    const resolved = replace_sync_table_issue(ownerId, {
      table: normalizedTable,
      status: 'ready',
      reason: '',
      message: 'Excluded from synchronization. Local data is left unchanged on every client.',
      clientName: resolvedClientName,
      action: normalizedAction,
      sourceClientName: '',
      targetClientNames: [],
      detectedAt: existingIssue.detectedAt,
      updatedAt: now_iso(),
      resolvedAt: now_iso()
    });
    return raw_json_success({ ok: true, issue: resolved, jobs: [] });
  }

  if (normalizedAction == 'accept_baseline') {
    const resolved = replace_sync_table_issue(ownerId, {
      table: normalizedTable,
      status: 'ready',
      reason: '',
      message: 'Current differences were accepted. Only future Change Tracking changes will synchronize.',
      clientName: resolvedClientName,
      action: normalizedAction,
      sourceClientName: '',
      targetClientNames: [],
      detectedAt: existingIssue.detectedAt,
      updatedAt: now_iso(),
      resolvedAt: now_iso()
    });
    return raw_json_success({ ok: true, issue: resolved, jobs: [] });
  }

  const resolved = replace_sync_table_issue(ownerId, {
    table: normalizedTable,
    status: 'ready',
    reason: '',
    message: string.from(existingIssue.reason).trim() == 'unique_business_key'
      ? 'Conflict acknowledged after an explicit local deletion. Start sync to relay its Change Tracking tombstone and retry atomically.'
      : 'Issue acknowledged. Start sync to retry with primary-key union and explicit tombstones only.',
    clientName: resolvedClientName,
    action: normalizedAction,
    sourceClientName: '',
    targetClientNames: [],
    detectedAt: existingIssue.detectedAt,
    updatedAt: now_iso(),
    resolvedAt: now_iso()
  });
  return raw_json_success({ ok: true, issue: resolved, jobs: [] });
}

function sync_job_status_is_terminal(status: string): bool {
  const normalizedStatus = status.trim().toLowerCase();
  return normalizedStatus == 'completed' || normalizedStatus == 'failed' || normalizedStatus == 'cancelled';
}

function jobs_start(jobId: string, status: string = 'running', progress: int? = null, message: string = 'Started sync.', token: string? = null): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_start', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return { job: public_job_payload(job) };
  }

  let nextProgress = 5;
  if (progress != null) {
    nextProgress = progress;
  }
  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status,
    progress: nextProgress,
    rowCount: job.rowCount,
    snapshotBytes: job.snapshotBytes,
    snapshotCreatedAt: job.snapshotCreatedAt,
    snapshotId: job.snapshotId,
    createdAt: job.createdAt,
    message,
    startedAt: now_iso(),
    completedAt: null,
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  return { job: public_job_payload(nextJob) };
}

function jobs_progress(jobId: string, status: string = 'running', progress: int, message: string, rowCount: int, token: string? = null): map<json> {
  const current = current_user_record(token);
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current, job)) {
    return deny_job_access('jobs_progress', token, current, job);
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return { job: public_job_payload(job) };
  }

  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    status,
    progress,
    message,
    rowCount,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    snapshotBytes: job.snapshotBytes,
    snapshotCreatedAt: job.snapshotCreatedAt,
    snapshotId: job.snapshotId,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt: null,
    error: null,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: now_iso()
  });
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  return { job: public_job_payload(nextJob) };
}

function jobs_complete(jobId: string, status: string = 'completed', progress: int = 100, message: string = 'Completed sync.', rowCount: int = 0, snapshotId: string? = null, snapshotCreatedAt: string? = null, snapshotBytes: int? = null, rejectedRowCount: int? = null, rejectionSummary: string? = null, token: string? = null, conflictKind: string = ''): map<json> {
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current_user_record(token), job)) {
    return raw_json_error(403, 'permission denied');
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return { job: public_job_payload(job) };
  }

  const completedAt = now_iso();
  let nextSnapshotId = job.snapshotId;
  if (snapshotId != null && snapshotId.trim().length != 0) {
    nextSnapshotId = snapshotId.trim();
  }
  let nextSnapshotCreatedAt = job.snapshotCreatedAt;
  if (snapshotCreatedAt != null && snapshotCreatedAt.trim().length != 0) {
    nextSnapshotCreatedAt = snapshotCreatedAt.trim();
  }
  let nextSnapshotBytes = job.snapshotBytes;
  if (snapshotBytes != null && snapshotBytes >= 0) {
    nextSnapshotBytes = snapshotBytes;
  }
  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status,
    progress,
    rowCount,
    snapshotBytes: nextSnapshotBytes,
    snapshotCreatedAt: nextSnapshotCreatedAt,
    snapshotId: nextSnapshotId,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt,
    message,
    error: null,
    rejectedRowCount,
    rejectionSummary,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: completedAt
  });
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  if (status.trim().toLowerCase() == 'failed' ||
      (rejectedRowCount != null && rejectedRowCount > 0)) {
    const failedBatchId = string.from(job.batchId ?? '').trim();
    if (failedBatchId.length != 0) {
      const activeBatchJobs = db.selectMany(SyncJob, {
        where: {
          batchId: failedBatchId,
          status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
        },
        orderBy: { field: 'createdAt', dir: 'asc' },
        fields: ['id'],
        limit: 1000
      });
      const activeBatchJobIds = activeBatchJobs.map((batchJob) => string.from(batchJob.id));
      if (activeBatchJobIds.length != 0) {
        db.updateMany(SyncJob, { id: { in: activeBatchJobIds } }, {
          status: 'failed',
          progress: 100,
          completedAt,
          error: string.concat('Atomic batch failed: ', message),
          message: string.concat('Atomic batch failed: ', message),
          updatedAt: completedAt
        });
      }
    }
    let issueMessage = message;
    if (rejectionSummary != null && rejectionSummary.trim().length != 0) {
      issueMessage = rejectionSummary;
    }
    raise_sync_table_issue(
      job.ownerUserId,
      string.from(job.table),
      conflictKind.trim().toLowerCase() == 'unique_business_key'
        ? 'unique_business_key'
        : rejectedRowCount != null && rejectedRowCount > 0
          ? 'rejected_rows'
          : 'sync_failed',
      issueMessage,
      string.from(job.clientName)
    );
    if (failedBatchId.length != 0) {
      cleanup_multi_writer_batch_storage(failedBatchId);
    }
  }
  const completedBatchId = string.from(job.batchId ?? '').trim();
  if (status.trim().toLowerCase() == 'completed' &&
      string.from(job.direction).trim() == 'download' &&
      (string.from(job.sourceClientName).trim() == 'server-merge' ||
       string.from(job.sourceClientName).trim() == 'server-partial-merge' ||
       sync_source_is_union_bootstrap(string.from(job.sourceClientName))) &&
      completedBatchId.length != 0 &&
      sync_batch_all_jobs_completed(completedBatchId)) {
    // A partial batch proves only its participating clients caught up. Clear
    // their debt while retaining debt for peers that are still offline; this
    // prevents a returned client from being rescheduled every cron minute.
    const clearedDebtCount = clear_offline_sync_debt_for_clients(
      string.from(job.ownerUserId),
      string.from(job.table),
      sync_batch_client_names(completedBatchId)
    );
    if (clearedDebtCount > 0) {
      log.info('offline client catch-up completed', {
        ownerUserId: job.ownerUserId,
        table: job.table,
        batchId: completedBatchId,
        clearedDebtCount
      });
    }
  }
  if (status.trim().toLowerCase() == 'completed' &&
      string.from(job.sourceClientName).trim() == 'server-authoritative-reconcile' &&
      completedBatchId.length != 0 &&
      sync_batch_all_jobs_completed(completedBatchId)) {
    // This also handles an idempotent repair whose fingerprint was already
    // equal before the target heartbeat, so no table-state heartbeat change
    // is required to release a stale Needs input gate.
    refresh_owner_baseline_table_issues(string.from(job.ownerUserId));
  }
  if (status.trim().toLowerCase() == 'completed' &&
      string.from(job.direction).trim() == 'download' &&
      completedBatchId.length != 0 &&
      sync_batch_all_jobs_completed(completedBatchId)) {
    resolve_automatic_number_batch_incidents(
      string.from(job.ownerUserId),
      string.from(job.table),
      completedBatchId,
      completedAt
    );
    if (sync_batch_automatic_retry_kind(completedBatchId) == 'automatic-number-inventory') {
      queue_automatic_number_delta_retry(
        string.from(job.ownerUserId),
        string.from(job.table)
      );
    }
  }
  record_periodic_sync_table_attempt(job.ownerUserId, string.from(job.table));
  if (completedBatchId.length != 0 && sync_batch_all_jobs_completed(completedBatchId)) {
    const remainingManualTables = manual_sync_pending_tables_for_owner(string.from(job.ownerUserId));
    if (remainingManualTables.length > 0) {
      if (claim_periodic_sync_scheduler_for_owner(string.from(job.ownerUserId), true)) {
        queue_due_periodic_sync_jobs_for_owner(string.from(job.ownerUserId));
      }
    } else if (active_job_tables_for_owner(string.from(job.ownerUserId)).length == 0) {
      finish_manual_sync_operation(string.from(job.ownerUserId), 'completed', completedAt);
    }
  }
  return { job: public_job_payload(nextJob) };
}

function jobs_fail(jobId: string, message: string, progress: int? = null, token: string? = null, failureKind: string = ''): map<json> {
  const job = find_job_by_id(jobId);
  if (job == null) {
    return raw_json_error(404, 'job not found');
  }
  if (!can_access_job(current_user_record(token), job)) {
    return raw_json_error(403, 'permission denied');
  }
  if (sync_job_status_is_terminal(string.from(job.status))) {
    return { job: public_job_payload(job) };
  }
  let nextProgress = job.progress;
  if (progress != null) {
    nextProgress = progress;
  }
  const baselineReplan = failureKind.trim().toLowerCase() == 'baseline_required';
  db.delete(UploadSession, { jobId });
  db.delete(DownloadSession, { jobId });
  const completedAt = now_iso();
  let failureError = null;
  let batchFailureError = null;
  if (!baselineReplan) {
    failureError = message;
    batchFailureError = string.concat('Atomic batch failed: ', message);
  }
  const updated = db.update(SyncJob, { id: jobId }, {
    clientName: job.clientName,
    sourceClientName: job.sourceClientName,
    subscriberClientName: job.subscriberClientName,
    table: job.table,
    direction: job.direction,
    publisherServer: job.publisherServer,
    publisherDatabase: job.publisherDatabase,
    publisherUseWindowsAuth: job.publisherUseWindowsAuth,
    publisherUser: job.publisherUser,
    publisherPassword: job.publisherPassword,
    status: baselineReplan ? 'cancelled' : 'failed',
    progress: nextProgress,
    rowCount: job.rowCount,
    snapshotBytes: job.snapshotBytes,
    snapshotCreatedAt: job.snapshotCreatedAt,
    snapshotId: job.snapshotId,
    createdAt: job.createdAt,
    startedAt: job.startedAt,
    completedAt,
    error: failureError,
    message: baselineReplan
      ? 'Delta cancelled safely because its Change Tracking cursor was unavailable; queued for an all-client baseline replan.'
      : message,
    clientUserId: job.clientUserId,
    ownerUserId: job.ownerUserId,
    updatedAt: completedAt
  });
  const failedBatchId = string.from(job.batchId ?? '').trim();
  const automaticNumberCollision = failedBatchId.length != 0 &&
    automatic_number_allocation_collision(message, failedBatchId);
  if (automaticNumberCollision) {
    invalidate_automatic_number_batch_reservations(
      string.from(job.ownerUserId),
      string.from(job.table),
      failedBatchId,
      completedAt
    );
  }
  if (failedBatchId.length != 0) {
    const activeBatchJobs = db.selectMany(SyncJob, {
      where: {
        batchId: failedBatchId,
        status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
      },
      orderBy: { field: 'createdAt', dir: 'asc' },
      fields: ['id'],
      limit: 1000
    });
    const activeBatchJobIds = activeBatchJobs.map((batchJob) => string.from(batchJob.id));
    if (activeBatchJobIds.length != 0) {
      db.updateMany(SyncJob, { id: { in: activeBatchJobIds } }, {
        status: baselineReplan ? 'cancelled' : 'failed',
        progress: 100,
        completedAt,
        error: batchFailureError,
        message: baselineReplan
          ? 'Atomic delta batch cancelled safely and queued for an all-client baseline replan.'
          : string.concat('Atomic batch failed: ', message),
        updatedAt: completedAt
      });
    }
    cleanup_multi_writer_batch_storage(failedBatchId);
    if (automaticNumberCollision &&
        string.from(job.automaticRetryKind ?? '').trim() != 'automatic-number-retry') {
      queue_automatic_number_inventory_recovery(
        string.from(job.ownerUserId),
        string.from(job.table)
      );
    }
  } else if (string.from(job.direction).trim() == 'upload') {
    const targetJob = find_waiting_download_job(string.from(job.clientName), string.from(job.subscriberClientName), string.from(job.table));
    if (targetJob != null) {
      db.delete(DownloadSession, { jobId: targetJob.id });
      db.update(SyncJob, { id: targetJob.id }, {
        clientName: targetJob.clientName,
        sourceClientName: targetJob.sourceClientName,
        subscriberClientName: targetJob.subscriberClientName,
        table: targetJob.table,
        direction: targetJob.direction,
        publisherServer: targetJob.publisherServer,
        publisherDatabase: targetJob.publisherDatabase,
        publisherUseWindowsAuth: targetJob.publisherUseWindowsAuth,
        publisherUser: targetJob.publisherUser,
        publisherPassword: targetJob.publisherPassword,
        status: 'failed',
        progress: 100,
        rowCount: targetJob.rowCount,
        snapshotBytes: targetJob.snapshotBytes,
        snapshotCreatedAt: targetJob.snapshotCreatedAt,
        snapshotId: targetJob.snapshotId,
        createdAt: targetJob.createdAt,
        startedAt: targetJob.startedAt,
        completedAt,
        error: string.concat('Source upload failed: ', message),
        message: string.concat('Source upload failed: ', message),
        clientUserId: targetJob.clientUserId,
        ownerUserId: targetJob.ownerUserId,
        updatedAt: completedAt
      });
    }
  }
  let nextJob = job;
  if (updated != null) {
    nextJob = updated;
  }
  if (baselineReplan) {
    mark_agent_table_baseline_pending(
      string.from(job.clientName),
      string.from(job.table),
      message
    );
    const pendingTables = manual_sync_pending_tables_for_owner(
      string.from(job.ownerUserId)
    );
    set_manual_sync_pending_tables_for_owner(
      string.from(job.ownerUserId),
      unique_string_values(pendingTables.concat([string.from(job.table)]))
    );
  }
  // Unexpected transport/runtime failures are safe to retry because the
  // client applies a complete table delta in one SQL transaction and only
  // advances its Change Tracking checkpoint after commit. Data conflicts are
  // reported through jobs_complete with a conflict kind and still pause for
  // an explicit user decision.
  record_periodic_sync_table_attempt(job.ownerUserId, string.from(job.table));
  return { job: public_job_payload(nextJob) };
}

function jobs_cancel_active(clientNames: array<string>? = null, message: string = 'Cancelled active sync jobs.', token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }

  let targetNames = [];
  if (clientNames != null) {
    for (const clientName of clientNames) {
      const normalized = normalize_user_name(clientName);
      if (normalized.length != 0) {
        targetNames = targetNames.concat([normalized]);
      }
    }
  }
  targetNames = unique_string_values(targetNames);

  // A manual Sync All queue is one durable operation that drains in bounded
  // batches. Cancelling its active jobs must also cancel the unstarted tail,
  // including the brief gap between batches when no active job exists.
  let cancelledOwnerUserIds = [];
  for (const agent of visible_agent_rows_for(current)) {
    const agentClientName = normalize_user_name(agent.clientName);
    if (targetNames.length != 0 &&
        !string_array_contains(targetNames, agentClientName)) {
      continue;
    }
    const ownerUserId = string.from(agent.ownerUserId ?? '').trim();
    if (ownerUserId.length != 0 &&
        !string_array_contains(cancelledOwnerUserIds, ownerUserId)) {
      cancelledOwnerUserIds = cancelledOwnerUserIds.concat([ownerUserId]);
    }
  }

  let cancelledJobs = [];
  let cancelledJobIds = [];
  let cancelledBatchIds = [];
  const completedAt = now_iso();
  for (const job of visible_job_rows_for(current)) {
    const status = string.from(job.status).trim();
    if (!is_active_job_status(status)) {
      continue;
    }
    const jobClientName = normalize_user_name(job.clientName);
    if (targetNames.length != 0 && !string_array_contains(targetNames, jobClientName)) {
      continue;
    }
    cancelledJobIds = cancelledJobIds.concat([job.id]);
    const batchId = string.from(job.batchId ?? '').trim();
    if (batchId.length != 0 && !string_array_contains(cancelledBatchIds, batchId)) {
      cancelledBatchIds = cancelledBatchIds.concat([batchId]);
    }
    cancelledJobs = cancelledJobs.concat([public_job_payload({
      id: job.id,
      clientName: job.clientName,
      sourceClientName: job.sourceClientName,
      subscriberClientName: job.subscriberClientName,
      table: job.table,
      direction: job.direction,
      publisherServer: job.publisherServer,
      publisherDatabase: job.publisherDatabase,
      publisherUseWindowsAuth: job.publisherUseWindowsAuth,
      status: 'cancelled',
      progress: 100,
      rowCount: job.rowCount,
      snapshotBytes: job.snapshotBytes,
      snapshotCreatedAt: job.snapshotCreatedAt,
      snapshotId: job.snapshotId,
      createdAt: job.createdAt,
      updatedAt: completedAt,
      startedAt: job.startedAt,
      completedAt,
      message,
      error: message,
      clientUserId: job.clientUserId,
      ownerUserId: job.ownerUserId
    })]);
  }

  if (cancelledJobIds.length != 0) {
    db.updateMany(SyncJob, { id: { in: cancelledJobIds } }, {
      status: 'cancelled',
      progress: 100,
      completedAt,
      message,
      error: message,
      updatedAt: completedAt
    });
  }
  if (cancelledBatchIds.length != 0) {
    // Staged rows are disposable relay data. Remove them with the cancelled
    // batches so failed large syncs cannot consume memory on later startups.
    cleanup_multi_writer_batches_storage(cancelledBatchIds);
  }
  for (const ownerUserId of cancelledOwnerUserIds) {
    set_manual_sync_pending_tables_for_owner(ownerUserId, []);
    finish_manual_sync_operation(ownerUserId, 'cancelled', completedAt);
  }

  return {
    ok: true,
    cancelledJobCount: cancelledJobs.length,
    clearedManualQueueOwnerCount: cancelledOwnerUserIds.length,
    jobs: cancelledJobs
  };
}

function cleanup_multi_writer_batches_storage(batchIds: array<string>): int {
  let normalizedBatchIds = [];
  for (const batchId of batchIds) {
    const normalizedBatchId = batchId.trim();
    if (normalizedBatchId.length != 0 &&
        !string_array_contains(normalizedBatchIds, normalizedBatchId)) {
      normalizedBatchIds = normalizedBatchIds.concat([normalizedBatchId]);
    }
  }
  if (normalizedBatchIds.length == 0) {
    return 0;
  }
  const chunks = db.selectMany(SnapshotRecord, {
    where: { sourceJobId: { in: normalizedBatchIds } },
    orderBy: { field: 'createdAt', dir: 'asc' },
    fields: ['storageId'],
    limit: 1000
  });
  let storageIds = [];
  for (const chunk of chunks) {
    const storageId = string.from(chunk.storageId ?? '').trim();
    if (storageId.length != 0 && !string_array_contains(storageIds, storageId)) {
      storageIds = storageIds.concat([storageId]);
    }
  }
  let archivedStorageIds = [];
  if (storageIds.length != 0) {
    archivedStorageIds = db.selectMany(SyncJobDataChunk, {
      where: { storageId: { in: storageIds } },
      orderBy: { field: 'createdAt', dir: 'asc' },
      fields: ['storageId'],
      limit: 1000
    }).map((chunk) => string.from(chunk.storageId ?? '').trim());
  }
  for (const storageId of storageIds) {
    if (!string_array_contains(archivedStorageIds, storageId)) {
      storage.delete(storageId);
    }
  }
  return db.deleteMany(SnapshotRecord, { sourceJobId: { in: normalizedBatchIds } });
}

function cleanup_multi_writer_batch_storage(batchId: string): int {
  return cleanup_multi_writer_batches_storage([batchId]);
}

function jobs_cleanup_multi_writer_batch(batchId: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null || !is_admin_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedBatchId = batchId.trim();
  if (normalizedBatchId.length == 0) {
    return raw_json_error(400, 'batchId is required');
  }
  const deletedCount = cleanup_multi_writer_batch_storage(normalizedBatchId);
  return raw_json_success({ ok: true, batchId: normalizedBatchId, deletedCount });
}
