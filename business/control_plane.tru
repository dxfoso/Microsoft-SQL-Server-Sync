function live_state_client_activity_rows_for(current: map<json>): array<json> {
  let where = {
    status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
  };
  if (is_client_user(current)) {
    where = {
      clientUserId: current.id,
      status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
    };
  }
  if (is_owner_user(current)) {
    where = {
      ownerUserId: current.id,
      status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
    };
  }
  const rows = db.selectMany(SyncJob, {
    where,
    orderBy: { field: 'updatedAt', dir: 'desc' },
    fields: ['id', 'clientName', 'table', 'direction', 'status', 'message', 'batchId', 'updatedAt'],
    limit: 250
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function live_state_active_job_rows_for(current: map<json>): array<json> {
  let where = {
    status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
  };
  if (is_client_user(current)) {
    where = {
      clientUserId: current.id,
      status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
    };
  }
  if (is_owner_user(current)) {
    where = {
      ownerUserId: current.id,
      status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
    };
  }
  const rows = db.selectMany(SyncJob, {
    where,
    orderBy: { field: 'updatedAt', dir: 'desc' },
    fields: ['id', 'clientName', 'sourceClientName', 'subscriberClientName', 'table', 'direction', 'publisherServer', 'publisherDatabase', 'publisherUseWindowsAuth', 'status', 'progress', 'rowCount', 'snapshotBytes', 'snapshotCreatedAt', 'snapshotId', 'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'message', 'error', 'rejectedRowCount', 'rejectionSummary', 'clientUserId', 'ownerUserId', 'batchId', 'protocolVersion', 'syncEpoch'],
    limit: 1000
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function list_scheduler_agent_owner_rows(): array<json> {
  const rows = db.selectMany(Agent, {
    where: { clientName: { gte: '' } },
    orderBy: { field: 'ownerUserId', dir: 'asc' },
    fields: ['ownerUserId'],
    limit: 1000
  });
