      windowActionRequestedAt: null,
      windowActionRequestedByUserId: null,
      windowActionName: '',
      windowActionLastRequestId: null,
      windowActionLastAcknowledgedAt: null,
      windowActionStatus: 'idle',
      windowActionMessage: '',
      dataExportRequestId: null,
      dataExportRequestedAt: null,
      dataExportRequestedByUserId: null,
      dataExportDatabase: null,
      dataExportUploadUrl: null,
      dataExportUploadToken: null,
      dataExportLastRequestId: null,
      dataExportLastAcknowledgedAt: null,
      dataExportStatus: 'idle',
      dataExportMessage: '',
      dataExportBytes: 0,
      dataExportSha256: '',
      dataExportChunkCount: 0,
      clientVersion: '',
      clientUserId,
