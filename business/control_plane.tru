version 0.3

class User {
  field id: string min=1 max=64
  field username: string min=1 max=128
  field email: string min=0 max=254
  field name: string min=1 max=128
  field role: string min=1 max=32
  field ownerUserId: string? min=0 max=64
  field createdByUserId: string? min=0 max=64
  field password: string min=1 max=256
  field createdAt: datetime
}

class Session {
  field id: string min=1 max=64
  field token: string min=1 max=128
  field userId: string min=1 max=64
  field userUsername: string? min=0 max=128
  field userEmail: string? min=0 max=254
  field userName: string? min=0 max=128
  field userRole: string? min=0 max=32
  field userOwnerUserId: string? min=0 max=64
  field userCreatedByUserId: string? min=0 max=64
  field userCreatedAt: datetime?
  field app: string min=1 max=32
  field createdAt: datetime
  field revokedAt: datetime?
}

class Agent {
  history minimal
  field clientName: string min=1 max=128
  field machineName: string min=0 max=128
  field server: string min=0 max=256
  field database: string min=0 max=256
  field replicationUseWindowsAuth: bool?
  field replicationUser: string? min=0 max=256
  field replicationPassword: string? min=0 max=256
  field syncEnabled: bool?
  field isOnline: bool
  field historyLimit: int min=1 max=100
  field autoSyncIntervalMinutes: int min=1 max=1440
  field syncDataLimitMb: int? min=1 max=1024
  field conflictPolicy: string? min=0 max=32
  field serverConnected: bool
  field sqlConnected: bool
  field clientVersion: string? min=0 max=32
  field lastHeartbeat: string min=0 max=64
  field selectedTable: string? min=0 max=256
  field tables: array<json>
  field tableRelationships: array<json>
  field fingerprintAudit: array<json>?
  field diagnosticRequestId: string? min=0 max=64
  field diagnosticRequestedAt: datetime?
  field diagnosticRequestedByUserId: string? min=0 max=64
  field diagnosticLastRequestId: string? min=0 max=64
  field diagnosticLastUploadedAt: datetime?
  field diagnosticStatus: string min=0 max=32
  field diagnosticStage: string? min=0 max=64
  field diagnosticProgressPercent: int? min=0 max=100
  field diagnosticStartedAt: datetime?
  field diagnosticCompletedAt: datetime?
  field diagnosticSummary: string min=0 max=4000
  field diagnosticPayload: string min=0 max=64000
  field clientUpdateRequestId: string? min=0 max=64
  field clientUpdateRequestedAt: datetime?
  field clientUpdateRequestedByUserId: string? min=0 max=64
  field clientUpdateTargetVersion: string? min=0 max=32
  field clientUpdateLastRequestId: string? min=0 max=64
  field clientUpdateLastAcknowledgedAt: datetime?
  field clientUpdateStatus: string min=0 max=32
  field clientUpdateMessage: string min=0 max=4000
  field clientUpdateDownloadedBytes: int? min=0
  field clientUpdateTotalBytes: int? min=0
  field clientUpdateProgressPercent: int? min=0 max=100
  field clientUpdateScriptPath: string? min=0 max=1000
  field windowActionRequestId: string? min=0 max=64
  field windowActionRequestedAt: datetime?
  field windowActionRequestedByUserId: string? min=0 max=64
  field windowActionName: string? min=0 max=32
  field windowActionLastRequestId: string? min=0 max=64
  field windowActionLastAcknowledgedAt: datetime?
  field windowActionStatus: string? min=0 max=32
  field windowActionMessage: string? min=0 max=4000
  field dataExportRequestId: string? min=0 max=64
  field dataExportRequestedAt: datetime?
  field dataExportRequestedByUserId: string? min=0 max=64
  field dataExportDatabase: string? min=0 max=256
  field dataExportUploadUrl: string? min=0 max=1000
  field dataExportUploadToken: string? min=0 max=256
  field dataExportLastRequestId: string? min=0 max=64
  field dataExportLastAcknowledgedAt: datetime?
  field dataExportStatus: string? min=0 max=32
  field dataExportMessage: string? min=0 max=4000
  field dataExportBytes: int? min=0 max=1000000000000
  field dataExportSha256: string? min=0 max=64
  field dataExportChunkCount: int? min=0 max=1000000
  field clientUserId: string? min=0 max=64
  field ownerUserId: string? min=0 max=64
  field updatedAt: datetime
}

class TableSyncPolicy {
  field ownerUserId: string min=0 max=64
  field database: string? min=0 max=256
  field table: string min=1 max=256
  field enabled: bool
  field syncMode: string min=1 max=32
  field updatedAt: datetime
  field updatedByClientName: string min=0 max=128
}

class SyncJob {
  field id: string min=1 max=64
  field clientName: string min=1 max=128
  field sourceClientName: string min=0 max=128
  field subscriberClientName: string min=0 max=128
  field table: string min=1 max=256
  field direction: string min=1 max=32
  field publisherServer: string min=0 max=256
  field publisherDatabase: string min=0 max=256
  field publisherUseWindowsAuth: bool
  field publisherUser: string min=0 max=256
  field publisherPassword: string min=0 max=256
  field status: string min=1 max=32
  field progress: int min=0 max=100
  field rowCount: int min=0 max=1000000000
  field snapshotBytes: int min=0 max=1000000000
  field snapshotCreatedAt: datetime?
  field snapshotId: string? min=0 max=128
  field createdAt: datetime
  field updatedAt: datetime
  field startedAt: datetime?
  field completedAt: datetime?
  field message: string min=0 max=4000
  field error: string? min=0 max=4000
  field rejectedRowCount: int? min=0 max=1000000000
  field rejectionSummary: string? min=0 max=4000
  field clientUserId: string? min=0 max=64
  field ownerUserId: string? min=0 max=64
  field batchId: string? min=0 max=128
  // Internal scheduler provenance. A failed full-download repair is allowed
  // exactly one automatic retry; ordinary/manual batches leave this null.
  field automaticRetryKind: string? min=0 max=32
  field protocolVersion: int? min=3 max=4
  field syncEpoch: string? min=0 max=64
}

class SyncBatch {
  field id: string min=1 max=128
  field table: string min=1 max=256
  field revision: int min=0
  field ownerUserId: string? min=0 max=64
  field conflictSourceClient: string? min=0 max=128
  field expectedClients: array<json>
  field uploadedClients: array<json>
  field receivedChunks: array<json>
  field receivedBytes: int min=0 max=2147483647
  field clientChangeTrackingVersions: array<json>
  field keyColumns: array<json>
  field uniqueKeyColumnSets: array<json>?
  field columns: array<json>
  field rows: array<json>
  field status: string min=1 max=32
  field createdAt: datetime
  field updatedAt: datetime
  field protocolVersion: int? min=3 max=4
  field syncEpoch: string? min=0 max=64
}

// Records that a client missed at least one partial online-only batch. The
// participating clients deliberately preserve their Change Tracking cursors,
// so the first later full batch safely carries the complete missed range.
class OfflineSyncDebt {
  field id: string min=1 max=64
  field ownerUserId: string min=0 max=64
  field clientName: string min=1 max=128
  field table: string min=1 max=256
  field createdAt: datetime
  field updatedAt: datetime
}

// One durable row fences every job and cursor to the current reset epoch.
class SyncProtocolState {
  field id: string min=1 max=32
  field protocolVersion: int min=3 max=4
  field syncEpoch: string min=1 max=64
  field updatedAt: datetime
}

class SnapshotRecord {
  field id: string min=1 max=64
  field clientName: string min=1 max=128
  field subscriberClientName: string min=0 max=128
  field table: string min=1 max=256
  field rowCount: int min=0 max=1000000000
  field checksum: string min=1 max=128
  field createdAt: datetime
  field snapshotBytes: int min=0 max=2147483647
  field columns: array<json>
  field rows: array<json>
  field previewRows: array<json>
  field compressedBytes: int min=0 max=2147483647
  field chunkCount: int min=0 max=10000
  field encoding: string min=1 max=16
  field storageId: string min=0 max=128
  field isDelta: bool
  field sourceJobId: string? min=0 max=64
  field clientUserId: string? min=0 max=64
  field ownerUserId: string? min=0 max=64
}

// Durable, bounded audit data for the rows carried by a specific sync job.
// Relay SnapshotRecord rows can be deleted after delivery; these references
// remain until the configured owner storage limit prunes an older whole job.
class SyncJobDataChunk {
  field id: string min=1 max=64
  field jobId: string min=1 max=64
  field batchId: string min=0 max=128
  field clientName: string min=0 max=128
  field table: string min=1 max=256
  field ordinal: int min=0 max=1000000
  field columns: array<json>
  field keyColumns: array<json>?
  field rows: array<json>
  field rowCount: int min=0 max=1000000000
  field snapshotBytes: int min=0 max=2147483647
  field storageId: string min=0 max=128
  field clientUserId: string? min=0 max=64
  field ownerUserId: string? min=0 max=64
  field createdAt: datetime
}

// Durable last-writer-wins register. Unlike batch-local coalescing, this
// survives later sync jobs so an older offline change cannot overwrite a
// newer operation that the server already accepted.
class SyncRowWinner {
  field id: string min=64 max=64
  field ownerUserId: string min=0 max=64
  field table: string min=1 max=256
  field identityKey: string min=64 max=64
  field physicalKey: string min=64 max=64
  field logicalWinnerIds: array<json>?
  field modifiedAtUtc: string min=0 max=64
  field serverReceivedAtUtc: string min=1 max=64
  field serverSequence: string min=1 max=128
  field originClient: string min=1 max=128
  field changeVersion: string min=0 max=40
  field operationId: string min=64 max=64
  field rowHash: string min=0 max=64
  field operation: string min=1 max=1
  field revision: int min=1 max=2147483647
  field updatedAt: datetime
}

// Durable operator-visible record for one server-coordinated automatic
// business-number repair. Retrying the same operation reuses the same id, so
// the counter and the allocated number remain idempotent.
class AutoNumberIncident {
  field id: string min=64 max=64
  field ownerUserId: string min=0 max=64
  field clientName: string min=1 max=128
  field conflictingClientName: string min=1 max=128
  field table: string min=1 max=256
  field status: string min=1 max=32
  field reason: string min=1 max=256
  field numberColumn: string min=1 max=128
  field beforeNumber: string min=1 max=64
  field afterNumber: string min=0 max=64
  field scope: json?
  field primaryKey: json?
  field beforeRow: json?
  field afterRow: json?
  field operationId: string min=64 max=64
  field physicalKey: string min=64 max=64
  field detectedAt: datetime
  field resolvedAt: datetime?
  field updatedAt: datetime
}

// Owner-wide allocator for one validated table/key scope. It becomes usable
// only after a complete multi-client inventory observed the table.
class AutoNumberSequence {
  field id: string min=64 max=64
  field ownerUserId: string min=0 max=64
  field table: string min=1 max=256
  field scopeKey: string min=64 max=64
  field numberColumn: string min=1 max=128
  field scope: json?
  field maximumObserved: int min=0 max=2147483647
  field initialized: bool
  field revision: int min=1 max=2147483647
  field updatedAt: datetime
}

// Unique reservation fence. Concurrent backend workers may observe the same
// maximum, but only one can insert a given scoped number; the losing upload
// transaction rolls back and retries against the advanced sequence.
class AutoNumberReservation {
  field id: string min=64 max=64
  field ownerUserId: string min=0 max=64
  field table: string min=1 max=256
  field scopeKey: string min=64 max=64
  field number: int min=1 max=2147483647
  field incidentId: string min=64 max=64
  field createdAt: datetime
}

class UploadSession {
  history minimal
  field id: string min=1 max=64
  field jobId: string min=1 max=64
  field uploadId: string min=1 max=128
  field table: string min=1 max=256
  field rowCount: int min=0 max=1000000000
  field snapshotCreatedAt: datetime
  field snapshotBytes: int min=0 max=2147483647
  field compressedBytes: int min=0 max=2147483647
  field chunkSizeBytes: int min=1 max=1048576
  field chunkCount: int min=1 max=10000
  field encoding: string min=1 max=16
  field createdAt: datetime
  field updatedAt: datetime
  field chunks: array<json>
}

class DownloadSession {
  history minimal
  field id: string min=1 max=64
  field jobId: string min=1 max=64
  field snapshotId: string min=1 max=64
  field table: string min=1 max=256
  field chunkSizeBytes: int min=1 max=1048576
  field chunkCount: int min=1 max=10000
  field compressedBytes: int min=0 max=2147483647
  field encoding: string min=1 max=16
  field createdAt: datetime
  field updatedAt: datetime
  field chunks: array<json>
}

class PeriodicSyncState {
  field ownerUserId: string min=0 max=64
  field lastCheckedAt: datetime
  field manualPendingTables: array<json>?
  field manualSyncStatus: string? min=0 max=16
  field manualSyncStartedAt: datetime?
  field manualSyncCompletedAt: datetime?
  field manualSyncTableCount: int?
  field scheduledTableAttempts: array<json>?
  field tableIssues: array<json>?
  field updatedAt: datetime
}

index User_id on User(id)
index User_username on User(username)
index User_email on User(email)
index Session_token on Session(token)
index Session_createdAt on Session(createdAt)
index Session_userId_createdAt on Session(userId, createdAt)
index Agent_clientName on Agent(clientName)
index Agent_ownerUserId on Agent(ownerUserId)
index TableSyncPolicy_ownerUserId_table on TableSyncPolicy(ownerUserId, table)
index TableSyncPolicy_ownerUserId_database_table on TableSyncPolicy(ownerUserId, database, table)
index SyncJob_id on SyncJob(id)
index SyncJob_clientName_createdAt on SyncJob(clientName, createdAt)
index SyncJob_createdAt on SyncJob(createdAt)
index SyncJob_batchId on SyncJob(batchId)
index SyncBatch_id on SyncBatch(id)
index SyncBatch_ownerUserId_table on SyncBatch(ownerUserId, table)
index OfflineSyncDebt_ownerUserId_clientName_table on OfflineSyncDebt(ownerUserId, clientName, table)
index SyncProtocolState_id on SyncProtocolState(id)
index SnapshotRecord_id on SnapshotRecord(id)
index SnapshotRecord_clientName_table_createdAt on SnapshotRecord(clientName, table, createdAt)
index SnapshotRecord_createdAt on SnapshotRecord(createdAt)
index SnapshotRecord_sourceJobId_subscriberClientName_createdAt on SnapshotRecord(sourceJobId, subscriberClientName, createdAt)
index SyncJobDataChunk_jobId_ordinal on SyncJobDataChunk(jobId, ordinal)
index SyncJobDataChunk_batchId_createdAt on SyncJobDataChunk(batchId, createdAt)
index SyncJobDataChunk_ownerUserId_createdAt on SyncJobDataChunk(ownerUserId, createdAt)
index SyncRowWinner_ownerUserId_table on SyncRowWinner(ownerUserId, table)
index SyncRowWinner_ownerUserId_table_physicalKey on SyncRowWinner(ownerUserId, table, physicalKey)
index SyncRowWinner_ownerUserId_table_operationId on SyncRowWinner(ownerUserId, table, operationId)
index AutoNumberIncident_ownerUserId_clientName on AutoNumberIncident(ownerUserId, clientName)
index AutoNumberIncident_ownerUserId_table on AutoNumberIncident(ownerUserId, table)
index AutoNumberIncident_operationId on AutoNumberIncident(operationId)
index AutoNumberIncident_ownerUserId_table_physicalKey on AutoNumberIncident(ownerUserId, table, physicalKey)
index AutoNumberSequence_ownerUserId_table on AutoNumberSequence(ownerUserId, table)
index AutoNumberReservation_ownerUserId_table_scopeKey on AutoNumberReservation(ownerUserId, table, scopeKey)
index UploadSession_jobId on UploadSession(jobId)
index UploadSession_uploadId on UploadSession(uploadId)
index DownloadSession_jobId on DownloadSession(jobId)
index DownloadSession_snapshotId on DownloadSession(snapshotId)
index PeriodicSyncState_ownerUserId on PeriodicSyncState(ownerUserId)

function now_iso(): datetime {
  return date.now();
}

function sync_protocol_version(): int {
  return 4;
}

function sync_delete_policy(): string {
  // A delete is valid only as a protocol-v4 Change Tracking tombstone. Full
  // snapshots, unions, comparisons, and row-count differences never imply a
  // delete and may only insert or update rows.
  return 'explicit-tombstones-only';
}

function sync_protocol_state(): map<json> {
  const existing = db.selectOne(SyncProtocolState, { id: 'global' });
  if (existing != null) {
    if (int.from(existing.protocolVersion ?? 0) == sync_protocol_version()) {
      return existing;
    }
    const updatedAt = now_iso();
    db.update(SyncProtocolState, { id: 'global' }, {
      protocolVersion: sync_protocol_version(),
      syncEpoch: existing.syncEpoch,
      updatedAt
    });
    return {
      id: 'global',
      protocolVersion: sync_protocol_version(),
      syncEpoch: existing.syncEpoch,
      updatedAt
    };
  }
  return db.insert(SyncProtocolState, {
    id: 'global',
    protocolVersion: sync_protocol_version(),
    syncEpoch: uuid.v4(),
    updatedAt: now_iso()
  });
}

function rotate_sync_epoch(): map<json> {
  const existing = sync_protocol_state();
  const nextEpoch = uuid.v4();
  db.update(SyncProtocolState, { id: 'global' }, {
    protocolVersion: sync_protocol_version(),
    syncEpoch: nextEpoch,
    updatedAt: now_iso()
  });
  return {
    protocolVersion: sync_protocol_version(),
    syncEpoch: nextEpoch,
    previousSyncEpoch: existing.syncEpoch
  };
}

function raw_json_error(status: int, message: string): json {
  return response.raw({
    status: status,
    content_type: "application/json",
    body: json.stringify({ error: message })
  });
}

function raw_json_success(payload: map<json>, status: int = 200): json {
  return response.raw({
    status: status,
    content_type: "application/json",
    body: json.stringify(payload)
  });
}

function is_admin_user(user: map<json>): bool {
  return user.role == "admin";
}

function is_owner_user(user: map<json>): bool {
  return user.role == "owner";
}

function is_client_user(user: map<json>): bool {
  return user.role == "client";
}

function can_read_agent(current: map<json>? = null, ownerUserId: string? = null, createdByUserId: string? = null): bool {
  if (current == null) {
    return false;
  }
  if (is_admin_user(current)) {
    return true;
  }
  if (current.id == createdByUserId) {
    return true;
  }
  if (is_owner_user(current) && ownerUserId == current.id) {
    return true;
  }
  return false;
}

function can_manage_user(current: map<json>? = null, target: map<json>? = null): bool {
  if (current == null) {
    return false;
  }
  if (is_admin_user(current)) {
    return true;
  }
  if (target == null) {
    return false;
  }
  if (current.id == target.id) {
    return true;
  }
  if (is_owner_user(current) && target.ownerUserId == current.id) {
    return true;
  }
  return false;
}

function owner_namespace_for_user(user: map<json>): string {
  if (is_owner_user(user)) {
    return user.id;
  }
  if (user.ownerUserId != null && user.ownerUserId.trim().length != 0) {
    return user.ownerUserId;
  }
  return user.id;
}

function can_access_job(current: map<json>? = null, job: map<json>): bool {
  if (current == null) {
    return false;
  }
  if (is_admin_user(current)) {
    return true;
  }
  if (current.id == job.clientUserId) {
    return true;
  }
  if (is_owner_user(current) && job.ownerUserId == current.id) {
    return true;
  }
  return false;
}

function max_chunk_count(): int {
  return 10000;
}

function kSnapshotTransferChunkSizeBytes(): int {
  return 100 * 1024;
}

function kSnapshotTransferEncoding(): string {
  return 'gzip';
}

function is_active_job_status(status: string? = null): bool {
  const normalized = string.from(status ?? '').trim();
  return normalized == 'queued' || normalized == 'waiting' || normalized == 'running' || normalized == 'snapshotting' || normalized == 'uploading' || normalized == 'downloading' || normalized == 'applying';
}

function truncate_text(value: string, maxLength: int): string {
  if (value.length <= maxLength) {
    return value;
  }
  return value.slice(0, maxLength);
}

function sync_job_text(value: string? = null, maxLength: int = 256): string {
  return truncate_text(string.from(value ?? ''), maxLength);
}

function agent_online_timeout_ms(agent: map<json>): int {
  // The Windows agent polls every 15 seconds. Four missed heartbeats is enough
  // to classify it offline without turning a short network wobble into churn.
  return 60 * 1000;
}

function safe_date_diff_minutes_since(rawTimestamp: string? = null): int? {
  const timestamp = string.from(rawTimestamp ?? '').trim();
  if (timestamp.length == 0 || timestamp == '--') {
    return null;
  }
  try {
    return date.diff(date.now(), timestamp, 'min');
  } catch (err) {
    return null;
  }
}

function safe_date_diff_ms_since(rawTimestamp: string? = null): int? {
  const timestamp = string.from(rawTimestamp ?? '').trim();
  if (timestamp.length == 0 || timestamp == '--') {
    return null;
  }
  try {
    return date.diff(date.now(), timestamp, 'ms');
  } catch (err) {
    return null;
  }
}

function heartbeat_persist_interval_ms(): int {
  return 10 * 1000;
}

function heartbeat_write_due(agent: map<json>): bool {
  const lastHeartbeat = string.from(agent.lastHeartbeat ?? '').trim();
  if (lastHeartbeat.length == 0) {
    return true;
  }
  const elapsedMs = safe_date_diff_ms_since(lastHeartbeat);
  if (elapsedMs == null) {
    return true;
  }
  return elapsedMs >= heartbeat_persist_interval_ms();
}

function lightweight_agent_heartbeat_state_changed(agent: map<json>, machineName: string, historyLimit: int, server: string, database: string, replicationUseWindowsAuth: bool, replicationUser: string, replicationPassword: string, serverConnected: bool, sqlConnected: bool, selectedTable: string? = null, clientVersion: string = '', clientUpdateScriptPath: string = ''): bool {
  const nextMachineName = machineName.trim().length == 0 ? string.from(agent.clientName ?? '').trim() : machineName;
  const nextSelectedTable = selectedTable == null ? '' : string.from(selectedTable).trim();
  const currentSelectedTable = agent.selectedTable == null ? '' : string.from(agent.selectedTable).trim();
  const currentClientVersion = string.from(agent.clientVersion ?? '').trim();
  if (string.from(agent.machineName ?? '').trim() != nextMachineName) {
    return true;
  }
  if (string.from(agent.server ?? '').trim() != server.trim()) {
    return true;
  }
  if (string.from(agent.database ?? '').trim() != database.trim()) {
    return true;
  }
  if ((agent.replicationUseWindowsAuth == true) != (replicationUseWindowsAuth == true)) {
    return true;
  }
  if (string.from(agent.replicationUser ?? '').trim() != replicationUser.trim()) {
    return true;
  }
  if (string.from(agent.replicationPassword ?? '').trim() != replicationPassword.trim()) {
    return true;
  }
  if (agent.isOnline != true) {
    return true;
  }
  if (agent.syncEnabled == false) {
    return true;
  }
  if (int.from(agent.historyLimit ?? 0) != historyLimit) {
    return true;
  }
  if ((agent.serverConnected == true) != (serverConnected == true)) {
    return true;
  }
  if ((agent.sqlConnected == true) != (sqlConnected == true)) {
    return true;
  }
  if (currentSelectedTable != nextSelectedTable) {
    return true;
  }
  if (currentClientVersion != clientVersion.trim()) {
    return true;
  }
  if (string.from(agent.clientUpdateScriptPath ?? '').trim() != clientUpdateScriptPath.trim()) {
    return true;
  }
  return false;
}

function effective_agent_online(agent: map<json>): bool {
  if (agent.isOnline != true || agent.serverConnected != true || agent.sqlConnected != true) {
    return false;
  }
  const heartbeat = string.from(agent.lastHeartbeat ?? '').trim();
  if (heartbeat.length == 0) {
    return false;
  }
  const ageMs = safe_date_diff_ms_since(heartbeat);
  return ageMs != null && ageMs <= agent_online_timeout_ms(agent);
}

function agent_sync_enabled(agent: map<json>): bool {
  return agent.syncEnabled != false;
}

// Command delivery only needs a live heartbeat. Database readiness is
// required for sync scheduling, but must not block updates or diagnostics.
function agent_command_delivery_online(agent: map<json>): bool {
  if (agent.isOnline != true) {
    return false;
  }
  const heartbeat = string.from(agent.lastHeartbeat ?? '').trim();
  if (heartbeat.length == 0) {
    return false;
  }
  const ageMs = safe_date_diff_ms_since(heartbeat);
  return ageMs != null && ageMs <= agent_online_timeout_ms(agent);
}

function default_admin_username(): string {
  return 'dxfoso@gmail.com';
}

function default_admin_password(): string {
  return 'Admin@123';
}

function normalize_user_name(value: string): string {
  const trimmed = value.trim();
  if (trimmed.length == 0) {
    return string.concat('user-', uuid.v4().slice(0, 8));
  }
  return trimmed.toLowerCase();
}

function authenticated_user_client_name(current: map<json>): string {
  if (current.username != null && string.from(current.username).trim().length != 0) {
    return normalize_user_name(string.from(current.username));
  }
  return normalize_user_name(string.from(current.name));
}

function authenticated_user_matches_client(current: map<json>, clientName: string): bool {
  return authenticated_user_client_name(current) == normalize_user_name(clientName);
}

function clamp_history_limit(value: int? = null): int {
  if (value == null || value < 1) {
    return 5;
  }
  if (value > 100) {
    return 100;
  }
  return value;
}

function clamp_auto_sync_interval(value: int? = null): int {
  if (value == null || value < 1) {
    return 15;
  }
  if (value > 1440) {
    return 1440;
  }
  return value;
}

function clamp_sync_data_limit_mb(value: int? = null): int {
  if (value == null || value < 1) {
    return 256;
  }
  if (value > 1024) {
    return 1024;
  }
  return value;
}

function normalize_conflict_policy(value: string? = null): string {
  if (string.from(value ?? '').trim().toLowerCase() == 'primary_source') {
    return 'primary_source';
  }
  return 'latest_change_wins';
}

function conflict_source_client_for_owner(ownerUserId: string): string {
  const normalizedOwnerUserId = ownerUserId.trim();
  if (normalizedOwnerUserId.length == 0) {
    return '';
  }
  const selected = db.selectMany(Agent, {
    where: {
      ownerUserId: normalizedOwnerUserId,
      conflictPolicy: 'primary_source'
    },
    orderBy: { field: 'clientName', dir: 'asc' },
    fields: ['clientName'],
    limit: 2
  });
  if (selected.length != 1) {
    // Zero selections means latest-change-wins. More than one is an invalid
    // legacy state and must fail safely back to latest-change-wins until the
    // exclusive selector repairs it.
    return '';
  }
  return normalize_user_name(string.from(selected[0].clientName));
}

function kSyncTableKeySeparator(): string {
  return '::';
}

function sync_table_reference(syncTable: string): map<json> {
  const trimmed = syncTable.trim();
  const parts = trimmed.split(kSyncTableKeySeparator());
  if (parts.length != 2) {
    return {
      database: '',
      table: trimmed,
      syncKey: trimmed
    };
  }
  const databaseName = string.from(parts[0]).trim();
  const localTable = string.from(parts[1]).trim();
  if (databaseName.length == 0 || localTable.length == 0) {
    return {
      database: '',
      table: trimmed,
      syncKey: trimmed
    };
  }
  return {
    database: databaseName,
    table: localTable,
    syncKey: string.concat(databaseName, kSyncTableKeySeparator(), localTable)
  };
}

function sync_table_belongs_to_database(syncTable: string, database: string): bool {
  const selectedDatabase = database.trim().toLowerCase();
  if (selectedDatabase.length == 0) {
    return false;
  }
  const reference = sync_table_reference(syncTable);
  const tableDatabase = string.from(reference.database).trim().toLowerCase();
  const localTable = string.from(reference.table).trim();
  return tableDatabase.length != 0 &&
    localTable.length != 0 &&
    tableDatabase == selectedDatabase;
}

function table_sync_policy_database_name(policy: map<json>): string {
  return string.from(policy.database ?? '').trim();
}

function table_sync_policy_local_name(policy: map<json>): string {
  return string.from(policy.table).trim();
}

function table_sync_policy_sync_key(policy: map<json>): string {
  const databaseName = table_sync_policy_database_name(policy);
  const localTable = table_sync_policy_local_name(policy);
  if (databaseName.length == 0 || localTable.length == 0) {
    return localTable;
  }
  return string.concat(databaseName, kSyncTableKeySeparator(), localTable);
}

function table_sync_policy_scope(ownerUserId: string? = null): string {
  if (ownerUserId == null) {
    return '';
  }
  return ownerUserId.trim();
}

function list_table_sync_policies_for_scope(ownerUserId: string? = null): array<json> {
  const rows = db.selectMany(TableSyncPolicy, {
    where: { ownerUserId: table_sync_policy_scope(ownerUserId) },
    orderBy: { field: 'table', dir: 'asc' },
    fields: ['ownerUserId', 'database', 'table', 'enabled', 'updatedAt', 'updatedByClientName'],
    limit: 1000
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function table_sync_policies_for_database(ownerUserId: string? = null, database: string = ''): array<json> {
  const rows = list_table_sync_policies_for_scope(ownerUserId);
  const trimmedDatabase = database.trim();
  if (trimmedDatabase.length == 0) {
    return rows;
  }
  return rows.filter((row) => table_sync_policy_database_name(row) == trimmedDatabase);
}

function table_sync_policy_payload(policy: map<json>): map<json> {
  return {
    table: table_sync_policy_sync_key(policy),
    enabled: policy.enabled,
    updatedAt: policy.updatedAt,
    updatedByClientName: policy.updatedByClientName
  };
}

function table_sync_policy_payloads_for_database(ownerUserId: string? = null, database: string = ''): array<json> {
  return table_sync_policies_for_database(ownerUserId, database).map((policy) => table_sync_policy_payload(policy));
}

function table_dependency_sync_key(database: string, table: string): string {
  const databaseName = database.trim();
  const localTable = table.trim();
  if (databaseName.length == 0 || localTable.length == 0) {
    return localTable;
  }
  return string.concat(databaseName, kSyncTableKeySeparator(), localTable);
}

function normalized_table_dependency_payload(database: string = '', table: string, relatedTable: string, relationshipType: string = 'business', updatedByClientName: string = '', updatedAt: string = '', stampMissingUpdatedAt: bool = true): map<json>? {
  const databaseName = database.trim();
  const tableRef = sync_table_reference(table);
  const relatedRef = sync_table_reference(relatedTable);
  let resolvedDatabase = databaseName;
  if (resolvedDatabase.length == 0 && string.from(tableRef.database).trim().length != 0) {
    resolvedDatabase = string.from(tableRef.database).trim();
  }
  if (resolvedDatabase.length == 0 && string.from(relatedRef.database).trim().length != 0) {
    resolvedDatabase = string.from(relatedRef.database).trim();
  }
  const tableName = string.from(tableRef.table).trim();
  const relatedTableName = string.from(relatedRef.table).trim();
  if (tableName.length == 0 || relatedTableName.length == 0 || tableName == relatedTableName) {
    return null;
  }
  const normalizedType = relationshipType.trim().length == 0 ? 'business' : relationshipType.trim();
  let normalizedUpdatedAt = updatedAt.trim();
  if (normalizedUpdatedAt.length == 0 && stampMissingUpdatedAt) {
    normalizedUpdatedAt = now_iso();
  }
  return {
    table: table_dependency_sync_key(resolvedDatabase, tableName),
    relatedTable: table_dependency_sync_key(resolvedDatabase, relatedTableName),
    relationshipType: normalizedType,
    updatedAt: normalizedUpdatedAt,
    updatedByClientName
  };
}

function bounded_table_relationships(database: string = '', relationships: array<json>? = null, updatedByClientName: string = '', stampMissingUpdatedAt: bool = true): array<json> {
  if (relationships == null || relationships.length == 0) {
    return [];
  }
  let acceptedCount = 0;
  return relationships.map((relationship) => {
    const tableName = string.from(relationship.table ?? '').trim();
    const relatedTableName = string.from(relationship.relatedTable ?? '').trim();
    const relationshipType = string.from(relationship.relationshipType ?? 'business').trim();
    if (tableName.length == 0 || relatedTableName.length == 0 || tableName == relatedTableName) {
      return null;
    }
    return normalized_table_dependency_payload(
      database,
      tableName,
      relatedTableName,
      relationshipType.length == 0 ? 'business' : relationshipType,
      updatedByClientName,
      string.from(relationship.updatedAt ?? ''),
      stampMissingUpdatedAt
    );
  }).filter((relationship) => {
    if (relationship == null || acceptedCount >= 1000) {
      return false;
    }
    acceptedCount = acceptedCount + 1;
    return true;
  });
}

function table_dependency_payloads_for_database(ownerUserId: string? = null, database: string = ''): array<json> {
  const trimmedDatabase = database.trim();
  const relationshipGroups = list_agent_rows()
      .filter((agent) => agent.ownerUserId == ownerUserId || agent.clientUserId == ownerUserId)
      .map((agent) => table_relationships_for_database(agent.tableRelationships ?? [], trimmedDatabase, 1000));
  return relationshipGroups.reduce(
    (all, relationships) => table_relationships_for_database(all.concat(relationships), '', 1000),
    []
  );
}

function table_relationships_for_database(relationships: array<json>, database: string, maxCount: int): array<json> {
  let acceptedCount = 0;
  return relationships.filter((relationship) => {
    if (acceptedCount >= maxCount) {
      return false;
    }
    const tableRef = sync_table_reference(string.from(relationship.table));
    const relationshipDatabase = string.from(tableRef.database).trim();
    const matches = database.length == 0 || relationshipDatabase == database;
    if (matches) {
      acceptedCount = acceptedCount + 1;
    }
    return matches;
  });
}

function expand_related_table_sync_keys_once(dependencies: array<json>, databaseName: string, visited: array<string>, related: array<string>): map<json> {
  return dependencies.reduce((state, dependency) => {
    const nextVisited = state.visited ?? [];
    const nextRelated = state.related ?? [];
    const dependencyTable = string.from(sync_table_reference(string.from(dependency.table)).table).trim();
    const sourceSeen = nextVisited.filter((source) => string.from(source) == dependencyTable).length > 0;
    if (!sourceSeen) {
      return state;
    }
    const candidate = string.from(sync_table_reference(string.from(dependency.relatedTable)).table).trim();
    if (candidate.length == 0) {
      return state;
    }
    const seen = nextVisited.filter((value) => string.from(value) == candidate).length > 0;
    if (seen) {
      return state;
    }
    return {
      visited: nextVisited.concat([candidate]),
      related: nextRelated.concat([table_dependency_sync_key(databaseName, candidate)])
    };
  }, { visited, related });
}

function related_table_sync_keys_for_policy(ownerUserId: string? = null, syncTable: string): array<string> {
  const scope = table_sync_policy_scope(ownerUserId);
  const reference = sync_table_reference(syncTable);
  const databaseName = string.from(reference.database).trim();
  const rootLocalTable = string.from(reference.table).trim();
  if (rootLocalTable.length == 0) {
    return [];
  }
  const dependencies = table_dependency_payloads_for_database(scope, databaseName);
  let state = {
    visited: [rootLocalTable],
    related: []
  };
  let previousRelatedCount = -1;
  for (const dependency of dependencies) {
    if (state.related.length == previousRelatedCount) {
      return state.related;
    }
    previousRelatedCount = state.related.length;
    state = expand_related_table_sync_keys_once(dependencies, databaseName, state.visited, state.related);
  }
  return state.related;
}

function expand_sync_job_tables_for_owner(ownerUserId: string? = null, tables: array<string>): array<string> {
  const expandedGroups = tables.map((table) => {
    const normalizedTable = string.from(table).trim();
    if (normalizedTable.length == 0) {
      return [];
    }
    const relatedTables = related_table_sync_keys_for_policy(ownerUserId, normalizedTable);
    return [normalizedTable].concat(relatedTables.map((relatedTable) => string.from(relatedTable)));
  });
  return unique_string_values(expandedGroups.reduce((all, group) => all.concat(group), []));
}

function table_sync_policy_for_table(ownerUserId: string? = null, database: string = '', table: string): map<json>? {
  return table_sync_policy_for_table_with_policies(ownerUserId, database, table);
}

function table_sync_policy_for_table_with_policies(ownerUserId: string? = null, database: string = '', table: string, policies: array<json>? = null): map<json>? {
  const scope = table_sync_policy_scope(ownerUserId);
  const reference = sync_table_reference(table);
  let databaseName = database.trim();
  const referenceDatabase = string.from(reference.database).trim();
  if (referenceDatabase.length != 0) {
    databaseName = referenceDatabase;
  }
  const localTable = string.from(reference.table).trim();
  if (localTable.length == 0) {
    return null;
  }
  if (policies != null) {
    let databaseAgnosticMatch = null;
    for (const policy of policies) {
      if (string.from(policy.ownerUserId ?? '').trim() != scope) {
        continue;
      }
      if (table_sync_policy_local_name(policy) != localTable) {
        continue;
      }
      const policyDatabase = table_sync_policy_database_name(policy);
      if (databaseName.length == 0 || policyDatabase == databaseName) {
        return policy;
      }
      // Policies created before database-qualified table keys were introduced
      // remain valid defaults. Prefer an exact database match when one exists,
      // otherwise apply the database-agnostic policy to every matching local
      // table. This is especially important for exclusions: Sync All must not
      // silently re-enable a table the user explicitly excluded.
      if (policyDatabase.length == 0 && databaseAgnosticMatch == null) {
        databaseAgnosticMatch = policy;
      }
    }
    return databaseAgnosticMatch;
  }
  if (databaseName.length != 0) {
    const exactPolicy = db.selectOne(TableSyncPolicy, {
      ownerUserId: scope,
      database: databaseName,
      table: localTable
    });
    if (exactPolicy != null) {
      return exactPolicy;
    }
    const fallbackPolicies = db.selectMany(TableSyncPolicy, {
      where: {
        ownerUserId: scope,
        table: localTable
      },
      orderBy: { field: 'updatedAt', dir: 'desc' },
      fields: ['ownerUserId', 'database', 'table', 'enabled', 'syncMode', 'updatedAt', 'updatedByClientName'],
      limit: 100
    });
    for (const fallbackPolicy of fallbackPolicies) {
      if (table_sync_policy_database_name(fallbackPolicy).length == 0) {
        return fallbackPolicy;
      }
    }
    return null;
  }
  return db.selectOne(TableSyncPolicy, {
    ownerUserId: scope,
    table: localTable
  });
}

function find_table_sync_policy(ownerUserId: string? = null, syncTable: string): map<json>? {
  const scope = table_sync_policy_scope(ownerUserId);
  const reference = sync_table_reference(syncTable);
  const databaseName = string.from(reference.database).trim();
  const localTable = string.from(reference.table).trim();
  if (databaseName.length != 0 && localTable.length != 0) {
    return db.selectOne(TableSyncPolicy, {
      ownerUserId: scope,
      database: databaseName,
      table: localTable
    });
  }
  if (localTable.length != 0) {
    return db.selectOne(TableSyncPolicy, {
      ownerUserId: scope,
      table: localTable
    });
  }
  return null;
}

function upsert_table_sync_policy(ownerUserId: string? = null, table: string, enabled: bool, updatedByClientName: string = ''): map<json> {
  const scope = table_sync_policy_scope(ownerUserId);
  const reference = sync_table_reference(table);
  const databaseName = string.from(reference.database).trim();
  const localTable = string.from(reference.table).trim();
  let storedDatabase = null;
  if (databaseName.length != 0) {
    storedDatabase = databaseName;
  }
  const existing = find_table_sync_policy(scope, table);
  if (existing != null) {
    if (existing.database != null && string.from(existing.database).trim().length != 0) {
      const updated = db.update(TableSyncPolicy, {
        ownerUserId: scope,
        database: string.from(existing.database).trim(),
        table: string.from(existing.table).trim()
      }, {
        database: storedDatabase,
        table: localTable,
        enabled,
        syncMode: 'sync',
        updatedAt: now_iso(),
        updatedByClientName
      });
      if (updated != null) {
        return updated;
      }
    } else {
      const updated = db.update(TableSyncPolicy, {
        ownerUserId: scope,
        table: string.from(existing.table).trim()
      }, {
        database: storedDatabase,
        table: localTable,
        enabled,
        syncMode: 'sync',
        updatedAt: now_iso(),
        updatedByClientName
      });
      if (updated != null) {
        return updated;
      }
    }
  }
  return db.insert(TableSyncPolicy, {
    ownerUserId: scope,
    database: storedDatabase,
    table: localTable,
    enabled,
    syncMode: 'sync',
    updatedAt: now_iso(),
    updatedByClientName
  });
}

function apply_table_sync_policies(ownerUserId: string? = null, tables: array<json>? = null, database: string = ''): array<json> {
  return apply_table_sync_policies_with_policies(ownerUserId, tables, database);
}

function apply_table_sync_policies_with_policies(ownerUserId: string? = null, tables: array<json>? = null, database: string = '', policies: array<json>? = null): array<json> {
  if (tables == null) {
    return [];
  }
  if (tables.length == 0) {
    return tables;
  }
  return tables.map((tableState) => {
    const policy = table_sync_policy_for_table_with_policies(ownerUserId, database, string.from(tableState.table), policies);
    if (policy == null) {
      return tableState;
    }
    return {
      table: tableState.table,
      enabled: policy.enabled,
      status: tableState.status,
      lastSync: tableState.lastSync,
      progress: tableState.progress,
      rowCount: tableState.rowCount,
      tableChecksum: tableState.tableChecksum,
      rangeFingerprint: tableState.rangeFingerprint,
      changeTrackingVersion: tableState.changeTrackingVersion,
      changeTrackingOwner: tableState.changeTrackingOwner,
      changeTrackingStatus: tableState.changeTrackingStatus,
      changeTrackingMessage: tableState.changeTrackingMessage,
      localChangesPending: tableState.localChangesPending == true,
      message: tableState.message,
      history: tableState.history
    };
  });
}

function agent_table_payload_limit(): int {
  return 600;
}

function heartbeat_table_payload_limit(): int {
  return agent_table_payload_limit();
}

function bounded_heartbeat_tables(tables: array<json>? = null, selectedTable: string? = null, database: string = ''): array<json> {
  if (tables == null) {
    return [];
  }
  let selected = '';
  const selectedDatabase = database.trim();
  if (selectedTable != null) {
    selected = string.from(selectedTable).trim();
  }
  const maxNonSelected = selected.length == 0
    ? heartbeat_table_payload_limit()
    : heartbeat_table_payload_limit() - 1;
  let selectedState = null;
  let result = [];
  for (const tableState of tables) {
    if (result.length >= maxNonSelected) {
      break;
    }
    if (tableState.table == null) {
      continue;
    }
    const tableName = string.from(tableState.table).trim();
    if (tableName.length == 0) {
      continue;
    }
    const tableReference = sync_table_reference(tableName);
    const tableDatabase = string.from(tableReference.database ?? '').trim();
    if (selectedDatabase.length != 0 &&
        tableDatabase.length != 0 &&
        tableDatabase.toLowerCase() != selectedDatabase.toLowerCase()) {
      continue;
    }
    const nextState = {
      table: tableName,
      enabled: tableState.enabled == true,
      status: string.from(tableState.status ?? ''),
      lastSync: string.from(tableState.lastSync ?? ''),
      progress: int.from(tableState.progress ?? 0),
      rowCount: int.from(tableState.rowCount ?? 0),
      tableChecksum: string.from(tableState.tableChecksum ?? ''),
      rangeFingerprint: string.from(tableState.rangeFingerprint ?? ''),
      changeTrackingVersion: tableState.changeTrackingVersion,
      changeTrackingOwner: tableState.changeTrackingOwner,
      changeTrackingStatus: string.from(tableState.changeTrackingStatus ?? ''),
      changeTrackingMessage: string.from(tableState.changeTrackingMessage ?? ''),
      localChangesPending: tableState.localChangesPending == true,
      message: string.from(tableState.message ?? ''),
      history: []
    };
    if (selected.length != 0 && tableName == selected && selectedState == null) {
      selectedState = nextState;
      continue;
    }
    result = result.concat([nextState]);
  }
  if (selectedState != null) {
    return [selectedState].concat(result);
  }
  return result;
}

function json_payload_changed(previousPayload: json, nextPayload: json): bool {
  return json.stringify(previousPayload) != json.stringify(nextPayload);
}

function bounded_fingerprint_audit(audit: array<json>? = null): array<json> {
  if (audit == null || audit.length == 0) {
    return [];
  }
  const summary = audit[0];
  let currentTables = [];
  for (const currentTable of summary.currentTables ?? []) {
    if (currentTables.length >= 8) {
      break;
    }
    currentTables = currentTables.concat([
      truncate_text(string.from(currentTable), 512)
    ]);
  }
  let lastBatchTables = [];
  for (const lastBatchTable of summary.lastBatchTables ?? []) {
    if (lastBatchTables.length >= 8) {
      break;
    }
    lastBatchTables = lastBatchTables.concat([
      truncate_text(string.from(lastBatchTable), 512)
    ]);
  }
  let history = [];
  for (const rawBatch of summary.history ?? []) {
    if (history.length >= 20) {
      break;
    }
    let tables = [];
    for (const rawTable of rawBatch.tables ?? []) {
      if (tables.length >= 8) {
        break;
      }
      tables = tables.concat([{
        table: truncate_text(string.from(rawTable.table ?? ''), 512),
        status: truncate_text(string.from(rawTable.status ?? ''), 32),
        message: truncate_text(string.from(rawTable.message ?? ''), 512),
        rowCount: rawTable.rowCount
      }]);
    }
    history = history.concat([{
      startedAt: truncate_text(string.from(rawBatch.startedAt ?? ''), 64),
      completedAt: truncate_text(string.from(rawBatch.completedAt ?? ''), 64),
      durationMs: int.from(rawBatch.durationMs ?? 0),
      checkedCount: int.from(rawBatch.checkedCount ?? 0),
      failedCount: int.from(rawBatch.failedCount ?? 0),
      unsupportedCount: int.from(rawBatch.unsupportedCount ?? 0),
      tables
    }]);
  }
  return [{
    status: truncate_text(string.from(summary.status ?? ''), 32),
    progressPercent: int.from(summary.progressPercent ?? 0),
    checkedTables: int.from(summary.checkedTables ?? 0),
    totalTables: int.from(summary.totalTables ?? 0),
    message: truncate_text(string.from(summary.message ?? ''), 1000),
    cycleStartedAt: truncate_text(string.from(summary.cycleStartedAt ?? ''), 64),
    lastBatchCompletedAt: truncate_text(string.from(summary.lastBatchCompletedAt ?? ''), 64),
    lastCompletedAt: truncate_text(string.from(summary.lastCompletedAt ?? ''), 64),
    currentTables,
    lastBatchTables,
    history
  }];
}

function bounded_agent_tables(tables: array<json>? = null, selectedTable: string? = null): array<json> {
  if (tables == null) {
    return [];
  }
  let selected = '';
  if (selectedTable != null) {
    selected = string.from(selectedTable).trim();
  }
  let result = [];
  if (selected.length != 0) {
    for (const tableState of tables) {
      if (tableState.table == selected && result.length == 0) {
        result = result.concat([tableState]);
      }
    }
  }
  for (const tableState of tables) {
    if (result.length >= agent_table_payload_limit()) {
      break;
    }
    if (tableState.table == selected) {
      continue;
    }
    if (tableState.enabled == true) {
      let seen = false;
      for (const existing of result) {
        if (existing.table == tableState.table) {
          seen = true;
        }
      }
      if (!seen) {
        result = result.concat([tableState]);
      }
    }
  }
  for (const tableState of tables) {
    if (result.length < agent_table_payload_limit() && tableState.table != selected) {
      let seen = false;
      for (const existing of result) {
        if (existing.table == tableState.table) {
          seen = true;
        }
      }
      if (!seen) {
        result = result.concat([tableState]);
      }
    }
  }
  return result;
}

function seed_admin_user(): map<json> {
  const existing = db.selectOne(User, { username: default_admin_username() });
  if (existing != null) {
    return existing;
  }
  return db.insert(User, {
    id: uuid.v4(),
    username: default_admin_username(),
    email: default_admin_username(),
    name: default_admin_username(),
    role: 'admin',
    ownerUserId: null,
    createdByUserId: null,
    password: default_admin_password(),
    createdAt: now_iso()
  });
}

function find_user_by_identity(name: string): map<json>? {
  const normalized = normalize_user_name(name);
  const byUsername = db.selectOne(User, { username: normalized });
  if (byUsername != null) {
    return byUsername;
  }
  if (name.trim().length == 0) {
    return null;
  }
  return db.selectOne(User, { email: name.trim().toLowerCase() });
}

function find_user_by_id(userId: string? = null): map<json>? {
  if (userId == null || userId.trim().length == 0) {
    return null;
  }
  return db.selectOne(User, { id: userId });
}

function public_user_payload(user: map<json>): map<json> {
  let ownerUsername = null;
  let ownerEmail = null;
  let ownerName = null;
  const ownerUserId = user.ownerUserId;
  const owner = find_user_by_id(user.ownerUserId);
  if (owner != null) {
    ownerUsername = owner.username;
    ownerEmail = owner.email;
    ownerName = owner.name;
  }
  return {
    id: user.id,
    username: user.username,
    email: user.email,
    name: user.name,
    role: user.role,
    ownerUserId: ownerUserId,
    ownerUsername,
    ownerEmail,
    ownerName,
    createdByUserId: user.createdByUserId,
    createdAt: user.createdAt
  };
}

function create_session_for_user(user: map<json>, app: string): map<json> {
  const token = uuid.v4();
  const session = db.insert(Session, {
    id: uuid.v4(),
    token,
    userId: user.id,
    userUsername: user.username,
    userEmail: user.email,
    userName: user.name,
    userRole: user.role,
    userOwnerUserId: user.ownerUserId,
    userCreatedByUserId: user.createdByUserId,
    userCreatedAt: user.createdAt,
    app,
    createdAt: now_iso(),
    revokedAt: null
  });
  return {
    token: session.token,
    user: public_user_payload(user)
  };
}

function latest_active_session(): map<json>? {
  const rows = db.selectMany(Session, {
    where: { createdAt: { gte: '' } },
    orderBy: { field: 'createdAt', dir: 'desc' },
    fields: ['id', 'token', 'userId', 'app', 'createdAt', 'revokedAt'],
    limit: 100
  });
  if (rows == null) {
    return null;
  }
  for (const session of rows) {
    if (
      (session.app == 'web' || session.app == 'windows') &&
      (session.revokedAt == null || session.revokedAt.trim().length == 0)
    ) {
      return session;
    }
  }
  return null;
}

function find_active_session_by_token(token: string? = null): map<json>? {
  if (token == null || token.trim().length == 0) {
    return null;
  }
  const session = db.selectOne(Session, { token });
  if (session == null) {
    return null;
  }
  if (
    (session.app == 'web' || session.app == 'windows' || session.app == 'scheduler') &&
    (session.revokedAt == null || session.revokedAt.trim().length == 0)
  ) {
    return session;
  }
  return null;
}

function find_job_by_id(jobId: string? = null): map<json>? {
  if (jobId == null || jobId.trim().length == 0) {
    return null;
  }
  return db.selectOne(SyncJob, { id: jobId });
}

function find_snapshot_by_id(snapshotId: string? = null): map<json>? {
  if (snapshotId == null || snapshotId.trim().length == 0) {
    return null;
  }
  return db.selectOne(SnapshotRecord, { id: snapshotId });
}

function find_upload_session_by_upload_id(uploadId: string): map<json>? {
  return db.selectOne(UploadSession, { uploadId });
}

function find_upload_session_for_job(jobId: string, uploadId: string): map<json>? {
  const session = db.selectOne(UploadSession, { uploadId });
  if (session == null) {
    return null;
  }
  if (session.jobId != jobId) {
    return null;
  }
  return session;
}

function find_active_download_session_for_job(jobId: string, snapshotId: string? = null): map<json>? {
  if (snapshotId != null && snapshotId.trim().length != 0) {
    return db.selectOne(DownloadSession, { jobId, snapshotId });
  }
  return db.selectOne(DownloadSession, { jobId });
}

function find_download_session_for_snapshot(snapshotId: string): map<json>? {
  return db.selectOne(DownloadSession, { snapshotId });
}

function chunk_indexes(session: map<json>): array<int> {
  let indexes = [];
  for (const chunk of session.chunks) {
    const idx = int.from(chunk.index);
    if (idx >= 0) {
      indexes = indexes.concat([idx]);
    }
  }
  return indexes;
}

function has_chunk(session: map<json>, chunkIndex: int): bool {
  for (const chunk of session.chunks) {
    if (chunk.index == chunkIndex) {
      return true;
    }
  }
  return false;
}

function chunk_data_for_index(session: map<json>, chunkIndex: int): string {
  for (const chunk of session.chunks) {
    if (chunk.index == chunkIndex) {
      return string.from(chunk.data);
    }
  }
  return '';
}

function upload_session_progress(session: map<json>): map<json> {
  const received = chunk_indexes(session);
  return {
    uploadId: session.uploadId,
    chunkCount: session.chunkCount,
    compressedBytes: session.compressedBytes,
    chunkSizeBytes: session.chunkSizeBytes,
    receivedIndexes: received,
    receivedCount: received.length
  };
}

function download_session_payload(session: map<json>): map<json> {
  return {
    id: session.id,
    chunkCount: session.chunkCount,
    compressedBytes: session.compressedBytes,
    chunkSizeBytes: session.chunkSizeBytes,
    encoding: session.encoding,
    snapshotId: session.snapshotId
  };
}

function public_snapshot_payload(snapshot: map<json>): map<json> {
  return {
    id: snapshot.id,
    clientName: snapshot.clientName,
    subscriberClientName: snapshot.subscriberClientName,
    clientUserId: snapshot.clientUserId,
    ownerUserId: snapshot.ownerUserId,
    table: snapshot.table,
    rowCount: snapshot.rowCount,
    checksum: snapshot.checksum,
    createdAt: snapshot.createdAt,
    snapshotBytes: snapshot.snapshotBytes,
    compressedBytes: snapshot.compressedBytes,
    chunkCount: snapshot.chunkCount,
    encoding: snapshot.encoding,
    sourceJobId: snapshot.sourceJobId
  };
}

function latest_download_snapshot_for_job(job: map<json>): map<json>? {
  if (job.snapshotId != null && string.from(job.snapshotId).trim().length != 0) {
    return find_snapshot_by_id(job.snapshotId);
  }
  const session = find_active_download_session_for_job(job.id);
  if (session != null) {
    return find_snapshot_by_id(session.snapshotId);
  }
  return null;
}

function snapshot_checksum(snapshot: map<json>): string {
  return crypto.hash(json.stringify(snapshot), 'sha256');
}

function find_waiting_download_job(sourceClientName: string, targetClientName: string, table: string): map<json>? {
  const jobs = db.selectMany(SyncJob, {
    where: { clientName: targetClientName, sourceClientName, table },
    orderBy: { field: 'createdAt', dir: 'desc' },
    fields: ['id', 'clientName', 'sourceClientName', 'subscriberClientName', 'table', 'direction', 'publisherServer', 'publisherDatabase', 'publisherUseWindowsAuth', 'publisherUser', 'publisherPassword', 'status', 'progress', 'rowCount', 'snapshotBytes', 'snapshotCreatedAt', 'snapshotId', 'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'message', 'error', 'clientUserId', 'ownerUserId', 'batchId', 'protocolVersion', 'syncEpoch'],
    limit: 20
  });
  if (jobs == null) {
    return null;
  }
  for (const job of jobs) {
    if (string.from(job.direction).trim() != 'download') {
      continue;
    }
    const status = string.from(job.status).trim();
    if (status == 'waiting' || (status == 'queued' && (job.snapshotId == null || string.from(job.snapshotId).trim().length == 0))) {
      return job;
    }
  }
  return null;
}

function current_user_record(token: string? = null): map<json>? {
  const session = find_active_session_by_token(token);
  if (session != null) {
    if (
      session.userUsername != null &&
      session.userRole != null &&
      session.userCreatedAt != null
    ) {
      return {
        id: session.userId,
        username: session.userUsername,
        email: session.userEmail ?? '',
        name: session.userName ?? session.userUsername,
        role: session.userRole,
        ownerUserId: session.userOwnerUserId,
        createdByUserId: session.userCreatedByUserId,
        createdAt: session.userCreatedAt
      };
    }
    const user = find_user_by_id(session.userId);
    if (user != null) {
      return user;
    }
  }
  return null;
}

function deny_job_access(functionName: string, token: string? = null, current: map<json>? = null, job: map<json>? = null): map<json> {
  let tokenPresent = false;
  if (token != null && token.trim().length != 0) {
    tokenPresent = true;
  }

  let currentId = '';
  let currentRole = '';
  let currentOwnerUserId = '';
  if (current != null) {
    currentId = string.from(current.id);
    currentRole = string.from(current.role);
    if (current.ownerUserId != null) {
      currentOwnerUserId = string.from(current.ownerUserId);
    }
  }

  let jobId = '';
  let jobClientUserId = '';
  let jobOwnerUserId = '';
  let jobClientName = '';
  let jobTable = '';
  if (job != null) {
    jobId = string.from(job.id);
    jobClientName = string.from(job.clientName);
    jobTable = string.from(job.table);
    if (job.clientUserId != null) {
      jobClientUserId = string.from(job.clientUserId);
    }
    if (job.ownerUserId != null) {
      jobOwnerUserId = string.from(job.ownerUserId);
    }
  }

  log.warning('job access denied', {
    functionName,
    tokenPresent,
    currentId,
    currentRole,
    currentOwnerUserId,
    jobId,
    jobClientUserId,
    jobOwnerUserId,
    jobClientName,
    jobTable
  });
  return raw_json_error(403, 'permission denied');
}

function list_user_rows(): array<json> {
  const result = db.selectMany(User, {
    where: { id: { gte: '0' } },
    orderBy: { field: 'createdAt', dir: 'desc' },
    fields: ['id', 'username', 'email', 'name', 'role', 'ownerUserId', 'createdByUserId', 'password', 'createdAt'],
    limit: 1000
  });
  let rows = [];
  if (result == null) {
    return rows;
  }
  for (const user of result) {
    const role = string.from(user.role).trim();
    if (role == 'admin' || role == 'owner' || role == 'client') {
      rows = rows.concat([user]);
    }
  }
  return rows;
}

function list_agent_rows(): array<json> {
  const rows = db.selectMany(Agent, {
    where: { clientName: { gte: '' } },
    orderBy: { field: 'clientName', dir: 'asc' },
