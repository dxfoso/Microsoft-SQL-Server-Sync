function visible_user_rows_for(current: map<json>): array<json> {
  if (is_admin_user(current)) {
    return list_user_rows();
  }
  let users = [];
  for (const user of list_user_rows()) {
    if (can_manage_user(current, user)) {
      users = users.concat([user]);
    }
  }
  return users;
}

function visible_agent_rows_for(current: map<json>): array<json> {
  if (is_admin_user(current)) {
    return list_agent_rows();
  }
  let agents = [];
  for (const agent of list_agent_rows()) {
    if (can_read_agent(current, agent.ownerUserId, agent.clientUserId)) {
      agents = agents.concat([agent]);
    }
  }
  return agents;
}

function visible_job_rows_for(current: map<json>): array<json> {
  if (is_admin_user(current)) {
    return list_job_rows();
  }
  let jobs = [];
  for (const job of list_job_rows()) {
    if (can_access_job(current, job)) {
      jobs = jobs.concat([job]);
    }
  }
  return jobs;
}

function client_has_offline_sync_debt(agent: map<json>): bool {
  const rows = db.selectMany(OfflineSyncDebt, {
    where: {
      ownerUserId: string.from(agent.ownerUserId),
      clientName: string.from(agent.clientName)
    },
    orderBy: { field: 'updatedAt', dir: 'desc' },
    fields: ['id'],
    limit: 1
  });
  return rows != null && rows.length > 0;
}

function client_runtime_status_payload(agent: map<json>, activeJobs: array<json>? = null): map<json> {
  const heartbeatAgeMs = safe_date_diff_ms_since(string.from(agent.lastHeartbeat ?? ''));
  let heartbeatAgeSeconds = null;
  if (heartbeatAgeMs != null && heartbeatAgeMs >= 0) {
    heartbeatAgeSeconds = int.from(heartbeatAgeMs / 1000);
  }
  if (!effective_agent_online(agent)) {
    return {
      code: 'offline',
      label: 'Offline',
      ready: false,
      heartbeatAgeSeconds
    };
  }
  if (!agent_sync_enabled(agent)) {
    return {
      code: 'disabled',
      label: 'Sync disabled',
      ready: false,
      heartbeatAgeSeconds
    };
  }
  let clientActiveJobs = activeJobs;
  if (clientActiveJobs == null) {
    clientActiveJobs = db.selectMany(SyncJob, {
      where: {
        clientName: string.from(agent.clientName),
        status: { in: ['queued', 'waiting', 'running', 'snapshotting', 'uploading', 'downloading', 'applying'] }
      },
      orderBy: { field: 'updatedAt', dir: 'desc' },
      fields: ['clientName', 'status'],
      limit: 100
    });
  }
  const priorities = ['applying', 'downloading', 'uploading', 'snapshotting', 'running', 'waiting', 'queued'];
  for (const phase of priorities) {
    for (const job of clientActiveJobs ?? []) {
      if (string.from(job.clientName).trim() != string.from(agent.clientName).trim()) {
        continue;
      }
      if (string.from(job.status).trim().toLowerCase() != phase) {
        continue;
      }
      let label = 'Syncing';
      if (phase == 'applying') { label = 'Applying'; }
      if (phase == 'downloading') { label = 'Downloading'; }
      if (phase == 'uploading' || phase == 'snapshotting') { label = 'Uploading'; }
      if (phase == 'waiting') { label = 'Waiting'; }
      if (phase == 'queued') { label = 'Queued'; }
      return {
        code: phase,
        label,
        ready: false,
        heartbeatAgeSeconds
      };
    }
  }
  if (agent_client_update_payload(agent).pending == true) {
    const updateStatus = string.from(agent.clientUpdateStatus ?? '').trim().toLowerCase();
    let updateCode = 'update_pending';
    let updateLabel = 'Update pending';
    if (updateStatus == 'retrying') {
      updateCode = 'update_retrying';
      updateLabel = 'Update retrying';
    }
    return {
      code: updateCode,
      label: updateLabel,
      ready: false,
      heartbeatAgeSeconds
    };
  }
  if (client_has_offline_sync_debt(agent)) {
    const catchupPaused = automatic_sync_is_paused() ||
      automatic_sync_is_paused_for_owner(string.from(agent.ownerUserId));
    if (catchupPaused) {
      return {
        code: 'catchup_paused',
        label: 'Catch-up pending (sync paused)',
        ready: false,
        heartbeatAgeSeconds
      };
    }
    return {
      code: 'catching_up',
      label: 'Catching up',
      ready: false,
      heartbeatAgeSeconds
    };
  }
  return {
    code: 'ready',
    label: 'Ready',
    ready: true,
    heartbeatAgeSeconds
  };
}

function latest_completed_sync_summary_for_client(clientName: string, completedJobs: array<json>? = null): map<json> {
  let latestJob = null;
  for (const job of completedJobs ?? []) {
    if (string.from(job.status).trim().toLowerCase() != 'completed' ||
        string.from(job.direction).trim().toLowerCase() != 'download') {
      continue;
    }
    const matchesClient = string.from(job.clientName).trim() == clientName ||
      string.from(job.subscriberClientName ?? '').trim() == clientName;
    const completedAt = string.from(job.completedAt ?? '').trim();
    if (!matchesClient || completedAt.length == 0) {
      continue;
    }
    if (latestJob == null || sync_timestamp_compare_ms(completedAt, string.from(latestJob.completedAt ?? '')) > 0) {
      latestJob = job;
    }
  }
  if (latestJob == null) {
    return {
      completedAt: '',
      durationMs: null,
      uploadedRows: 0,
      downloadedRows: 0
    };
  }
  const createdAt = string.from(latestJob.createdAt ?? '').trim();
  const completedAt = string.from(latestJob.completedAt ?? '').trim();
  let durationMs = null;
  if (createdAt.length != 0) {
    try {
      const measuredMs = date.diff(completedAt, createdAt, 'ms');
      if (measuredMs >= 0) {
        durationMs = measuredMs;
      }
    } catch (err) {
      durationMs = null;
    }
  }
  let uploadedRows = 0;
  let downloadedRows = int.from(latestJob.rowCount ?? 0);
  const latestBatchId = string.from(latestJob.batchId ?? '').trim();
  for (const job of completedJobs ?? []) {
    if (latestBatchId.length == 0 ||
        string.from(job.status).trim().toLowerCase() != 'completed' ||
        string.from(job.batchId ?? '').trim() != latestBatchId) {
      continue;
    }
    const matchesClient = string.from(job.clientName).trim() == clientName ||
      string.from(job.subscriberClientName ?? '').trim() == clientName;
    if (!matchesClient) {
      continue;
    }
    const direction = string.from(job.direction).trim().toLowerCase();
    if (direction == 'upload') {
      uploadedRows += int.from(job.rowCount ?? 0);
    }
    if (direction == 'download') {
      downloadedRows = int.from(job.rowCount ?? 0);
    }
  }
  return { completedAt, durationMs, uploadedRows, downloadedRows };
}

function periodic_sync_last_checked_at_for_owner(ownerUserId: string, periodicStates: array<json>? = null): string {
  const normalizedOwnerUserId = ownerUserId.trim();
  for (const state of periodicStates ?? []) {
    if (string.from(state.ownerUserId ?? '').trim() == normalizedOwnerUserId) {
      return string.from(state.lastCheckedAt ?? '').trim();
    }
  }
  return '';
}

function completed_row_totals_for_client(clientName: string, completedRowTotals: array<json>? = null): map<json> {
  for (const totals of completedRowTotals ?? []) {
    if (string.from(totals.clientName ?? '').trim() != clientName.trim()) {
      continue;
    }
    return {
      uploaded: int.from(totals.uploaded ?? 0),
      downloaded: int.from(totals.downloaded ?? 0)
    };
  }
  return { uploaded: 0, downloaded: 0 };
}

function automatic_number_incident_count_for_client(ownerUserId: string, clientName: string, incidentCounts: array<json>? = null): int {
  for (const totals of incidentCounts ?? []) {
    if (string.from(totals.ownerUserId ?? '').trim() == ownerUserId.trim() &&
        string.from(totals.clientName ?? '').trim() == clientName.trim()) {
      return int.from(totals.incidentCount ?? 0);
    }
  }
  return 0;
}

function public_agent_payload(agent: map<json>, activeJobs: array<json>? = null, completedJobs: array<json>? = null, periodicStates: array<json>? = null, completedRowTotals: array<json>? = null, automaticNumberIncidentCounts: array<json>? = null): map<json> {
  let nextTables = [];
  if (agent.tables != null) {
    const policies = list_table_sync_policies_for_scope(agent.ownerUserId);
    nextTables = apply_table_sync_policies_with_policies(
      agent.ownerUserId,
      bounded_agent_tables(agent.tables, agent.selectedTable),
      string.from(agent.database),
      policies
    );
  }
  nextTables = normalize_agent_tables_payload(agent, nextTables, activeJobs);
  const runtimeStatus = client_runtime_status_payload(agent, activeJobs);
  const lastCompletedSync = latest_completed_sync_summary_for_client(
    string.from(agent.clientName),
    completedJobs
  );
  const rowTotals = completed_row_totals_for_client(
    string.from(agent.clientName),
    completedRowTotals
  );
  return {
    clientName: agent.clientName,
    machineName: agent.machineName,
    server: agent.server,
    database: agent.database,
    syncEnabled: agent_sync_enabled(agent),
    isOnline: effective_agent_online(agent),
    historyLimit: agent.historyLimit,
    autoSyncIntervalMinutes: agent.autoSyncIntervalMinutes,
    syncDataLimitMb: clamp_sync_data_limit_mb(agent.syncDataLimitMb),
    conflictPolicy: normalize_conflict_policy(agent.conflictPolicy),
    serverConnected: agent.serverConnected,
    sqlConnected: agent.sqlConnected,
    clientVersion: agent.clientVersion ?? '',
    lastHeartbeat: agent.lastHeartbeat,
    lastChangeCheckAt: periodic_sync_last_checked_at_for_owner(
      string.from(agent.ownerUserId ?? ''),
      periodicStates
    ),
    lastSyncCompletedAt: lastCompletedSync.completedAt,
    lastSyncDurationMs: lastCompletedSync.durationMs,
    lastUploadedRows: lastCompletedSync.uploadedRows,
    lastDownloadedRows: lastCompletedSync.downloadedRows,
    uploadedRowTotal: rowTotals.uploaded,
    downloadedRowTotal: rowTotals.downloaded,
    automaticNumberIncidentCount: automatic_number_incident_count_for_client(
      string.from(agent.ownerUserId ?? ''),
      string.from(agent.clientName),
      automaticNumberIncidentCounts
    ),
    status: runtimeStatus,
    selectedTable: agent.selectedTable,
    diagnostics: agent_diagnostics_payload(agent),
    clientUpdate: agent_client_update_payload(agent),
    windowAction: agent_window_action_payload(agent),
    dataExport: agent_data_export_payload(agent),
    fingerprintAudit: agent.fingerprintAudit ?? [],
    tables: nextTables,
    clientUserId: agent.clientUserId,
    ownerUserId: agent.ownerUserId
  };
}

function diagnostic_request_pending(agent: map<json>): bool {
  if (agent.diagnosticRequestId == null) {
    return false;
  }
  const requestId = string.from(agent.diagnosticRequestId).trim();
  if (requestId.length == 0) {
    return false;
  }
  if (agent.diagnosticLastRequestId == null) {
    return true;
  }
  return string.from(agent.diagnosticLastRequestId).trim() != requestId;
}

function pending_request_awaits_online_client(agent: map<json>, pending: bool): bool {
  return pending && !agent_command_delivery_online(agent);
}

function agent_diagnostics_payload(agent: map<json>, includePayload: bool = false, authenticatedClientPoll: bool = false): map<json> {
  let payload = null;
  if (includePayload && agent.diagnosticPayload != null) {
    payload = agent.diagnosticPayload;
  }
  const pending = diagnostic_request_pending(agent);
  const waitingForClient = !authenticatedClientPoll && pending_request_awaits_online_client(agent, pending);
  let statusValue = agent.diagnosticStatus == null ? 'idle' : string.from(agent.diagnosticStatus);
  let summaryValue = agent.diagnosticSummary == null ? '' : string.from(agent.diagnosticSummary);
  if (waitingForClient) {
    statusValue = 'client_offline';
    if (summaryValue.trim().length == 0) {
      summaryValue = 'Waiting for the client to heartbeat before diagnostics can upload.';
    }
  }
  return {
    pending: pending && !waitingForClient,
    requestId: agent.diagnosticRequestId,
    requestedAt: agent.diagnosticRequestedAt,
    requestedByUserId: agent.diagnosticRequestedByUserId,
    uploadedAt: agent.diagnosticLastUploadedAt,
    lastRequestId: agent.diagnosticLastRequestId,
    status: statusValue,
    stage: agent.diagnosticStage,
    progressPercent: agent.diagnosticProgressPercent,
    startedAt: agent.diagnosticStartedAt,
    completedAt: agent.diagnosticCompletedAt,
    summary: summaryValue,
    payload: payload
  };
}

function client_update_request_pending(agent: map<json>): bool {
  if (agent.clientUpdateRequestId == null) {
    return false;
  }
  const requestId = string.from(agent.clientUpdateRequestId).trim();
  if (requestId.length == 0) {
    return false;
  }
  if (agent.clientUpdateLastRequestId == null) {
    return true;
  }
  return string.from(agent.clientUpdateLastRequestId).trim() != requestId;
}

function client_update_ack_should_retry(status: string, message: string): bool {
  const normalizedStatus = status.trim().toLowerCase();
  if (normalizedStatus == 'retrying' || normalizedStatus == 'downloading' || normalizedStatus == 'installing') {
    return true;
  }
  // Compatibility for installed clients that predate the typed `retrying`
  // acknowledgement. Their manifest timeout text is deterministic; treating
  // only deterministic transport failures as retryable avoids looping
  // permanent version or package-validation errors.
  if (normalizedStatus != 'failed') {
    return false;
  }
  const normalizedMessage = message.trim().toLowerCase();
  if (normalizedMessage ==
      'control plane request timed out during checking client update manifest. check network connectivity.') {
    return true;
  }
  // Differential downloads preserve their verified partial file. Keep the
  // same durable request pending only for known DNS-resolution failures so a
  // later heartbeat can resume it; package/hash/version failures remain
  // terminal and cannot loop automatically.
  return normalizedMessage.contains(
      'resumable update payload download failed after 3 bounded attempts:') &&
    (normalizedMessage.contains('remote name could not be resolved') ||
      normalizedMessage.contains('no such host is known') ||
      normalizedMessage.contains('name resolution'));
}

function latest_confirmed_client_release_for_owner(ownerUserId: string): map<json>? {
  const normalizedOwnerUserId = ownerUserId.trim();
  if (normalizedOwnerUserId.length == 0) {
    return null;
  }
  const rows = db.selectMany(Agent, {
    where: {
      ownerUserId: normalizedOwnerUserId,
      clientUpdateStatus: 'current',
      clientUpdateLastAcknowledgedAt: { lte: now_iso() }
    },
    orderBy: { field: 'clientUpdateLastAcknowledgedAt', dir: 'desc' },
    fields: ['clientName', 'clientVersion', 'clientUpdateLastAcknowledgedAt'],
    limit: 1
  });
  if (rows == null || rows.length == 0) {
    return null;
  }
  const version = string.from(rows[0].clientVersion ?? '').trim();
  if (version.length == 0) {
    return null;
  }
  return rows[0];
}

function client_update_retarget_cooldown_elapsed(agent: map<json>): bool {
  const status = string.from(agent.clientUpdateStatus ?? '').trim().toLowerCase();
  if (status != 'failed' && status != 'retrying') {
    return true;
  }
  const ageMs = safe_date_diff_ms_since(string.from(agent.clientUpdateRequestedAt ?? ''));
  return ageMs == null || ageMs >= 600000;
}

function retarget_outdated_client_update_on_heartbeat(agent: map<json>, ownerUserId: string): map<json> {
  if (client_update_request_pending(agent) || !client_update_retarget_cooldown_elapsed(agent)) {
    return agent;
  }
  const installedVersion = string.from(agent.clientVersion ?? '').trim();
  if (installedVersion.length == 0) {
    return agent;
  }
  const latest = latest_confirmed_client_release_for_owner(ownerUserId);
  if (latest == null) {
    return agent;
  }
  const latestVersion = string.from(latest.clientVersion ?? '').trim();
  if (latestVersion.length == 0 || latestVersion == installedVersion) {
    return agent;
  }
  const status = string.from(agent.clientUpdateStatus ?? '').trim().toLowerCase();
  if (status == 'current') {
    const agentAcknowledgedAt = string.from(agent.clientUpdateLastAcknowledgedAt ?? '').trim();
    const latestAcknowledgedAt = string.from(latest.clientUpdateLastAcknowledgedAt ?? '').trim();
    if (agentAcknowledgedAt.length != 0) {
      try {
        if (date.diff(latestAcknowledgedAt, agentAcknowledgedAt, 'ms') <= 0) {
          return agent;
        }
      } catch (err) {
        return agent;
      }
    }
  }
  const requestedAt = now_iso();
  const updated = db.update(Agent, { clientName: string.from(agent.clientName) }, {
    clientUpdateRequestId: uuid.v4(),
    clientUpdateRequestedAt: requestedAt,
    clientUpdateRequestedByUserId: null,
    // An untargeted request makes the client resolve the current immutable
    // manifest instead of replaying a release that has already been superseded.
    clientUpdateTargetVersion: null,
    clientUpdateStatus: 'requested',
    clientUpdateMessage: 'A newer confirmed client release will be resolved from the live immutable manifest.',
    clientUpdateDownloadedBytes: null,
    clientUpdateTotalBytes: null,
    clientUpdateProgressPercent: null,
    updatedAt: requestedAt
  });
  if (updated == null) {
    return agent;
  }
  return updated;
}

function agent_client_update_payload(agent: map<json>, authenticatedClientPoll: bool = false): map<json> {
  const pending = client_update_request_pending(agent);
