function agent_client_update_ack(clientName: string? = null, requestId: string? = null, status: string = 'current', installedVersion: string = '', message: string = '', downloadedBytes: int? = null, totalBytes: int? = null, progressPercent: int? = null, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = '';
  if (clientName == null || clientName.trim().length == 0) {
    if (current.username == null) {
      resolvedClientName = normalize_user_name(current.name);
    } else {
      resolvedClientName = normalize_user_name(current.username);
    }
  } else {
    resolvedClientName = normalize_user_name(clientName);
  }
  if (is_client_user(current)) {
    let currentClientName = normalize_user_name(current.name);
    if (current.username != null) {
      currentClientName = normalize_user_name(current.username);
    }
    if (resolvedClientName != currentClientName) {
      return raw_json_error(403, 'permission denied');
    }
  }
  const targetUser = find_user_by_identity(resolvedClientName);
  if (targetUser != null && !can_manage_user(current, targetUser)) {
    return raw_json_error(403, 'permission denied');
  }
  let targetOwnerUserId = owner_namespace_for_user(current);
  let targetClientUserId = current.id;
  if (targetUser != null) {
    targetOwnerUserId = targetUser.ownerUserId;
    targetClientUserId = targetUser.id;
  }
  const agent = ensure_agent(resolvedClientName, targetClientUserId, targetOwnerUserId);
  // `requestId` is reserved by the TRU call envelope and can be replaced by
  // the execution request id at runtime. A client can only acknowledge the
  // single current request stored on its Agent row, so persist that id.
  let resolvedRequestId = '';
  if (agent.clientUpdateRequestId != null) {
    resolvedRequestId = string.from(agent.clientUpdateRequestId).trim();
  }
  let resolvedRequestIdOrNull = null;
  if (resolvedRequestId.length != 0) {
    resolvedRequestIdOrNull = resolvedRequestId;
  }
  let nextClientVersion = '';
  if (installedVersion.trim().length == 0) {
    if (agent.clientVersion != null) {
      nextClientVersion = truncate_text(string.from(agent.clientVersion).trim(), 32);
    }
  } else {
    nextClientVersion = truncate_text(installedVersion.trim(), 32);
  }
  const retryableAcknowledgement = client_update_ack_should_retry(status, message);
  let nextLastRequestId = agent.clientUpdateLastRequestId;
  let nextAcknowledgedAt = agent.clientUpdateLastAcknowledgedAt;
  let nextStatus = truncate_text(status.trim(), 32);
  let nextDownloadedBytes = agent.clientUpdateDownloadedBytes;
  let nextTotalBytes = agent.clientUpdateTotalBytes;
  let nextProgressPercent = agent.clientUpdateProgressPercent;
  if (downloadedBytes != null && downloadedBytes >= 0) {
    nextDownloadedBytes = downloadedBytes;
  }
  if (totalBytes != null && totalBytes >= 0) {
    nextTotalBytes = totalBytes;
  }
  if (progressPercent != null) {
    nextProgressPercent = progressPercent;
    if (nextProgressPercent < 0) {
      nextProgressPercent = 0;
    }
    if (nextProgressPercent > 100) {
      nextProgressPercent = 100;
    }
  }
  if (retryableAcknowledgement) {
    const normalizedNextStatus = nextStatus.trim().toLowerCase();
    if (normalizedNextStatus != 'downloading' && normalizedNextStatus != 'installing') {
      nextStatus = 'retrying';
    }
  } else {
    nextLastRequestId = resolvedRequestIdOrNull;
    nextAcknowledgedAt = now_iso();
  }
  const updated = db.update(Agent, { clientName: resolvedClientName }, {
    clientUpdateLastRequestId: nextLastRequestId,
    clientUpdateLastAcknowledgedAt: nextAcknowledgedAt,
    clientUpdateStatus: nextStatus,
    clientUpdateMessage: truncate_text(message, 4000),
    clientUpdateDownloadedBytes: nextDownloadedBytes,
    clientUpdateTotalBytes: nextTotalBytes,
    clientUpdateProgressPercent: nextProgressPercent,
    clientVersion: nextClientVersion,
    updatedAt: now_iso()
  });
  if (updated == null) {
    return raw_json_error(404, 'client not found');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    clientUpdate: agent_client_update_payload(updated)
  };
}

function agent_window_action_request_all(action: string = 'minimize', token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedAction = truncate_text(action.trim().toLowerCase(), 32);
  if (normalizedAction.length == 0) {
    return raw_json_error(400, 'action is required');
  }
  if (normalizedAction != 'minimize') {
    return raw_json_error(400, 'unsupported window action');
  }
  const requestId = uuid.v4();
  const requestedAt = now_iso();
  const visibleAgents = visible_agent_rows_for(current);
  let requestedClientNames = [];
  for (const agent of visibleAgents) {
    if (!effective_agent_online(agent)) {
      continue;
    }
    const clientName = normalize_user_name(agent.clientName);
    if (clientName.length != 0) {
      requestedClientNames = requestedClientNames.concat([clientName]);
    }
  }
  if (requestedClientNames.length == 0) {
    return {
      ok: true,
      action: normalizedAction,
      requestId,
      requestedAt,
      requestedByUserId: current.id,
      requestedClientCount: 0,
      requestedClientNames: []
    };
  }
  db.updateMany(Agent, { clientName: { in: requestedClientNames } }, {
    windowActionRequestId: requestId,
    windowActionRequestedAt: requestedAt,
    windowActionRequestedByUserId: current.id,
    windowActionName: normalizedAction,
    windowActionStatus: 'requested',
    windowActionMessage: '',
    updatedAt: requestedAt
  });
  return {
    ok: true,
    action: normalizedAction,
    requestId,
    requestedAt,
    requestedByUserId: current.id,
    requestedClientCount: requestedClientNames.length,
    requestedClientNames
  };
}

function agent_window_action_ack(clientName: string? = null, requestId: string? = null, action: string = '', status: string = 'completed', message: string = '', token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = '';
  if (clientName == null || clientName.trim().length == 0) {
    if (current.username == null) {
      resolvedClientName = normalize_user_name(current.name);
    } else {
      resolvedClientName = normalize_user_name(current.username);
    }
  } else {
    resolvedClientName = normalize_user_name(clientName);
  }
  const targetUser = find_user_by_identity(resolvedClientName);
  if (targetUser != null && !can_manage_user(current, targetUser)) {
    return raw_json_error(403, 'permission denied');
  }
  let targetOwnerUserId = owner_namespace_for_user(current);
  let targetClientUserId = current.id;
  if (targetUser != null) {
    targetOwnerUserId = targetUser.ownerUserId;
    targetClientUserId = targetUser.id;
  }
  const agent = ensure_agent(resolvedClientName, targetClientUserId, targetOwnerUserId);
  // See agent_client_update_ack: use the current persisted request because
  // the TRU envelope reserves the `requestId` argument name.
  let resolvedRequestId = '';
  if (agent.windowActionRequestId != null) {
    resolvedRequestId = string.from(agent.windowActionRequestId).trim();
  }
  let resolvedRequestIdOrNull = null;
  if (resolvedRequestId.length != 0) {
    resolvedRequestIdOrNull = resolvedRequestId;
  }
  let nextAction = '';
  if (action.trim().length == 0) {
    if (agent.windowActionName != null) {
      nextAction = truncate_text(string.from(agent.windowActionName).trim().toLowerCase(), 32);
    }
  } else {
    nextAction = truncate_text(action.trim().toLowerCase(), 32);
  }
  const updated = db.update(Agent, { clientName: resolvedClientName }, {
    windowActionLastRequestId: resolvedRequestIdOrNull,
    windowActionLastAcknowledgedAt: now_iso(),
    windowActionName: nextAction,
    windowActionStatus: truncate_text(status.trim(), 32),
    windowActionMessage: truncate_text(message, 4000),
    updatedAt: now_iso()
  });
  if (updated == null) {
    return raw_json_error(404, 'client not found');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    windowAction: agent_window_action_payload(updated)
  };
}

function agent_data_export_request(clientName: string, database: string, uploadUrl: string, uploadToken: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_admin_user(current) && !is_owner_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedClientName = normalize_user_name(clientName);
  const targetAgent = db.selectOne(Agent, { clientName: normalizedClientName });
  if (targetAgent == null || !can_read_agent(current, targetAgent.ownerUserId, targetAgent.clientUserId)) {
    return raw_json_error(404, 'client not found');
  }
  const normalizedDatabase = truncate_text(database.trim(), 256);
  if (normalizedDatabase.length == 0 || normalizedDatabase.toLowerCase() != string.from(targetAgent.database).trim().toLowerCase()) {
    return raw_json_error(400, 'export database must match the client selected database');
  }
  const normalizedUploadUrl = truncate_text(uploadUrl.trim(), 1000);
  if (normalizedUploadUrl != 'https://sync.velvet-leaf.com/private-export') {
    return raw_json_error(400, 'export upload URL must use the private sync endpoint');
  }
  const normalizedUploadToken = truncate_text(uploadToken.trim(), 256);
  if (normalizedUploadToken.length < 32) {
    return raw_json_error(400, 'export upload token is invalid');
  }
  const requestedAt = now_iso();
  const nextRequestId = uuid.v4();
  const updatedCount = db.updateMany(Agent, { clientName: normalizedClientName }, {
    dataExportRequestId: nextRequestId,
    dataExportRequestedAt: requestedAt,
    dataExportRequestedByUserId: current.id,
    dataExportDatabase: normalizedDatabase,
    dataExportUploadUrl: normalizedUploadUrl,
    dataExportUploadToken: normalizedUploadToken,
    dataExportStatus: 'requested',
    dataExportMessage: '',
    dataExportBytes: 0,
    dataExportSha256: '',
    dataExportChunkCount: 0,
    updatedAt: requestedAt
  });
  if (updatedCount == 0) {
    return raw_json_error(404, 'client not found');
  }
  const updated = db.selectOne(Agent, { clientName: normalizedClientName, dataExportRequestId: nextRequestId });
  if (updated == null) {
    return raw_json_error(500, 'export request state unavailable');
  }
  return {
    ok: true,
    clientName: normalizedClientName,
    dataExport: agent_data_export_payload(updated)
  };
}

function agent_data_export_poll(clientName: string? = null, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = current.username == null
    ? normalize_user_name(current.name)
    : normalize_user_name(current.username);
  if (clientName != null && clientName.trim().length != 0) {
    resolvedClientName = normalize_user_name(clientName);
  }
  if (is_client_user(current)) {
    const currentClientName = current.username == null
      ? normalize_user_name(current.name)
      : normalize_user_name(current.username);
    if (resolvedClientName != currentClientName) {
      return raw_json_error(403, 'permission denied');
    }
  }
  const agent = db.selectOne(Agent, { clientName: resolvedClientName });
  if (agent == null || !can_read_agent(current, agent.ownerUserId, agent.clientUserId)) {
    return raw_json_error(404, 'client not found');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    dataExport: agent_data_export_payload(agent, true, true)
  };
}

function agent_data_export_ack(clientName: string? = null, requestId: string? = null, status: string = 'completed', message: string = '', bytes: int = 0, sha256: string = '', chunkCount: int = 0, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = '';
  if (clientName == null || clientName.trim().length == 0) {
    resolvedClientName = current.username == null
      ? normalize_user_name(current.name)
      : normalize_user_name(current.username);
  } else {
    resolvedClientName = normalize_user_name(clientName);
  }
  if (is_client_user(current)) {
    let currentClientName = normalize_user_name(current.name);
    if (current.username != null) {
      currentClientName = normalize_user_name(current.username);
    }
    if (resolvedClientName != currentClientName) {
      return raw_json_error(403, 'permission denied');
    }
  }
  const targetUser = find_user_by_identity(resolvedClientName);
  if (!authenticated_user_matches_client(current, resolvedClientName) && targetUser != null && !can_manage_user(current, targetUser)) {
    return raw_json_error(403, 'permission denied');
  }
  const agent = db.selectOne(Agent, { clientName: resolvedClientName });
  if (agent == null) {
    return raw_json_error(404, 'client not found');
  }
  // `requestId` is reserved by the TRU call envelope. Use the single current
  // export request persisted on the Agent row, as the other acknowledgements do.
  let acknowledgedRequestId = '';
  if (agent.dataExportRequestId != null) {
    acknowledgedRequestId = string.from(agent.dataExportRequestId).trim();
  }
  if (acknowledgedRequestId.length == 0) {
    return raw_json_error(400, 'requestId is required');
  }
  const matchingAgent = db.selectOne(Agent, { clientName: resolvedClientName, dataExportRequestId: acknowledgedRequestId });
  if (matchingAgent == null) {
    return {
      ok: true,
      stale: true,
      clientName: resolvedClientName,
      dataExport: agent_data_export_payload(agent)
    };
  }
  let resolvedRequestIdOrNull = null;
  const normalizedStatus = truncate_text(status.trim().toLowerCase(), 32);
  const terminalStatus = normalizedStatus == 'completed' || normalizedStatus == 'failed';
  if (terminalStatus) {
    resolvedRequestIdOrNull = acknowledgedRequestId;
  }
  let safeBytes = bytes;
  if (safeBytes < 0) { safeBytes = 0; }
  let safeChunkCount = chunkCount;
  if (safeChunkCount < 0) { safeChunkCount = 0; }
  let nextUploadUrl = matchingAgent.dataExportUploadUrl;
  let nextUploadToken = matchingAgent.dataExportUploadToken;
  if (terminalStatus) {
    nextUploadUrl = null;
    nextUploadToken = null;
  }
  const updatedCount = db.updateMany(Agent, { clientName: resolvedClientName, dataExportRequestId: acknowledgedRequestId }, {
    dataExportLastRequestId: resolvedRequestIdOrNull,
    dataExportLastAcknowledgedAt: now_iso(),
    dataExportUploadUrl: nextUploadUrl,
    dataExportUploadToken: nextUploadToken,
    dataExportStatus: normalizedStatus,
    dataExportMessage: truncate_text(message, 4000),
    dataExportBytes: safeBytes,
    dataExportSha256: truncate_text(sha256.trim().toLowerCase(), 64),
    dataExportChunkCount: safeChunkCount,
    updatedAt: now_iso()
  });
  if (updatedCount == 0) {
    return raw_json_error(404, 'client not found');
  }
  const updated = db.selectOne(Agent, { clientName: resolvedClientName, dataExportRequestId: acknowledgedRequestId });
  if (updated == null) {
    return raw_json_error(500, 'export acknowledgement state unavailable');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    dataExport: agent_data_export_payload(updated)
  };
}

function agent_diagnostics_progress(clientName: string? = null, requestId: string? = null, stage: string = 'running', progressPercent: int = 0, summary: string = '', token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = '';
  if (clientName == null || clientName.trim().length == 0) {
    if (current.username == null) {
      resolvedClientName = normalize_user_name(current.name);
    } else {
      resolvedClientName = normalize_user_name(current.username);
    }
  } else {
    resolvedClientName = normalize_user_name(clientName);
  }
  if (is_client_user(current) && !authenticated_user_matches_client(current, resolvedClientName)) {
    return raw_json_error(403, 'permission denied');
  }
  const agent = db.selectOne(Agent, { clientName: resolvedClientName });
  if (agent == null) {
    return raw_json_error(404, 'client not found');
  }
  if (!can_read_agent(current, agent.ownerUserId, agent.clientUserId)) {
    return raw_json_error(403, 'permission denied');
  }
  let safeProgress = progressPercent;
  if (safeProgress < 0) {
    safeProgress = 0;
  }
  if (safeProgress > 99) {
    safeProgress = 99;
  }
  const updatedCount = db.updateMany(Agent, { clientName: resolvedClientName }, {
    diagnosticStatus: 'running',
    diagnosticStage: truncate_text(stage.trim(), 64),
    diagnosticProgressPercent: safeProgress,
    diagnosticStartedAt: agent.diagnosticStartedAt ?? now_iso(),
    diagnosticCompletedAt: null,
    diagnosticSummary: truncate_text(summary, 4000),
    updatedAt: now_iso()
  });
  if (updatedCount == 0) {
    return raw_json_error(404, 'client not found');
  }
  const updated = db.selectOne(Agent, { clientName: resolvedClientName });
  if (updated == null) {
    return raw_json_error(500, 'diagnostics progress state unavailable');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    diagnostics: agent_diagnostics_payload(updated)
  };
}

function agent_diagnostics_upload(clientName: string? = null, requestId: string? = null, summary: string = '', payload: string = '', stage: string = 'completed', progressPercent: int = 100, complete: bool = true, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  let resolvedClientName = '';
  if (clientName == null || clientName.trim().length == 0) {
    if (current.username == null) {
      resolvedClientName = normalize_user_name(current.name);
    } else {
      resolvedClientName = normalize_user_name(current.username);
    }
  } else {
    resolvedClientName = normalize_user_name(clientName);
  }
  if (is_client_user(current) && !authenticated_user_matches_client(current, resolvedClientName)) {
    return raw_json_error(403, 'permission denied');
  }
  const agent = db.selectOne(Agent, { clientName: resolvedClientName });
  if (agent == null) {
    return raw_json_error(404, 'client not found');
  }
  if (!can_read_agent(current, agent.ownerUserId, agent.clientUserId)) {
    return raw_json_error(403, 'permission denied');
  }
  // See agent_client_update_ack: use the current persisted request because
  // the TRU envelope reserves the `requestId` argument name.
  let resolvedRequestId = '';
  if (agent.diagnosticRequestId != null) {
    resolvedRequestId = string.from(agent.diagnosticRequestId).trim();
  }
  let resolvedRequestIdOrNull = null;
  if (resolvedRequestId.length != 0) {
    resolvedRequestIdOrNull = resolvedRequestId;
  }
  let safeProgress = progressPercent;
  if (safeProgress < 0) {
    safeProgress = 0;
  }
  if (safeProgress > 100) {
    safeProgress = 100;
  }
  if (complete) {
    safeProgress = 100;
  } else if (safeProgress >= 100) {
    safeProgress = 99;
  }
  let completedAt = null;
  if (complete) {
    completedAt = now_iso();
  }
  const updatedCount = db.updateMany(Agent, { clientName: resolvedClientName }, {
    diagnosticLastRequestId: resolvedRequestIdOrNull,
    diagnosticLastUploadedAt: now_iso(),
    diagnosticStatus: complete ? 'uploaded' : 'running',
    diagnosticStage: truncate_text(stage.trim(), 64),
    diagnosticProgressPercent: safeProgress,
    diagnosticStartedAt: agent.diagnosticStartedAt ?? now_iso(),
    diagnosticCompletedAt: completedAt,
    diagnosticSummary: truncate_text(summary, 4000),
    diagnosticPayload: truncate_text(payload, 64000),
    updatedAt: now_iso()
  });
  if (updatedCount == 0) {
    return raw_json_error(404, 'client not found');
  }
  const updated = db.selectOne(Agent, { clientName: resolvedClientName });
  if (updated == null) {
    return raw_json_error(500, 'diagnostics upload state unavailable');
  }
  return {
    ok: true,
    clientName: resolvedClientName,
    diagnostics: agent_diagnostics_payload(updated)
  };
}

function agent_diagnostics_get(clientName: string, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
