  return {
    pending: pending && !waitingForClient,
    requestId: agent.clientUpdateRequestId,
    requestedAt: agent.clientUpdateRequestedAt,
    requestedByUserId: agent.clientUpdateRequestedByUserId,
    targetVersion: agent.clientUpdateTargetVersion,
    lastRequestId: agent.clientUpdateLastRequestId,
    acknowledgedAt: agent.clientUpdateLastAcknowledgedAt,
    status: statusValue,
    message: messageValue,
    downloadedBytes: agent.clientUpdateDownloadedBytes,
    totalBytes: agent.clientUpdateTotalBytes,
    progressPercent: agent.clientUpdateProgressPercent,
    scriptPath: agent.clientUpdateScriptPath ?? ''
  };
}

