function table_sync_policy_set(table: string, enabled: bool, cascadeRelated: bool = true, clientName: string? = null, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_client_user(current) && !is_owner_user(current) && !is_admin_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedTable = table.trim();
  if (normalizedTable.length == 0) {
    return raw_json_error(400, 'table is required');
  }
  let ownerUserId = owner_namespace_for_user(current);
  let normalizedClientName = '';
  if (clientName != null) {
    normalizedClientName = string.from(clientName).trim();
  }
  if (normalizedClientName.length != 0) {
    const targetAgent = db.selectOne(Agent, { clientName: normalizedClientName });
    if (targetAgent == null) {
      return raw_json_error(404, 'client not found');
    }
    if (!can_read_agent(current, targetAgent.ownerUserId, targetAgent.clientUserId)) {
      return raw_json_error(403, 'permission denied');
    }
    if (targetAgent.ownerUserId != null && targetAgent.ownerUserId.trim().length != 0) {
      ownerUserId = targetAgent.ownerUserId;
    } else if (targetAgent.clientUserId != null && targetAgent.clientUserId.trim().length != 0) {
      ownerUserId = targetAgent.clientUserId;
    }
  }
  const policy = upsert_table_sync_policy(
    ownerUserId,
    normalizedTable,
    enabled,
    current.username
  );
  if (enabled && cascadeRelated) {
    const relatedTables = related_table_sync_keys_for_policy(ownerUserId, normalizedTable);
    for (const relatedTable of relatedTables) {
      upsert_table_sync_policy(
        ownerUserId,
        string.from(relatedTable),
        true,
        current.username
      );
    }
  }
  return { ok: true, policy: table_sync_policy_payload(policy) };
}

function table_sync_policy_auto_enroll(tables: array<string>, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_client_user(current) && !is_owner_user(current) && !is_admin_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const ownerUserId = owner_namespace_for_user(current);
  let normalizedTables = [];
  let inspectedTableCount = 0;
  for (const table of tables) {
    if (inspectedTableCount >= 600) {
      break;
    }
    inspectedTableCount = inspectedTableCount + 1;
    const normalizedTable = string.from(table).trim();
    if (normalizedTable.length == 0 || string_array_contains(normalizedTables, normalizedTable)) {
      continue;
    }
    normalizedTables = normalizedTables.concat([normalizedTable]);
  }
  let policies = [];
  let createdTables = [];
  let reactivatedTables = [];
  const existingPolicies = list_table_sync_policies_for_scope(ownerUserId);
  let policyRowsToUpsert = [];
  let legacyTablesToReactivate = [];
  const policyUpdatedAt = now_iso();
  for (const normalizedTable of normalizedTables) {
    const reference = sync_table_reference(normalizedTable);
    const databaseName = string.from(reference.database).trim();
    const localTable = string.from(reference.table).trim();
    const policy = table_sync_policy_for_table_with_policies(
      ownerUserId,
      databaseName,
      localTable,
      existingPolicies
    );
    if (policy == null) {
      let storedDatabase = null;
      if (databaseName.length != 0) {
        storedDatabase = databaseName;
      }
      policyRowsToUpsert = policyRowsToUpsert.concat([{
        ownerUserId,
        database: storedDatabase,
        table: localTable,
        enabled: true,
        syncMode: 'sync',
        updatedAt: policyUpdatedAt,
        updatedByClientName: current.username
      }]);
      createdTables = createdTables.concat([normalizedTable]);
    } else if (policy.enabled != true) {
      const policyDatabase = table_sync_policy_database_name(policy);
      if (policyDatabase.length == 0 && databaseName.length != 0) {
        legacyTablesToReactivate = legacyTablesToReactivate.concat([localTable]);
      } else {
        let storedDatabase = null;
        if (policyDatabase.length != 0) {
          storedDatabase = policyDatabase;
        }
        policyRowsToUpsert = policyRowsToUpsert.concat([{
          ownerUserId,
          database: storedDatabase,
          table: table_sync_policy_local_name(policy),
          enabled: true,
          syncMode: 'sync',
          updatedAt: policyUpdatedAt,
          updatedByClientName: current.username
        }]);
      }
      reactivatedTables = reactivatedTables.concat([normalizedTable]);
    }
  }
  if (legacyTablesToReactivate.length > 0) {
    db.updateMany(TableSyncPolicy, {
      ownerUserId,
      database: null,
      table: { in: unique_string_values(legacyTablesToReactivate) }
    }, {
      enabled: true,
      syncMode: 'sync',
      updatedAt: policyUpdatedAt,
      updatedByClientName: current.username
    });
  }
  if (policyRowsToUpsert.length > 0) {
    db.upsertMany(TableSyncPolicy, policyRowsToUpsert, ['ownerUserId', 'database', 'table']);
  }
  const enrolledPolicies = list_table_sync_policies_for_scope(ownerUserId);
  for (const normalizedTable of normalizedTables) {
    const policy = table_sync_policy_for_table_with_policies(
      ownerUserId,
      '',
      normalizedTable,
      enrolledPolicies
    );
    if (policy != null) {
      policies = policies.concat([table_sync_policy_payload(policy)]);
    }
  }
  return {
    ok: true,
    policies,
    createdTables,
    reactivatedTables,
    evaluatedTableCount: normalizedTables.length,
    createdTableCount: createdTables.length,
    reactivatedTableCount: reactivatedTables.length
  };
}

function table_dependency_policy_set(table: string, relatedTable: string, relationshipType: string = 'business', database: string = '', clientName: string? = null, token: string? = null): map<json> {
  const current = current_user_record(token);
  if (current == null) {
    return raw_json_error(401, 'permission denied');
  }
  if (!is_client_user(current) && !is_owner_user(current) && !is_admin_user(current)) {
    return raw_json_error(403, 'permission denied');
  }
  const normalizedTable = table.trim();
  const normalizedRelatedTable = relatedTable.trim();
  if (normalizedTable.length == 0 || normalizedRelatedTable.length == 0) {
    return raw_json_error(400, 'table and relatedTable are required');
  }
  let ownerUserId = owner_namespace_for_user(current);
  let normalizedClientName = '';
  if (clientName != null) {
    normalizedClientName = string.from(clientName).trim();
  }
  if (normalizedClientName.length != 0) {
    const targetAgent = db.selectOne(Agent, { clientName: normalizedClientName });
    if (targetAgent == null) {
      return raw_json_error(404, 'client not found');
    }
    if (!can_read_agent(current, targetAgent.ownerUserId, targetAgent.clientUserId)) {
      return raw_json_error(403, 'permission denied');
    }
    if (targetAgent.ownerUserId != null && targetAgent.ownerUserId.trim().length != 0) {
      ownerUserId = targetAgent.ownerUserId;
    } else if (targetAgent.clientUserId != null && targetAgent.clientUserId.trim().length != 0) {
      ownerUserId = targetAgent.clientUserId;
    }
  }
  const dependency = normalized_table_dependency_payload(
    database,
    normalizedTable,
    normalizedRelatedTable,
    relationshipType,
    current.username
  );
  if (dependency == null) {
    return raw_json_error(400, 'valid related tables are required');
  }
  const reverseDependency = normalized_table_dependency_payload(
    database,
    normalizedRelatedTable,
    normalizedTable,
    relationshipType,
    current.username
  );
  let relationshipRows = [dependency];
  if (reverseDependency != null) {
    relationshipRows = relationshipRows.concat([reverseDependency]);
  }
  let targetClientName = normalizedClientName;
  if (targetClientName.length == 0) {
    targetClientName = current.username;
  }
  const agent = ensure_agent(targetClientName, current.id, ownerUserId);
  db.update(Agent, { clientName: agent.clientName }, {
    tableRelationships: bounded_table_relationships(database, (agent.tableRelationships ?? []).concat(relationshipRows), current.username),
    updatedAt: now_iso()
  });
  return {
    ok: true,
    dependencies: table_dependency_payloads_for_database(ownerUserId, database)
  };
}

