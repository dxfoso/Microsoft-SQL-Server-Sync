function live_state_completed_job_rows_for(current: map<json>): array<json> {
  let where = { status: 'completed' };
  if (is_client_user(current)) {
    where = { clientUserId: current.id, status: 'completed' };
  }
  if (is_owner_user(current)) {
    where = { ownerUserId: current.id, status: 'completed' };
  }
  const rows = db.selectMany(SyncJob, {
    where,
    orderBy: { field: 'completedAt', dir: 'desc' },
    fields: ['clientName', 'subscriberClientName', 'direction', 'status', 'rowCount', 'createdAt', 'completedAt', 'batchId'],
    limit: 1000
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function live_state_completed_row_totals_for(current: map<json>): array<json> {
  let where = { status: 'completed' };
  if (is_client_user(current)) {
    where = { clientUserId: current.id, status: 'completed' };
  }
  if (is_owner_user(current)) {
    where = { ownerUserId: current.id, status: 'completed' };
  }
  const rows = db.aggregate(SyncJob, {
    where,
    select: [
      { field: 'clientName' },
      { fn: 'sum', field: 'rowCount', where: { direction: 'upload' }, as: 'uploaded' },
      { fn: 'sum', field: 'rowCount', where: { direction: 'download' }, as: 'downloaded' }
    ],
    groupBy: ['clientName'],
    orderBy: [{ field: 'clientName', dir: 'asc' }],
    limit: 1000
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function live_state_automatic_number_incident_counts(ownerUserIds: array<string>, clientNames: array<string>): array<json> {
  if (ownerUserIds.length == 0 || clientNames.length == 0) {
    return [];
  }
  const rows = db.aggregate(AutoNumberIncident, {
    where: {
      ownerUserId: { in: ownerUserIds },
      clientName: { in: clientNames }
    },
    select: [
      { field: 'ownerUserId' },
      { field: 'clientName' },
      { fn: 'count', as: 'incidentCount' }
    ],
    groupBy: ['ownerUserId', 'clientName'],
    orderBy: [{ field: 'clientName', dir: 'asc' }],
    limit: 1000
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function live_state_manual_sync_rows_for_owner_ids(ownerUserIds: array<string>): array<json> {
  if (ownerUserIds.length == 0) {
    return [];
  }
  const rows = db.selectMany(PeriodicSyncState, {
    where: { ownerUserId: { in: ownerUserIds } },
    orderBy: { field: 'ownerUserId', dir: 'asc' },
    fields: ['ownerUserId', 'lastCheckedAt', 'manualPendingTables', 'manualSyncStatus', 'manualSyncStartedAt', 'manualSyncCompletedAt', 'manualSyncTableCount'],
    limit: 100
  });
  if (rows == null) {
    return [];
  }
  return rows;
}

function public_client_activity_payloads(rows: array<json>): array<json> {
  return rows.map((row) => {
    return {
      id: row.id,
      clientName: row.clientName,
      table: row.table,
      direction: row.direction,
      status: row.status,
      message: row.message,
      batchId: row.batchId,
      updatedAt: row.updatedAt
    };
  });
}

function bounded_public_agent_payloads(rows: array<json>, limit: int, activeJobs: array<json>? = null, completedJobs: array<json>? = null, periodicStates: array<json>? = null, completedRowTotals: array<json>? = null, automaticNumberIncidentCounts: array<json>? = null): map<json> {
  let items = [];
  let seen = 0;
  for (const row of rows) {
    seen += 1;
    if (items.length < limit) {
      items = items.concat([public_agent_payload(row, activeJobs, completedJobs, periodicStates, completedRowTotals, automaticNumberIncidentCounts)]);
    }
  }
  return {
    items,
    total: seen,
    truncated: seen > items.length
  };
}

function bounded_public_job_payloads(rows: array<json>, limit: int): map<json> {
  let items = [];
  let seen = 0;
  for (const row of rows) {
    seen += 1;
    if (items.length < limit) {
      items = items.concat([public_job_payload(row)]);
    }
  }
  return {
    items,
    total: seen,
    truncated: seen > items.length
  };
}

function prioritized_live_state_job_rows(activeRows: array<json>, historyRows: array<json>): array<json> {
  let rows = [];
  let seenIds = [];
  for (const row of activeRows.concat(historyRows)) {
    const id = string.from(row.id).trim();
    if (id.length == 0 || string_array_contains(seenIds, id)) {
      continue;
    }
    seenIds = seenIds.concat([id]);
    rows = rows.concat([row]);
  }
  return rows;
}

function ensure_agent(clientName: string, clientUserId: string? = null, ownerUserId: string? = null): map<json> {
  try {
    const existing = db.selectOne(Agent, { clientName });
    if (existing != null) {
      return existing;
    }
  } catch (err) {
    const repaired = db.update(Agent, { clientName }, {
      isOnline: false,
      serverConnected: false,
