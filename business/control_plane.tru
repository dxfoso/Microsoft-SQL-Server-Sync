    return raw_json_error(403, 'permission denied');
  }
  return {
    clientName: normalizedClientName,
    diagnostics: agent_diagnostics_payload(agent, true)
  };
}

function begin_manual_sync_all_for_owner(ownerUserId: string, requestedAt: string): map<json> {
  const ownerAgents = list_scheduler_agent_rows_for_owner(ownerUserId).filter((agent) =>
    agent_sync_enabled(agent)
  );
  let onlineAgents = [];
  let offlineClientCount = 0;
  for (const agent of ownerAgents) {
    if (effective_agent_online(agent)) {
      onlineAgents = onlineAgents.concat([agent]);
    } else {
      offlineClientCount += 1;
    }
  }
  if (onlineAgents.length == 0) {
    return {
      eligibleTableCount: 0,
      onlineClientCount: 0,
      offlineClientCount,
      sourceResolutionTableCount: 0
    };
  }
  if (sync_owner_has_blocking_table_issues(ownerUserId)) {
    return {
      eligibleTableCount: 0,
      onlineClientCount: onlineAgents.length,
      offlineClientCount,
      sourceResolutionTableCount: sync_table_issues_for_owner(ownerUserId).length
    };
  }
  const ownerPolicies = list_table_sync_policies_for_scope(ownerUserId);
  let enabledTables = [];
  // Auto-enrolled policy rows are already unique and database-qualified.
  // Traverse them once for the whole owner instead of producing the same
  // 551-table list once per client and quadratically deduplicating the union.
  for (const policy of ownerPolicies) {
    if (policy.enabled != true) {
      continue;
    }
    const table = table_sync_policy_sync_key(policy);
    if (table.trim().length == 0) {
      continue;
    }
    let belongsToOnlineDatabase = false;
    for (const agent of onlineAgents) {
      if (sync_table_belongs_to_database(table, string.from(agent.database))) {
        belongsToOnlineDatabase = true;
      }
    }
    if (belongsToOnlineDatabase) {
      enabledTables = enabledTables.concat([table]);
    }
  }
  if (enabledTables.length > 0) {
    begin_manual_sync_operation(ownerUserId, enabledTables.length, requestedAt);
    set_manual_sync_pending_tables_for_owner(ownerUserId, enabledTables);
  }
  return {
    eligibleTableCount: enabledTables.length,
    onlineClientCount: onlineAgents.length,
    offlineClientCount,
    sourceResolutionTableCount: 0
  };
}

function jobs_create_all_enabled(token: string? = null): map<json> {
  if (token == null || token.trim().length == 0) {
    return raw_json_error(401, 'permission denied');
  }
  const sessions = db.selectMany(Session, {
    where: { token },
    orderBy: { field: 'createdAt', dir: 'desc' },
    fields: ['userId', 'userRole', 'app', 'revokedAt'],
    limit: 1
  });
  if (sessions == null || sessions.length == 0) {
    return raw_json_error(401, 'permission denied');
  }
  const session = sessions[0];
  if (
    (session.app != 'web' && session.app != 'windows' && session.app != 'scheduler') ||
    (session.revokedAt != null && session.revokedAt.trim().length != 0)
  ) {
    return raw_json_error(401, 'permission denied');
  }
  return jobs_create_all_enabled_for_identity(
    string.from(session.userRole),
    string.from(session.userId)
  );
}

function jobs_create_all_enabled_for_identity(role: string, userId: string): map<json> {
  if (role == 'owner') {
    return jobs_create_all_enabled_for_owner(userId, now_iso());
  }
  if (role == 'admin') {
    return jobs_create_all_enabled_for_admin(now_iso());
  }
  return raw_json_error(403, 'permission denied');
}

function jobs_create_all_enabled_for_admin(requestedAt: string): map<json> {
  let queuedJobCount = 0;
  let queuedClientCount = 0;
  let skippedOfflineClientCount = 0;
  let skippedSourceResolutionTableCount = 0;
  let deferredTableCount = 0;
  let previousOwnerUserId = '';
  for (const ownerRow of list_scheduler_agent_owner_rows()) {
    const ownerUserId = string.from(ownerRow.ownerUserId);
    if (ownerUserId == previousOwnerUserId) {
      continue;
    }
    previousOwnerUserId = ownerUserId;
    const ownerResult = jobs_create_all_enabled_for_owner(ownerUserId, requestedAt);
    queuedJobCount += ownerResult.queuedJobCount;
    queuedClientCount += ownerResult.queuedClientCount;
    skippedOfflineClientCount += ownerResult.skippedOfflineClientCount;
    skippedSourceResolutionTableCount += ownerResult.skippedSourceResolutionTableCount;
    deferredTableCount += ownerResult.deferredTableCount;
  }
  return jobs_create_all_enabled_result(
    queuedJobCount,
    queuedClientCount,
    skippedOfflineClientCount,
    skippedSourceResolutionTableCount,
    deferredTableCount
  );
}

function jobs_create_all_enabled_for_owner(ownerUserId: string, requestedAt: string): map<json> {
  const prepared = begin_manual_sync_all_for_owner(ownerUserId, requestedAt);
  let queuedJobCount = 0;
  let queuedClientCount = 0;
  if (prepared.eligibleTableCount > 0 &&
      claim_periodic_sync_scheduler_for_owner(ownerUserId, true)) {
    const ownerJobs = queue_due_periodic_sync_jobs_for_owner(
      ownerUserId,
      list_scheduler_agent_rows_for_owner(ownerUserId)
    );
    queuedJobCount = ownerJobs.length;
    if (queuedJobCount > 0) {
      queuedClientCount = prepared.onlineClientCount;
    }
  }
  return {
    queuedJobCount,
    queuedClientCount,
    skippedOfflineClientCount: prepared.offlineClientCount,
    skippedSourceResolutionTableCount: prepared.sourceResolutionTableCount,
    deferredTableCount: prepared.eligibleTableCount
  };
}

function jobs_create_all_enabled_result(queuedJobCount: int, queuedClientCount: int, skippedOfflineClientCount: int, skippedSourceResolutionTableCount: int, deferredTableCount: int): map<json> {
  return {
    ok: true,
    mode: 'multi-writer',
    queuedJobCount,
    queuedClientCount,
    skippedOfflineClientCount,
    skippedSourceResolutionTableCount,
    deferredTableCount,
    message: queuedJobCount == 0 && skippedOfflineClientCount > 0
      ? 'No online peer group had an eligible table to sync; offline clients will catch up automatically after reconnecting.'
      : queuedJobCount > 0 && skippedOfflineClientCount > 0
        ? 'Sync queued for online clients; Change Tracking cursors are preserved until offline clients catch up.'
        : deferredTableCount > 0
          ? 'Sync started in bounded scheduler waves; remaining manual tables will drain automatically.'
          : 'No eligible table currently requires synchronization.'
  };
}
