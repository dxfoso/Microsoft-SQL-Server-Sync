function delete_snapshot_storage_batch(): map<json> {
  const storedSnapshots = db.selectMany(SnapshotRecord, {
    where: { id: { gte: '' } },
    orderBy: { field: 'createdAt', dir: 'asc' },
    fields: ['id', 'storageId'],
    limit: 25
  });
  let deletedStorageObjectCount = 0;
  let snapshotIds = [];
  for (const storedSnapshot of storedSnapshots) {
    snapshotIds = snapshotIds.concat([storedSnapshot.id]);
    const storageId = string.from(storedSnapshot.storageId ?? '').trim();
    if (storageId.length != 0 && !sync_job_data_storage_referenced_by_archive(storageId)) {
      storage.delete(storageId);
      deletedStorageObjectCount += 1;
    }
  }
  let snapshotDeletedCount = 0;
  if (snapshotIds.length != 0) {
    snapshotDeletedCount = db.deleteMany(SnapshotRecord, { id: { in: snapshotIds } });
  }
  return {
    deletedStorageObjectCount,
    snapshotDeletedCount,
    hasMore: storedSnapshots.length == 25
  };
}

